---
import AdminLayout from "../../layouts/AdminLayout.astro";
import {
  getArchitectureExecutionSteps,
  getArchitectureExecutionSummary,
  getArchitectureFileActionLabel,
  getArchitectureImplementationPhases,
  getArchitectureImplementationSummary,
  getArchitectureStatusLabel,
  getArchitectureStatusTone,
} from "../../lib/admin-architecture-plan";

const steps = getArchitectureExecutionSteps();
const summary = getArchitectureExecutionSummary();
const phases = getArchitectureImplementationPhases();
const implementationSummary = getArchitectureImplementationSummary();
---
<AdminLayout
  title="Admin — Architecture Plan"
  activeNav="architecture"
  pageId="architecture"
  description="Programme des priorités produit et plan de migration de l'architecture publique."
  bodyClass="text-slate-200 arch-shell"
  containerClass="arch-wrap"
>
    <section class="arch-hero">
      <span class="arch-eyebrow">Architecture</span>
      <h1 class="arch-title">
        <span data-admin-i18n data-admin-fr="Plan" data-admin-en="Plan">Plan</span>
        <span>·</span>
        <span data-admin-i18n data-admin-fr="programme 14 étapes + migration IA produit" data-admin-en="14-step program + product IA migration">
          programme 14 étapes + migration IA produit
        </span>
      </h1>
      <p class="arch-copy">
        <span
          data-admin-i18n
          data-admin-fr="Cette page garde deux choses au même endroit : le tableau stratégique des 14 chantiers et la trace du plan qui a permis de passer d'un prototype mono-page à une vraie architecture Daily / Arcade / Archives. Le split repo, la normalisation admin, le durcissement front et le basculement pack-first sont maintenant exécutés."
          data-admin-en="This page keeps two things in one place: the strategic 14-step program and the record of the plan that moved the product from a single-page prototype to a real Daily / Arcade / Archives architecture. The repo split, admin normalization, front hardening, and pack-first cutover are now done."
        >
          Cette page garde deux choses au même endroit : le tableau stratégique des 14 chantiers et la trace du plan qui a permis de passer d'un prototype mono-page à une vraie architecture Daily / Arcade / Archives. Le split repo, la normalisation admin, le durcissement front et le basculement pack-first sont maintenant exécutés.
        </span>
      </p>
    </section>

    <section class="arch-card arch-section-head">
      <div class="arch-section-title" data-admin-i18n data-admin-fr="État après les lots de durcissement" data-admin-en="State after hardening lots">
        État après les lots de durcissement
      </div>
      <p class="arch-section-copy">
        <span
          data-admin-i18n
          data-admin-fr="Le shell public, les routes Daily / Arcade / Archives et les builders de session sont en place. Depuis, le repo a aussi été durci : apps/web + apps/admin + shared, dashboard admin en vraie app Astro, runtime quiz critique en TypeScript, canon actif pack-first, garde-fous legacy, lint/format/ratchet inline alignés entre local et CI."
          data-admin-en="The public shell, Daily / Arcade / Archives routes, and session builders are in place. Since then, the repo has also been hardened: apps/web + apps/admin + shared, admin dashboard as a real Astro app, critical quiz runtime in TypeScript, active pack-first canon, legacy guardrails, and lint/format/inline ratchet aligned between local and CI."
        >
          Le shell public, les routes Daily / Arcade / Archives et les builders de session sont en place. Depuis, le repo a aussi été durci : apps/web + apps/admin + shared, dashboard admin en vraie app Astro, runtime quiz critique en TypeScript, canon actif pack-first, garde-fous legacy, lint/format/ratchet inline alignés entre local et CI.
        </span>
      </p>
    </section>

    <section class="arch-hud">
      <section class="arch-summary-bar">
        <div class="arch-progress-title" data-admin-i18n data-admin-fr="1. Priorités produit" data-admin-en="1. Product priorities">
          1. Priorités produit
        </div>
        <div class="arch-chip-row">
          <span class="arch-chip">
            <span data-admin-i18n data-admin-fr={`${summary.advanced} en validation`} data-admin-en={`${summary.advanced} in validation`}>
              {summary.advanced} en validation
            </span>
          </span>
          <span class="arch-chip">
            <span data-admin-i18n data-admin-fr={`${summary.active} en cours`} data-admin-en={`${summary.active} in progress`}>
              {summary.active} en cours
            </span>
          </span>
          <span class="arch-chip">
            <span data-admin-i18n data-admin-fr={`${summary.framed} prêts`} data-admin-en={`${summary.framed} ready`}>
              {summary.framed} prêts
            </span>
          </span>
          <span class="arch-chip">
            <span data-admin-i18n data-admin-fr={`${summary.cold} backlog`} data-admin-en={`${summary.cold} backlog`}>
              {summary.cold} backlog
            </span>
          </span>
        </div>
        <div class="arch-progress-stack">
          <progress class="arch-progress-meter" max="100" value={summary.average}>
            {summary.average}
          </progress>
          <div class="arch-progress-percent">{summary.average}%</div>
        </div>
      </section>

      <section class="arch-summary-bar">
        <div class="arch-progress-title" data-admin-i18n data-admin-fr="2. Nouvelle architecture" data-admin-en="2. New architecture">
          2. Nouvelle architecture
        </div>
        <div class="arch-chip-row">
          <span class="arch-chip">
            <span data-admin-i18n data-admin-fr={`${implementationSummary.advanced} en validation`} data-admin-en={`${implementationSummary.advanced} in validation`}>
              {implementationSummary.advanced} en validation
            </span>
          </span>
          <span class="arch-chip">
            <span data-admin-i18n data-admin-fr={`${implementationSummary.active} en cours`} data-admin-en={`${implementationSummary.active} in progress`}>
              {implementationSummary.active} en cours
            </span>
          </span>
          <span class="arch-chip">
            <span data-admin-i18n data-admin-fr={`${implementationSummary.framed} prêts`} data-admin-en={`${implementationSummary.framed} ready`}>
              {implementationSummary.framed} prêts
            </span>
          </span>
          <span class="arch-chip">
            <span data-admin-i18n data-admin-fr={`${implementationSummary.cold} backlog`} data-admin-en={`${implementationSummary.cold} backlog`}>
              {implementationSummary.cold} backlog
            </span>
          </span>
        </div>
        <div class="arch-progress-stack">
          <progress class="arch-progress-meter" max="100" value={implementationSummary.average}>
            {implementationSummary.average}
          </progress>
          <div class="arch-progress-percent">{implementationSummary.average}%</div>
        </div>
      </section>
    </section>

    <section class="arch-section">
      <div class="arch-card arch-section-head">
        <div class="arch-section-title" data-admin-i18n data-admin-fr="1. Priorités produit" data-admin-en="1. Product priorities">
          1. Priorités produit
        </div>
        <p class="arch-section-copy">
          <span
            data-admin-i18n
            data-admin-fr="Tableau stratégique repris du chantier produit. La colonne avancement reste volontairement estimative : elle sert à lire les sujets comme un kanban : en validation, en cours, prêt ou backlog."
            data-admin-en="This is the strategic program reused from the product discussion. The progress column stays deliberately approximate: it reads the work as a kanban: in validation, in progress, ready, or backlog."
          >
            Tableau stratégique repris du chantier produit. La colonne avancement reste volontairement estimative : elle sert à lire les sujets comme un kanban : en validation, en cours, prêt ou backlog.
          </span>
        </p>
      </div>

      <section class="arch-table-shell">
        <div class="arch-table-wrap">
          <table class="arch-table">
            <thead>
              <tr>
                <th>#</th>
                <th data-admin-i18n data-admin-fr="Étape" data-admin-en="Step">Étape</th>
                <th data-admin-i18n data-admin-fr="Impact" data-admin-en="Impact">Impact</th>
                <th data-admin-i18n data-admin-fr="Effort" data-admin-en="Effort">Effort</th>
                <th data-admin-i18n data-admin-fr="Priorité" data-admin-en="Priority">Priorité</th>
                <th data-admin-i18n data-admin-fr="Avancement" data-admin-en="Progress">Avancement</th>
                <th data-admin-i18n data-admin-fr="Pourquoi maintenant" data-admin-en="Why now">Pourquoi maintenant</th>
              </tr>
            </thead>
            <tbody>
              {steps.map((step) => {
                const status = getArchitectureStatusLabel(step.progress);
                const tone = getArchitectureStatusTone(step.progress);
                return (
                  <tr>
                    <td>
                      <span class="arch-rank">{step.rank}</span>
                    </td>
                    <td>
                      <div
                        class="arch-step-title"
                        data-admin-i18n
                        data-admin-fr={step.title.fr}
                        data-admin-en={step.title.en}
                      >
                        {step.title.fr}
                      </div>
                      <p
                        class="arch-step-note"
                        data-admin-i18n
                        data-admin-fr={step.note.fr}
                        data-admin-en={step.note.en}
                      >
                        {step.note.fr}
                      </p>
                    </td>
                    <td>
                      <span
                        class="arch-pill"
                        data-admin-i18n
                        data-admin-fr={step.impact.fr}
                        data-admin-en={step.impact.en}
                      >
                        {step.impact.fr}
                      </span>
                    </td>
                    <td>
                      <span
                        class="arch-pill"
                        data-admin-i18n
                        data-admin-fr={step.effort.fr}
                        data-admin-en={step.effort.en}
                      >
                        {step.effort.fr}
                      </span>
                    </td>
                    <td>
                      <span class="arch-pill priority">#{step.priority}</span>
                    </td>
                    <td>
                      <div class="arch-progress-cell">
                        <div class="arch-progress-meta">
                          <span>{step.progress}%</span>
                          <span class:list={["arch-status", tone]}>
                            <span
                              data-admin-i18n
                              data-admin-fr={status.fr}
                              data-admin-en={status.en}
                            >
                              {status.fr}
                            </span>
                          </span>
                        </div>
                        <progress class="arch-progress-mini" max="100" value={step.progress}>
                          {step.progress}
                        </progress>
                      </div>
                    </td>
                    <td>
                      <p
                        class="arch-why"
                        data-admin-i18n
                        data-admin-fr={step.whyNow.fr}
                        data-admin-en={step.whyNow.en}
                      >
                        {step.whyNow.fr}
                      </p>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    </section>

    <section class="arch-section">
      <div class="arch-card arch-section-head">
        <div class="arch-section-title" data-admin-i18n data-admin-fr="2. Nouvelle architecture" data-admin-en="2. New architecture">
          2. Nouvelle architecture
        </div>
        <p class="arch-section-copy">
          <span
            data-admin-i18n
            data-admin-fr="Cette séquence a servi de plan de migration vers la vraie architecture publique. Elle sert maintenant surtout de trace : la migration publique et la stabilisation éditoriale v0.1 sont faites, et les prochains travaux portent davantage sur la release, la waitlist prod, le légal et les dernières surfaces artisanales."
            data-admin-en="This sequence served as the migration plan toward the real public architecture. It now mostly serves as a record: the public migration and v0.1 editorial stabilization are done, and the next work is mostly about release, production waitlist, legal, and remaining handcrafted surfaces."
          >
            Cette séquence a servi de plan de migration vers la vraie architecture publique. Elle sert maintenant surtout de trace : la migration publique et la stabilisation éditoriale v0.1 sont faites, et les prochains travaux portent davantage sur la release, la waitlist prod, le légal et les dernières surfaces artisanales.
          </span>
        </p>
      </div>

      <div class="arch-phases">
        {phases.map((phase) => (
          <article class="arch-phase">
            <div class="arch-phase-head">
              <div>
                <div class="arch-phase-kicker">
                  <span data-admin-i18n data-admin-fr={`Phase ${phase.order}`} data-admin-en={`Phase ${phase.order}`}>
                    Phase {phase.order}
                  </span>
                </div>
                <div
                  class="arch-phase-title"
                  data-admin-i18n
                  data-admin-fr={phase.title.fr}
                  data-admin-en={phase.title.en}
                >
                  {phase.title.fr}
                </div>
              </div>
              <span class="arch-pill priority">#{phase.order}</span>
            </div>

            <p
              class="arch-phase-copy"
              data-admin-i18n
              data-admin-fr={phase.goal.fr}
              data-admin-en={phase.goal.en}
            >
              {phase.goal.fr}
            </p>

            <div class="arch-phase-grid">
              <section class="arch-phase-block">
                <div class="arch-phase-block-label" data-admin-i18n data-admin-fr="Garde-fou" data-admin-en="Guardrail">
                  Garde-fou
                </div>
                <div
                  class="arch-phase-block-copy"
                  data-admin-i18n
                  data-admin-fr={phase.guardrail.fr}
                  data-admin-en={phase.guardrail.en}
                >
                  {phase.guardrail.fr}
                </div>
              </section>
              <section class="arch-phase-block">
                <div class="arch-phase-block-label" data-admin-i18n data-admin-fr="Risque" data-admin-en="Risk">
                  Risque
                </div>
                <div
                  class="arch-phase-block-copy"
                  data-admin-i18n
                  data-admin-fr={phase.risk.fr}
                  data-admin-en={phase.risk.en}
                >
                  {phase.risk.fr}
                </div>
              </section>
              <section class="arch-phase-block">
                <div class="arch-phase-block-label" data-admin-i18n data-admin-fr="Cible" data-admin-en="Target">
                  Cible
                </div>
                <div
                  class="arch-phase-block-copy"
                  data-admin-i18n
                  data-admin-fr={`Phase ${phase.order} avant la suivante`}
                  data-admin-en={`Finish phase ${phase.order} before the next one`}
                >
                  Phase {phase.order} avant la suivante
                </div>
              </section>
            </div>

            <div class="arch-file-list">
              {phase.files.map((file) => {
                const actionLabel = getArchitectureFileActionLabel(file.action);
                return (
                  <div class="arch-file-row">
                    <span class="arch-file-action">
                      <span data-admin-i18n data-admin-fr={actionLabel.fr} data-admin-en={actionLabel.en}>
                        {actionLabel.fr}
                      </span>
                    </span>
                    <div class="arch-file-path"><code>{file.path}</code></div>
                    <div
                      class="arch-file-note"
                      data-admin-i18n
                      data-admin-fr={file.note.fr}
                      data-admin-en={file.note.en}
                    >
                      {file.note.fr}
                    </div>
                  </div>
                );
              })}
            </div>
          </article>
        ))}
      </div>

      <section class="arch-card arch-section-head">
        <p class="arch-footnote">
          <span
            data-admin-i18n
            data-admin-fr="Règle de coupe : les routes produit sont validées et le repo n'est plus structurellement en transition. Le contenu actif v0.1 est stabilisé ; la dette restante est une dette de finition : release, waitlist prod, RGPD, mobile QA et extinction des dernières surfaces artisanales."
            data-admin-en="Cut line: product routes are validated and the repo is no longer structurally mid-transition. Active v0.1 content is stabilized; the remaining debt is finish debt: release work, production waitlist, GDPR, mobile QA, and removal of the last handcrafted surfaces."
          >
            Règle de coupe : les routes produit sont validées et le repo n'est plus structurellement en transition. Le contenu actif v0.1 est stabilisé ; la dette restante est une dette de finition : release, waitlist prod, RGPD, mobile QA et extinction des dernières surfaces artisanales.
          </span>
        </p>
      </section>
    </section>
</AdminLayout>
