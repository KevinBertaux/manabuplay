---
import DesignDocLayout from "../../layouts/DesignDocLayout.astro";
---
<DesignDocLayout title="ManabuPlay FX Lab" active="fx" containerClass="page">
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link slot="head" rel="stylesheet" href="/assets/fx-preview.css" />

  <style is:global>
    @font-face { font-family:"Joystix"; src:url("/fonts/Joystix.woff") format("woff"); font-display:swap; }
    :root { --brand:"Joystix",sans-serif; --ui:"Chakra Petch",sans-serif; --bg:#08070d; --panel:#120f1eea; --line:#a78bfa2d; --violet:#a78bfa; --fuchsia:#e879f9; --cyan:#22d3ee; --text:#f3f1ff; --muted:#bbb6d3; --soft:#8f8aa7; --space-4:4px; --space-8:8px; --space-12:12px; --space-16:16px; --space-20:20px; --space-24:24px; --space-32:32px; --radius-8:8px; --radius-pill:999px; --control-h-16:16px; --control-h-32:32px; --control-h-44:44px; --page-max:1216px; }
    * { box-sizing:border-box; }
    body { margin:0; color:var(--text); font-family:var(--ui); background:radial-gradient(circle at top left,#a78bfa24,transparent 22rem),radial-gradient(circle at 84% 14%,#22d3ee1f,transparent 18rem),linear-gradient(180deg,#0b0913 0%,#08070d 100%); }
    .page { width:min(var(--page-max),calc(100% - var(--space-16))); margin:0 auto; padding:var(--space-16) 0 var(--space-32); }
    .hero,.sec,.nav { border:1px solid var(--line); background:var(--panel); box-shadow:0 12px 24px #00000034; }
    .hero,.sec { border-radius:var(--radius-8); padding:var(--space-16); margin-bottom:var(--space-12); }
    .nav { position:sticky; top:var(--space-8); z-index:10; display:flex; gap:var(--space-8); flex-wrap:wrap; margin:0 0 var(--space-12); padding:var(--space-8); border-radius:var(--radius-8); backdrop-filter:blur(12px); }
    .nav a { padding:var(--space-8) var(--space-12); border-radius:var(--radius-8); color:var(--muted); font-size:.92rem; font-weight:600; text-decoration:none; }
    .nav a:hover { background:#a78bfa14; color:#fff; }
    .eyebrow { display:inline-flex; align-items:center; gap:var(--space-8); min-height:var(--control-h-32); padding:0 var(--space-12); border-radius:var(--radius-8); background:#22d3ee14; border:1px solid #22d3ee38; color:var(--cyan); font-size:.84rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
    .eyebrow::before { content:""; width:var(--space-8); height:var(--space-8); border-radius:var(--radius-pill); background:currentColor; }
    .brand { margin:8px 0; font-family:var(--brand); font-size:clamp(2rem,4vw,4rem); line-height:1.1; letter-spacing:.03em; }
    .brand span { color:var(--fuchsia); }
    h1,h2,h3,p { margin:0; }
    h1 { font-size:clamp(1.5rem,3vw,2.6rem); line-height:1.08; margin-bottom:8px; }
    h2 { font-size:clamp(1.25rem,2.3vw,1.8rem); line-height:1.15; margin-bottom:4px; }
    h3 { font-size:1rem; margin-bottom:8px; }
    p { color:var(--muted); line-height:1.58; }
    .head { display:grid; gap:8px; margin-bottom:8px; }
    .card { padding:var(--space-12); border-radius:var(--radius-8); border:1px solid #ffffff12; background:#ffffff06; }
    .mini { color:var(--soft); font-size:.84rem; text-transform:uppercase; letter-spacing:.08em; font-weight:700; }
    .code { margin:0; padding:12px; border-radius:8px; border:1px solid #ffffff12; background:#00000042; color:#ddd9f2; white-space:pre-wrap; line-height:1.55; font-size:.9rem; overflow-wrap:anywhere; word-break:break-word; }
    .btns { display:flex; gap:var(--space-8); flex-wrap:wrap; align-items:center; }
    .btn { display:inline-flex; align-items:center; justify-content:center; min-height:var(--control-h-44); padding:0 var(--space-16); border-radius:var(--radius-8); border:1px solid transparent; font:600 .96rem var(--ui); letter-spacing:.04em; text-transform:uppercase; color:#fff; cursor:pointer; }
    .b1 { background:linear-gradient(135deg,#a78bfa57,#e879f955); border-color:#a78bfa38; }
    .b2 { background:#a78bfa14; border-color:#a78bfa33; color:var(--violet); }
    .fx-copy-head { display:flex; align-items:center; justify-content:space-between; gap:var(--space-8); margin-bottom:var(--space-8); }
    .fx-copy-head h3 { margin-bottom:0; }
    .fx-copy-head-actions { display:flex; align-items:center; gap:var(--space-8); }
    .fx-icon-copy,
    .fx-icon-btn { display:inline-flex; align-items:center; justify-content:center; width:var(--control-h-32); height:var(--control-h-32); padding:0; border:1px solid #ffffff10; border-radius:var(--radius-8); background:#ffffff05; color:var(--muted); cursor:pointer; transition:background-color .16s ease,border-color .16s ease,color .16s ease,box-shadow .16s ease; }
    .fx-icon-copy:hover,
    .fx-icon-copy:focus-visible,
    .fx-icon-btn:hover,
    .fx-icon-btn:focus-visible { background:#a78bfa14; border-color:#a78bfa38; color:#fff; outline:0; box-shadow:0 0 12px #a78bfa24; }
    .fx-icon-copy:disabled,
    .fx-icon-btn:disabled { opacity:.35; cursor:not-allowed; box-shadow:none; }
    .fx-icon-copy svg,
    .fx-icon-btn svg { width:20px; height:20px; display:block; }
    .fx-preset-actions { display:flex; align-items:center; justify-content:space-between; gap:var(--space-12); flex-wrap:wrap; }
    .fx-mini-actions { display:flex; gap:var(--space-8); align-items:center; }
    .tokenlist { display:grid; gap:8px; font-size:.95rem; }
    .tokenlist div { display:flex; justify-content:space-between; gap:12px; padding-bottom:8px; border-bottom:1px solid #ffffff10; align-items:flex-start; }
    .tokenlist strong { color:#fff; } .tokenlist span { color:var(--soft); text-align:right; }
    .fx-lab-shell { display:grid; grid-template-columns:minmax(0,512px) minmax(0,640px); gap:16px; justify-content:space-between; align-items:start; }
    .fx-control-panel { display:grid; gap:12px; align-content:start; }
    .fx-control-group { padding:12px; border:1px solid #ffffff12; border-radius:8px; background:#ffffff06; }
    .fx-range-list { display:grid; gap:12px; }
    .fx-range { display:grid; gap:8px; padding:12px; border:1px solid #ffffff10; border-radius:8px; background:#08070d66; }
    .fx-range-head { display:flex; justify-content:space-between; gap:12px; align-items:center; }
    .fx-range-main { display:flex; align-items:center; gap:8px; min-width:0; }
    .fx-range-title { color:#f3f1ff; font-weight:700; }
    .fx-range-tools { display:flex; align-items:center; gap:8px; flex-shrink:0; }
    .fx-toggle { width:16px; height:16px; margin:0; accent-color:#a78bfa; cursor:pointer; }
    .fx-range-value-btn,
    .fx-range-edit { min-width:48px; height:32px; padding:0 8px; border-radius:8px; border:1px solid #a78bfa26; background:#a78bfa14; color:#fff; font:600 .9rem var(--ui); text-align:center; }
    .fx-range-value-btn { cursor:pointer; }
    .fx-range-edit { display:none; appearance:textfield; outline:0; }
    .fx-range-edit::-webkit-outer-spin-button,
    .fx-range-edit::-webkit-inner-spin-button { -webkit-appearance:none; margin:0; }
    .fx-range[data-editing="true"] .fx-range-value-btn { display:none; }
    .fx-range[data-editing="true"] .fx-range-edit { display:block; }
    .fx-range[data-disabled="true"] { opacity:.62; }
    .fx-range[data-disabled="true"] input[type="range"] { opacity:.34; pointer-events:none; }
    .fx-range[data-disabled="true"] .fx-range-value-btn,
    .fx-range[data-disabled="true"] .fx-range-edit { color:#8f8aa7; }
    .fx-range input[type="range"] { width:100%; accent-color:#a78bfa; }
    #preview.card { padding:12px; }
    .iso-reference { display:grid; gap:12px; margin-top:16px; }
    .iso-reference-grid { display:grid; grid-template-columns:1fr; gap:12px; }
    .iso-card { padding:12px; border:1px solid #ffffff12; border-radius:8px; background:#ffffff04; }
    .iso-card-head { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; margin-bottom:8px; }
    .iso-card-head h3 { margin-bottom:4px; }
    .iso-card-head p { max-width:48ch; }
    .iso-frame-wrap { border:1px solid #ffffff12; border-radius:8px; overflow:hidden; background:#08070d; }
    .iso-frame { display:block; width:100%; border:0; background:#08070d; }
    .iso-frame-hero { min-height:928px; }
    .iso-frame-quiz { min-height:928px; }
    .iso-link { display:inline-flex; align-items:center; gap:8px; color:var(--cyan); font-size:.88rem; font-weight:700; text-decoration:none; }
    .iso-link:hover { color:#fff; }
    .iso-link svg { width:16px; height:16px; display:block; }
    @media (max-width:1120px) { .fx-lab-shell { grid-template-columns:1fr; } }
    @media (max-width:720px) { .page { width:min(100% - 16px,1216px); } .hero,.sec { padding:12px; } .tokenlist div { flex-direction:column; gap:4px; } .tokenlist span { text-align:left; } .fx-range-head { align-items:flex-start; flex-direction:column; } .fx-range-tools { width:100%; justify-content:space-between; } .fx-preset-actions { align-items:flex-start; } .iso-card-head { flex-direction:column; } .iso-frame-hero { min-height:720px; } .iso-frame-quiz { min-height:896px; } }
  </style>

  <header class="hero">
    <span class="eyebrow">FX Lab</span>
    <div class="brand">Manabu<span>Play</span></div>
    <h1>Lab local pour regler le CRT et les effets de signature du produit.</h1>
    <p>Regle les effets ici, copie le preset en un clic, puis colle-le dans Codex. Le preview de la charte lira automatiquement le meme preset.</p>
  </header>

  <nav class="nav">
    <a href="/design/brand-system#fx-preview">Retour a la charte</a>
    <a href="#controls">Controls</a>
    <a href="#preview">Preview</a>
    <a href="#response-demo">Response Demo</a>
    <a href="#preset">Preset</a>
  </nav>

  <section class="sec" id="controls">
    <div class="head">
      <span class="eyebrow">Controls</span>
      <h2>Granularite du preset</h2>
      <p>Chaque slider va de 0 a 100. Le preset est stocke en local et reapplique a la charte.</p>
    </div>

    <div class="fx-lab-shell">
      <aside class="fx-control-panel">
        <form class="fx-control-group" data-fx-form>
          <h3>CRT Stack</h3>
          <div class="fx-range-list">
            <div class="fx-range" data-fx-key="crt">
              <div class="fx-range-head">
                <div class="fx-range-main">
                  <input class="fx-toggle" type="checkbox" data-fx-enabled="crt" aria-label="Activer CRT master" checked />
                  <span class="fx-range-title">CRT master</span>
                </div>
                <div class="fx-range-tools">
                  <button class="fx-range-value-btn" type="button" data-fx-edit-toggle="crt"><span data-fx-value="crt"></span></button>
                  <input class="fx-range-edit" type="number" min="0" max="100" inputmode="numeric" data-fx-edit="crt" aria-label="Valeur CRT master" />
                </div>
              </div>
              <input type="range" name="crt" min="0" max="100" step="1" />
            </div>
            <div class="fx-range" data-fx-key="scanlines">
              <div class="fx-range-head">
                <div class="fx-range-main">
                  <input class="fx-toggle" type="checkbox" data-fx-enabled="scanlines" aria-label="Activer Scanlines" checked />
                  <span class="fx-range-title">Scanlines</span>
                </div>
                <div class="fx-range-tools">
                  <button class="fx-range-value-btn" type="button" data-fx-edit-toggle="scanlines"><span data-fx-value="scanlines"></span></button>
                  <input class="fx-range-edit" type="number" min="0" max="100" inputmode="numeric" data-fx-edit="scanlines" aria-label="Valeur Scanlines" />
                </div>
              </div>
              <input type="range" name="scanlines" min="0" max="100" step="1" />
            </div>
            <div class="fx-range" data-fx-key="noise">
              <div class="fx-range-head">
                <div class="fx-range-main">
                  <input class="fx-toggle" type="checkbox" data-fx-enabled="noise" aria-label="Activer Noise" checked />
                  <span class="fx-range-title">Noise</span>
                </div>
                <div class="fx-range-tools">
                  <button class="fx-range-value-btn" type="button" data-fx-edit-toggle="noise"><span data-fx-value="noise"></span></button>
                  <input class="fx-range-edit" type="number" min="0" max="100" inputmode="numeric" data-fx-edit="noise" aria-label="Valeur Noise" />
                </div>
              </div>
              <input type="range" name="noise" min="0" max="100" step="1" />
            </div>
            <div class="fx-range" data-fx-key="glow">
              <div class="fx-range-head">
                <div class="fx-range-main">
                  <input class="fx-toggle" type="checkbox" data-fx-enabled="glow" aria-label="Activer Glow" checked />
                  <span class="fx-range-title">Glow</span>
                </div>
                <div class="fx-range-tools">
                  <button class="fx-range-value-btn" type="button" data-fx-edit-toggle="glow"><span data-fx-value="glow"></span></button>
                  <input class="fx-range-edit" type="number" min="0" max="100" inputmode="numeric" data-fx-edit="glow" aria-label="Valeur Glow" />
                </div>
              </div>
              <input type="range" name="glow" min="0" max="100" step="1" />
            </div>
            <div class="fx-range" data-fx-key="glitch">
              <div class="fx-range-head">
                <div class="fx-range-main">
                  <input class="fx-toggle" type="checkbox" data-fx-enabled="glitch" aria-label="Activer Glitch" checked />
                  <span class="fx-range-title">Glitch</span>
                </div>
                <div class="fx-range-tools">
                  <button class="fx-range-value-btn" type="button" data-fx-edit-toggle="glitch"><span data-fx-value="glitch"></span></button>
                  <input class="fx-range-edit" type="number" min="0" max="100" inputmode="numeric" data-fx-edit="glitch" aria-label="Valeur Glitch" />
                </div>
              </div>
              <input type="range" name="glitch" min="0" max="100" step="1" />
            </div>
            <div class="fx-range" data-fx-key="ambient">
              <div class="fx-range-head">
                <div class="fx-range-main">
                  <input class="fx-toggle" type="checkbox" data-fx-enabled="ambient" aria-label="Activer Ambient motion" checked />
                  <span class="fx-range-title">Ambient motion</span>
                </div>
                <div class="fx-range-tools">
                  <button class="fx-range-value-btn" type="button" data-fx-edit-toggle="ambient"><span data-fx-value="ambient"></span></button>
                  <input class="fx-range-edit" type="number" min="0" max="100" inputmode="numeric" data-fx-edit="ambient" aria-label="Valeur Ambient motion" />
                </div>
              </div>
              <input type="range" name="ambient" min="0" max="100" step="1" />
            </div>
          </div>
        </form>

        <div class="fx-control-group fx-copy-box" id="preset" data-fx-copy-scope>
          <div class="fx-copy-head">
            <h3>Preset</h3>
            <div class="fx-copy-head-actions">
              <button class="fx-icon-btn" type="button" data-fx-undo aria-label="Undo" title="Undo">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M9 14l-4 -4l4 -4"></path>
                  <path d="M5 10h11a4 4 0 1 1 0 8h-1"></path>
                </svg>
              </button>
              <button class="fx-icon-btn" type="button" data-fx-redo aria-label="Redo" title="Redo">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M15 14l4 -4l-4 -4"></path>
                  <path d="M19 10h-11a4 4 0 0 0 0 8h1"></path>
                </svg>
              </button>
              <button class="fx-icon-copy" type="button" data-fx-copy aria-label="Copier le preset FX" title="Copier le preset FX">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="10" y="10" width="12" height="12" rx="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
              </button>
            </div>
          </div>
          <pre class="code" data-fx-json></pre>
          <div class="fx-preset-actions">
            <button class="btn b2" type="button" data-fx-reset>Reset defaults</button>
            <span class="mini" style="margin-bottom:0;">Clique sur une valeur pour la saisir</span>
          </div>
          <div class="fx-copy-status" data-fx-status aria-live="polite"></div>
        </div>

        <div class="fx-control-group">
          <h3>Notes</h3>
          <div class="tokenlist">
            <div><strong>Copy format</strong><span>Prompt texte pret a coller ici</span></div>
            <div><strong>Persistence</strong><span>LocalStorage du navigateur</span></div>
            <div><strong>Sync</strong><span>Preview partage avec la charte</span></div>
            <div><strong>Toggles</strong><span>Chaque checkbox coupe l'effet sans perdre sa valeur.</span></div>
          </div>
        </div>
      </aside>

      <section class="card" id="preview">
        <div class="head">
          <span class="eyebrow">Sandbox</span>
          <h2>Hero + quiz shell</h2>
          <p>Sandbox de reglage pour sentir le dosage des effets. Les blocs ISO du site sont plus bas et servent de reference fixe.</p>
        </div>
        <div class="fx-stage" data-fx-root>
          <div class="fx-orb fx-orb-a"></div>
          <div class="fx-orb fx-orb-b"></div>
          <div class="fx-shell">
            <div class="fx-badge"><span class="fx-badge-dot"></span>CRT Preview</div>
            <div class="fx-wordmark">
              <span class="fx-glitch-text" data-text="MANABU">MANABU</span>
              <span class="fx-play">PLAY</span>
            </div>
            <p class="fx-lead">Apprends le japonais via la pop culture anime, manga et gaming, avec une couche CRT dosee et maitrisee.</p>
            <div class="fx-chip-row">
              <span class="fx-chip">Arcade Tech</span>
              <span class="fx-chip">Anime Mood</span>
              <span class="fx-chip">Quiz Focus</span>
            </div>
            <div class="fx-quiz">
              <span class="fx-quiz-meta">Anime Genre</span>
              <div class="fx-quiz-assist">Chiito / Cheat</div>
              <div class="fx-quiz-word">チート</div>
              <p class="fx-quiz-copy">Le mot japonais principal reste tres visuel. Le CRT vient soutenir l'ambiance, pas noyer la lisibilite.</p>
              <div class="fx-answer-row">
                <div class="fx-answer fx-answer-good">Un pouvoir ou effet tellement fort qu'il casse l'equilibre du jeu.</div>
                <div class="fx-answer">Une technique defensive qui reduit les degats magiques.</div>
              </div>
            </div>
          </div>
        </div>

        <div class="fx-demo-panel" id="response-demo" data-response-demo>
          <div class="head">
            <span class="eyebrow">Response FX</span>
            <h2>Particles, score pop et hint</h2>
            <p>Mini terrain de jeu local pour voir les effets de reponse du quiz sans modifier le site.</p>
          </div>
          <div class="fx-demo-shell">
            <div class="fx-demo-top">
              <div class="fx-demo-stats">
                <span class="fx-demo-stat">Score <strong data-demo-score>0</strong></span>
                <span class="fx-demo-stat">Streak <strong data-demo-streak>0</strong></span>
              </div>
              <span class="fx-demo-pop" data-demo-pop aria-live="polite"></span>
            </div>
            <div class="fx-demo-card">
              <span class="fx-demo-meta">Anime Genre</span>
              <div class="fx-demo-assist">Chiito / Cheat</div>
              <div class="fx-demo-word">チート</div>
              <p class="fx-demo-copy">La demo rejoue les bons effets de retour: etat correct/wrong, combo, score pop, particles et reveal du hint.</p>
              <div class="fx-demo-feedback" data-demo-feedback>Choisis une action pour previsualiser le feedback.</div>
              <div class="fx-demo-answer-grid">
                <button class="fx-demo-answer-btn" type="button" data-demo-answer="correct">Simulate correct answer</button>
                <button class="fx-demo-answer-btn" type="button" data-demo-answer="wrong">Simulate wrong answer</button>
              </div>
              <div class="fx-demo-action-row">
                <button class="fx-demo-action-btn fx-demo-action-hint" type="button" data-demo-hint>Reveal hint</button>
                <button class="fx-demo-action-btn fx-demo-action-reset" type="button" data-demo-reset>Reset demo</button>
              </div>
              <div class="fx-demo-hint-box">
                <span class="fx-demo-hint" data-demo-hint-text hidden>Indice: pense a un pouvoir tellement fort qu'il casse l'equilibre du jeu.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="iso-reference">
          <div class="head">
            <span class="eyebrow">ISO Reference</span>
            <h2>Sections du site recopiees a l'identique</h2>
            <p>Ces deux previews viennent de pages Astro dediees, construites avec le meme CSS, le meme HTML et le meme JS que le site. Elles ne servent pas au tuning libre: elles servent a comparer.</p>
          </div>
          <div class="iso-reference-grid">
            <div class="iso-card">
              <div class="iso-card-head">
                <div>
                  <h3>Hero ISO</h3>
                  <p>Reference stricte du hero du site, pour comparer glitch, glow, scanlines et densite globale.</p>
                </div>
                <a class="iso-link" href="#" data-iso-link="/design/references/hero" target="_blank" rel="noreferrer">Open
                  <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 4h6v6"></path>
                    <path d="M10 14 20 4"></path>
                    <path d="M20 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h4"></path>
                  </svg>
                </a>
              </div>
              <div class="iso-frame-wrap">
                <iframe class="iso-frame iso-frame-hero" data-iso-preview="hero" data-iso-src="/design/references/hero" title="ManabuPlay hero ISO preview" loading="lazy"></iframe>
              </div>
            </div>

            <div class="iso-card">
              <div class="iso-card-head">
                <div>
