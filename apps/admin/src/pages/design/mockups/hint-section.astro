---
import DesignDocLayout from "../../../layouts/DesignDocLayout.astro";

const MOBILE_W = 390;
const hintOne =
  "En gacha, terme pour les unités ou items distribués gratuitement aux joueurs.";
const hintTwo = "Souvent lié au login bonus ou à une campagne limitée.";
---

<DesignDocLayout
  title="Mockup — section indices quiz"
  active="mockups"
  description="Avant / après interactif : zone « Choisis le sens » + indices (mobile 390px)."
  containerClass="hs-page"
  bodyClass="hs-body"
>
  <header class="hs-hero">
    <p class="hs-kicker">Design public · Quiz · Indices</p>
    <h1>Section indices — avant / après</h1>
    <p class="hs-lead">
      Maquette isolée du panneau « action » (titre + indices). Clique dans chaque device pour simuler
      les états. Règles retenues : malus visible sur les puces, indice 2 bloqué tant que 1 non pris,
      puce 2 absente si pas de data.
    </p>
    <div class="hs-mode-tabs" role="tablist" aria-label="Version">
      <button type="button" class="hs-mode-tab is-active" data-hs-mode="compare" role="tab" aria-selected="true">
        Côte à côte
      </button>
      <button type="button" class="hs-mode-tab" data-hs-mode="before" role="tab" aria-selected="false">
        Avant (actuel)
      </button>
      <button type="button" class="hs-mode-tab" data-hs-mode="after" role="tab" aria-selected="false">
        Après (puces)
      </button>
    </div>
  </header>

  <section class="hs-compare" data-hs-panel="compare">
    <div class="hs-pair">
      <article class="hs-shot" data-hs-variant="before">
        <div class="hs-shot-head">
          <h2>Avant</h2>
          <p class="hs-state-label" data-hs-state-label>État : initial</p>
          <button type="button" class="hs-reset" data-hs-reset>Réinitialiser</button>
        </div>
        <div class="hs-device" style={`--w: ${MOBILE_W}px;`}>
          <div class="hs-device-chrome"><span>{MOBILE_W}px · web actuel</span></div>
          <div class="hs-panel" data-hs-play-panel>
            <div class="hs-before-prompt">
              <div>
                <p class="hs-prompt-title">Choisis le sens</p>
              </div>
              <button type="button" class="hs-before-hint-btn" data-hs-before-action aria-label="Révéler l'indice">
                <span class="hs-before-hint-mark">?</span>
                <span class="hs-before-hint-label">Révéler l'indice</span>
              </button>
            </div>
            <div class="hs-before-zone" data-hs-before-zone hidden>
              <div class="hs-before-card is-locked" data-hs-before-card="1">
                <span class="hs-hint-label">Indice 1</span>
                <span class="hs-hint-copy" data-hs-before-copy="1">Verrouillé · -2 pts si révélé</span>
              </div>
              <div class="hs-before-card is-locked" data-hs-before-card="2">
                <span class="hs-hint-label">Indice 2</span>
                <span class="hs-hint-copy" data-hs-before-copy="2">Verrouillé · -5 pts si révélé</span>
              </div>
            </div>
            <p class="hs-answers-stub" aria-hidden="true">[ grille réponses 2×2 ]</p>
          </div>
        </div>
        <p class="hs-hint-copy-ui">Clique le bouton <strong>?</strong> puis les cartes se dévoilent au fil des taps (comme en prod).</p>
      </article>

      <article class="hs-shot" data-hs-variant="after">
        <div class="hs-shot-head">
          <h2>Après</h2>
          <p class="hs-state-label" data-hs-state-label>État : initial</p>
          <button type="button" class="hs-reset" data-hs-reset>Réinitialiser</button>
        </div>
        <div class="hs-device" style={`--w: ${MOBILE_W}px;`}>
          <div class="hs-device-chrome"><span>{MOBILE_W}px · puce + accordéon</span></div>
          <div class="hs-panel" data-hs-play-panel>
            <div class="hs-after-head">
              <p class="hs-prompt-title">Choisis le sens</p>
              <div class="hs-chip-row" role="group" aria-label="Indices">
                <button type="button" class="hs-chip" data-hs-chip="1" aria-pressed="false">
                  <span class="hs-chip-icon" aria-hidden="true">💡</span>
                  <span class="hs-chip-num">1</span>
                  <span class="hs-chip-cost">−2pt</span>
                </button>
                <button type="button" class="hs-chip is-locked" data-hs-chip="2" disabled aria-pressed="false">
                  <span class="hs-chip-icon" aria-hidden="true">💡</span>
                  <span class="hs-chip-num">2</span>
                  <span class="hs-chip-cost">−5pt</span>
                </button>
              </div>
            </div>
            <div class="hs-after-reveals" data-hs-after-reveals>
              <div class="hs-after-reveal" data-hs-reveal="1" hidden>
                <span class="hs-hint-label">Indice 1</span>
                <p class="hs-hint-copy">{hintOne}</p>
              </div>
              <div class="hs-after-reveal" data-hs-reveal="2" hidden>
                <span class="hs-hint-label">Indice 2</span>
                <p class="hs-hint-copy">{hintTwo}</p>
              </div>
            </div>
            <p class="hs-answers-stub" aria-hidden="true">[ grille réponses 2×2 ]</p>
          </div>
        </div>
        <p class="hs-hint-copy-ui">Clique <strong>1</strong> puis <strong>2</strong>. Pas de carte « verrouillé » vide.</p>
      </article>
    </div>

    <article class="hs-shot hs-shot--solo" data-hs-variant="after-solo">
      <div class="hs-shot-head">
        <h2>Après — un seul indice en data</h2>
        <p class="hs-state-label" data-hs-state-label>État : initial</p>
        <button type="button" class="hs-reset" data-hs-reset>Réinitialiser</button>
      </div>
      <div class="hs-device" style={`--w: ${MOBILE_W}px;`}>
        <div class="hs-device-chrome"><span>Puce 2 masquée (pas de hint2)</span></div>
        <div class="hs-panel" data-hs-play-panel data-hs-solo="true">
          <div class="hs-after-head">
            <p class="hs-prompt-title">Choisis le sens</p>
            <div class="hs-chip-row" role="group" aria-label="Indices">
              <button type="button" class="hs-chip" data-hs-chip="1" aria-pressed="false">
                <span class="hs-chip-icon" aria-hidden="true">💡</span>
                <span class="hs-chip-num">1</span>
                <span class="hs-chip-cost">−2pt</span>
              </button>
            </div>
          </div>
          <div class="hs-after-reveals" data-hs-after-reveals>
            <div class="hs-after-reveal" data-hs-reveal="1" hidden>
              <span class="hs-hint-label">Indice 1</span>
              <p class="hs-hint-copy">{hintOne}</p>
            </div>
          </div>
          <p class="hs-answers-stub" aria-hidden="true">[ grille réponses 2×2 ]</p>
        </div>
      </div>
    </article>
  </section>

  <section class="hs-solo-view" data-hs-panel="before" hidden>
    <article class="hs-shot" data-hs-variant="before">
      <div class="hs-shot-head">
        <h2>Avant — web actuel</h2>
        <p class="hs-state-label" data-hs-state-label>État : initial</p>
        <button type="button" class="hs-reset" data-hs-reset>Réinitialiser</button>
      </div>
      <div class="hs-device" style={`--w: ${MOBILE_W}px;`}>
        <div class="hs-device-chrome"><span>{MOBILE_W}px</span></div>
        <div class="hs-panel" data-hs-play-panel>
          <div class="hs-before-prompt">
            <div>
              <p class="hs-prompt-title">Choisis le sens</p>
            </div>
            <button type="button" class="hs-before-hint-btn" data-hs-before-action aria-label="Révéler l'indice">
              <span class="hs-before-hint-mark">?</span>
              <span class="hs-before-hint-label">Révéler l'indice</span>
            </button>
          </div>
          <div class="hs-before-zone" data-hs-before-zone hidden>
            <div class="hs-before-card is-locked" data-hs-before-card="1">
              <span class="hs-hint-label">Indice 1</span>
              <span class="hs-hint-copy" data-hs-before-copy="1">Verrouillé · -2 pts si révélé</span>
            </div>
            <div class="hs-before-card is-locked" data-hs-before-card="2">
              <span class="hs-hint-label">Indice 2</span>
              <span class="hs-hint-copy" data-hs-before-copy="2">Verrouillé · -5 pts si révélé</span>
            </div>
          </div>
          <p class="hs-answers-stub" aria-hidden="true">[ grille réponses 2×2 ]</p>
        </div>
      </div>
      <ol class="hs-steps">
        <li>Mobile : libellé masqué → bouton <strong>?</strong> visuellement large.</li>
        <li>Premier tap : cartes verrouillées apparaissent (hauteur).</li>
        <li>Taps suivants : révèle 1 puis 2 via le même bouton renommé.</li>
      </ol>
    </article>
  </section>

  <section class="hs-solo-view" data-hs-panel="after" hidden>
    <article class="hs-shot" data-hs-variant="after">
      <div class="hs-shot-head">
        <h2>Après — puces 💡</h2>
        <p class="hs-state-label" data-hs-state-label>État : initial</p>
        <button type="button" class="hs-reset" data-hs-reset>Réinitialiser</button>
      </div>
      <div class="hs-device" style={`--w: ${MOBILE_W}px;`}>
        <div class="hs-device-chrome"><span>{MOBILE_W}px</span></div>
        <div class="hs-panel" data-hs-play-panel>
          <div class="hs-after-head">
            <p class="hs-prompt-title">Choisis le sens</p>
            <div class="hs-chip-row" role="group" aria-label="Indices">
              <button type="button" class="hs-chip" data-hs-chip="1" aria-pressed="false">
                <span class="hs-chip-icon" aria-hidden="true">💡</span>
                <span class="hs-chip-num">1</span>
                <span class="hs-chip-cost">−2pt</span>
              </button>
              <button type="button" class="hs-chip is-locked" data-hs-chip="2" disabled aria-pressed="false">
                <span class="hs-chip-icon" aria-hidden="true">💡</span>
                <span class="hs-chip-num">2</span>
                <span class="hs-chip-cost">−5pt</span>
              </button>
            </div>
          </div>
          <div class="hs-after-reveals" data-hs-after-reveals>
            <div class="hs-after-reveal" data-hs-reveal="1" hidden>
              <span class="hs-hint-label">Indice 1</span>
              <p class="hs-hint-copy">{hintOne}</p>
            </div>
            <div class="hs-after-reveal" data-hs-reveal="2" hidden>
              <span class="hs-hint-label">Indice 2</span>
              <p class="hs-hint-copy">{hintTwo}</p>
            </div>
          </div>
          <p class="hs-answers-stub" aria-hidden="true">[ grille réponses 2×2 ]</p>
        </div>
      </div>
      <ol class="hs-steps">
        <li>Titre + 2 puces compactes (malus avant tap).</li>
        <li>Puce 2 grisée jusqu'à révélation de 1.</li>
        <li>Texte en accordéon sous la ligne, pas de cartes vides.</li>
        <li>Question suivante : tout se referme (simule avec Réinitialiser).</li>
      </ol>
    </article>

    <article class="hs-shot hs-shot--solo" data-hs-variant="after-solo">
      <div class="hs-shot-head">
        <h2>Après — hint2 absent</h2>
        <p class="hs-state-label" data-hs-state-label>État : initial</p>
        <button type="button" class="hs-reset" data-hs-reset>Réinitialiser</button>
      </div>
      <div class="hs-device" style={`--w: ${MOBILE_W}px;`}>
        <div class="hs-device-chrome"><span>Une seule puce</span></div>
        <div class="hs-panel" data-hs-play-panel data-hs-solo="true">
          <div class="hs-after-head">
            <p class="hs-prompt-title">Choisis le sens</p>
            <div class="hs-chip-row" role="group" aria-label="Indices">
              <button type="button" class="hs-chip" data-hs-chip="1" aria-pressed="false">
                <span class="hs-chip-icon" aria-hidden="true">💡</span>
                <span class="hs-chip-num">1</span>
                <span class="hs-chip-cost">−2pt</span>
              </button>
            </div>
          </div>
          <div class="hs-after-reveals" data-hs-after-reveals>
            <div class="hs-after-reveal" data-hs-reveal="1" hidden>
              <span class="hs-hint-label">Indice 1</span>
              <p class="hs-hint-copy">{hintOne}</p>
            </div>
          </div>
          <p class="hs-answers-stub" aria-hidden="true">[ grille réponses 2×2 ]</p>
        </div>
      </div>
    </article>
  </section>
</DesignDocLayout>

<script src="../../../scripts/hint-section-mockup.ts"></script>

<style>
  .hs-body {
    background: #080911;
  }

  .hs-page {
    display: grid;
    gap: 2rem;
    max-width: 1180px;
    margin: 0 auto;
    padding-bottom: 3rem;
    color: #e8e4f4;
    font-family: var(--font-body, "Chakra Petch", sans-serif);
  }

  .hs-hero h1 {
    margin: 0.35rem 0 0.5rem;
    font-family: var(--font-pixel, "Joystix", sans-serif);
    font-size: 1.35rem;
    color: #c4b5fd;
  }

  .hs-kicker {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(167, 139, 250, 0.75);
  }

  .hs-lead {
    margin: 0 0 1rem;
    max-width: 52rem;
    line-height: 1.55;
    color: rgba(226, 217, 243, 0.78);
  }

  .hs-mode-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .hs-mode-tab {
    border: 1px solid rgba(139, 92, 246, 0.35);
    border-radius: 8px;
    padding: 0.45rem 0.85rem;
    background: rgba(15, 12, 26, 0.9);
    color: rgba(226, 217, 243, 0.72);
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
  }

  .hs-mode-tab.is-active {
    border-color: rgba(34, 211, 238, 0.45);
    background: rgba(34, 211, 238, 0.1);
    color: #e0fbff;
  }

  .hs-pair {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .hs-pair {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .hs-shot {
    display: grid;
    gap: 0.65rem;
  }

  .hs-shot-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.85rem;
  }

  .hs-shot-head h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
    color: #f8f3ff;
  }

  .hs-state-label {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    color: rgba(34, 211, 238, 0.85);
  }

  .hs-reset {
    margin-left: auto;
    border: 1px solid rgba(148, 163, 184, 0.35);
    border-radius: 8px;
    padding: 0.25rem 0.55rem;
    background: transparent;
    color: #94a3b8;
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
  }

  .hs-device {
    width: min(100%, var(--w));
    border: 1px solid rgba(139, 92, 246, 0.28);
    border-radius: 12px;
    overflow: hidden;
    background: #0a0911;
  }

  .hs-device-chrome {
    padding: 0.35rem 0.55rem;
    font-size: 0.68rem;
    font-weight: 700;
    color: #8b93a7;
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(210, 220, 255, 0.08);
  }

  .hs-panel {
    padding: 0.45rem;
    display: grid;
    gap: 0.4rem;
    border: 1px solid rgba(139, 92, 246, 0.28);
    border-radius: 12px;
    margin: 0.45rem;
    background: linear-gradient(180deg, rgba(42, 32, 76, 0.8), rgba(17, 14, 31, 0.94));
  }

  .hs-prompt-title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 800;
    color: #f8f3ff;
    line-height: 1.25;
  }

  /* —— Avant —— */
  .hs-before-prompt {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.35rem;
    padding: 0.45rem 0.5rem;
    border-radius: 8px;
    border: 1px solid rgba(34, 211, 238, 0.18);
    background: rgba(34, 211, 238, 0.06);
  }

  .hs-before-hint-btn {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.35rem 0.45rem;
    border-radius: 8px;
    border: 1px solid rgba(34, 211, 238, 0.25);
    background: linear-gradient(180deg, rgba(16, 50, 68, 0.78), rgba(18, 20, 44, 0.92));
    color: #d7fbff;
    font-family: inherit;
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
  }

  .hs-before-hint-mark {
    display: grid;
    width: 1.35rem;
    height: 1.35rem;
    place-items: center;
    border-radius: 8px;
    background: rgba(34, 211, 238, 0.12);
    color: #22d3ee;
    font-weight: 900;
  }

  /* Mobile actuel : libellé masqué → bouton paraît large */
  .hs-before-hint-label {
    display: none;
  }

  .hs-before-zone {
    display: grid;
    gap: 0.35rem;
  }

  .hs-before-card {
    display: grid;
    gap: 0.25rem;
    padding: 0.45rem 0.5rem;
    border-radius: 8px;
    border: 1px solid rgba(148, 163, 184, 0.18);
    background:
      linear-gradient(90deg, rgba(148, 163, 184, 0.06) 1px, transparent 1px), rgba(15, 23, 42, 0.42);
    background-size: 12px 12px;
  }

  .hs-before-card.is-revealed {
    border-color: rgba(34, 211, 238, 0.38);
    background: linear-gradient(180deg, rgba(34, 211, 238, 0.12), rgba(12, 28, 44, 0.58));
  }

  .hs-hint-label {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(34, 211, 238, 0.82);
  }

  .hs-hint-copy {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.35;
    color: #d7fbff;
  }

  .hs-before-card.is-locked .hs-hint-copy {
    color: rgba(203, 213, 225, 0.62);
  }

  /* —— Après —— */
  .hs-after-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem;
    padding: 0.35rem 0.4rem;
    border-radius: 8px;
    border: 1px solid rgba(34, 211, 238, 0.18);
    background: rgba(34, 211, 238, 0.06);
  }

  .hs-chip-row {
    display: flex;
    flex-shrink: 0;
    gap: 0.35rem;
  }

  .hs-chip {
    display: inline-flex;
    min-width: 2.65rem;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    padding: 0.2rem 0.4rem;
    border-radius: 8px;
    border: 1px solid rgba(34, 211, 238, 0.35);
    background: rgba(16, 50, 68, 0.55);
    color: #d7fbff;
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 800;
    cursor: pointer;
  }

  .hs-chip-icon {
    font-size: 0.72rem;
    line-height: 1;
  }

  .hs-chip-num {
    font-weight: 900;
  }

  .hs-chip-cost {
    color: rgba(250, 204, 21, 0.9);
    font-size: 0.68rem;
  }

  .hs-chip.is-locked {
    opacity: 0.45;
    cursor: not-allowed;
    border-color: rgba(148, 163, 184, 0.25);
    background: rgba(15, 23, 42, 0.35);
  }

  .hs-chip.is-revealed {
    border-color: rgba(34, 211, 238, 0.55);
    background: rgba(34, 211, 238, 0.18);
    box-shadow: inset 0 0 0 1px rgba(34, 211, 238, 0.12);
  }

  .hs-chip.is-revealed .hs-chip-cost {
    color: rgba(148, 163, 184, 0.7);
  }

  .hs-after-reveals {
    display: grid;
    gap: 0.35rem;
  }

  .hs-after-reveal {
    display: grid;
    gap: 0.2rem;
    padding: 0.45rem 0.5rem;
    border-radius: 8px;
    border: 1px solid rgba(34, 211, 238, 0.22);
    background: rgba(34, 211, 238, 0.07);
  }

  .hs-answers-stub {
    margin: 0;
    padding: 0.55rem;
    border-radius: 8px;
    border: 1px dashed rgba(139, 92, 246, 0.25);
    text-align: center;
    font-size: 0.68rem;
    font-weight: 700;
    color: rgba(148, 163, 184, 0.55);
  }

  .hs-hint-copy-ui,
  .hs-steps {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.45;
    color: rgba(148, 163, 184, 0.88);
  }

  .hs-steps {
    padding-left: 1.1rem;
  }

  .hs-shot--solo {
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(139, 92, 246, 0.2);
  }
</style>
