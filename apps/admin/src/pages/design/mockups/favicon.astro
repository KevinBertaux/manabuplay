---
import DesignDocLayout from "../../../layouts/DesignDocLayout.astro";

import svgA from "../../../assets/favicon-mockups/a-cadre-void-layers.svg?raw";
import svgB from "../../../assets/favicon-mockups/b-full-layers-nav.svg?raw";
import svgC from "../../../assets/favicon-mockups/c-kanji-gaku.svg?raw";
import svgD from "../../../assets/favicon-mockups/d-monogram-mp.svg?raw";
import svgE from "../../../assets/favicon-mockups/e-gradient-seul.svg?raw";
import svgF from "../../../assets/favicon-mockups/f-kanji-gaku-void.svg?raw";

/** Largeur standard onglet Chrome (Tab::GetStandardWidth, UI refresh). */
const CHROME_TAB_WIDTH_PX = 240;
const CHROME_TAB_HEIGHT_PX = 34;

const candidates = [
  {
    id: "a",
    svg: svgA,
    file: "a-cadre-void-layers.svg",
    title: "A — Actuel preprod",
    pitch:
      "Carré gradient inset dans le void. Reprend l’icône layers simplifiée. Le cadre #0a0911 peut lire « contour noir » dans l’onglet.",
  },
  {
    id: "b",
    svg: svgB,
    file: "b-full-layers-nav.svg",
    title: "B — Layers nav (plein)",
    pitch:
      "Gradient edge-to-edge, même picto « layers » que la barre de nav (stroke). Plus cohérent produit, sans cadre.",
  },
  {
    id: "c",
    svg: svgC,
    file: "c-kanji-gaku.svg",
    title: "C — 学 sur gradient",
    pitch:
      "Kanji hero « apprendre ». Signature japonaise immédiate. Typo système dans le mockup (pas Joystix à cette taille).",
  },
  {
    id: "d",
    svg: svgD,
    file: "d-monogram-mp.svg",
    title: "D — Monogramme MP",
    pitch: "Initiales ManabuPlay, lisibles à 16px. Ton arcade/modern sans kanji.",
  },
  {
    id: "e",
    svg: svgE,
    file: "e-gradient-seul.svg",
    title: "E — Gradient seul",
    pitch: "Pastille de marque minimale (violet → fuchsia). Très net en petit, peu distinctif seul.",
  },
  {
    id: "f",
    svg: svgF,
    file: "f-kanji-gaku-void.svg",
    title: "F — 学 sur void",
    pitch:
      "Kanji en dégradé sur fond void. Moins de cadre visible qu’en A, lien direct avec le hero sans carré inset.",
  },
];

const previewSizes = [16, 32, 48];

function sizedSvg(raw: string, size: number, instanceId: string): string {
  const scoped = raw
    .replace(/id="(grad-[^"]+)"/g, `id="$1-${instanceId}"`)
    .replace(/url\(#(grad-[^)]+)\)/g, `url(#$1-${instanceId})`);

  return scoped.replace("<svg ", `<svg width="${size}" height="${size}" `);
}
---
<DesignDocLayout
  title="Mockups favicon ManabuPlay"
  active="mockups"
  description="Comparaison interne des candidats favicon avant validation et déploiement web."
  containerClass="admin-wrap font-lab-page favicon-lab-page"
>
  <section class="font-lab-hero">
    <p class="font-lab-eyebrow">Design · Favicon</p>
    <h1>Mockups favicon</h1>
    <p>
      Comparaison locale admin uniquement. Sources :
      <code>apps/admin/src/assets/favicon-mockups/</code>. Onglets simulés à{" "}
      {CHROME_TAB_WIDTH_PX}px — largeur Chrome avec un seul onglet ouvert (fullscreen 1920px).
    </p>
  </section>

  <section class="font-lab-section favicon-lab-grid">
    {
      candidates.map((item) => (
        <article class="font-lab-card favicon-lab-card">
          <p class="font-lab-card-kicker">{item.id}</p>
          <h2>{item.title}</h2>
          <p>{item.pitch}</p>

          <div class="favicon-lab-sizes">
            {previewSizes.map((size) => (
              <div class="favicon-lab-size">
                <div class="favicon-lab-chip" set:html={sizedSvg(item.svg, size, `${item.id}-${size}`)} />
                <span>{size}px</span>
              </div>
            ))}
          </div>

          <div class="favicon-lab-tabs-row">
            <div class="favicon-lab-tab favicon-lab-tab--dark is-active">
              <span class="favicon-lab-tab-icon" set:html={sizedSvg(item.svg, 16, `${item.id}-tab-dark`)} />
              <span class="favicon-lab-tab-title">ManabuPlay</span>
            </div>
            <div class="favicon-lab-tab favicon-lab-tab--light is-active">
              <span class="favicon-lab-tab-icon" set:html={sizedSvg(item.svg, 16, `${item.id}-tab-light`)} />
              <span class="favicon-lab-tab-title">ManabuPlay</span>
            </div>
          </div>
          <p class="favicon-lab-chrome-caption">
            Onglet Chrome {CHROME_TAB_WIDTH_PX}px — sombre et clair côte à côte
          </p>

          <p class="favicon-lab-path">
            <code>{item.file}</code>
          </p>
        </article>
      ))
    }
  </section>

  <section class="font-lab-section">
    <div class="font-lab-section-head">
      <p class="font-lab-eyebrow">Note</p>
      <h2>Kanji C et F</h2>
    </div>
    <p>
      Les variantes kanji utilisent une police système pour le mockup. En version finale on peut
      convertir le glyphe en tracé vectoriel ou tester Joystix converti en path si tu veux la
      signature pixel.
    </p>
  </section>
</DesignDocLayout>

<style define:vars={{ tabWidth: `${CHROME_TAB_WIDTH_PX}px`, tabHeight: `${CHROME_TAB_HEIGHT_PX}px` }}>
  .favicon-lab-page code {
    color: #e879f9;
    font-size: 0.88em;
  }

  .favicon-lab-grid {
    display: grid;
    gap: var(--space-16);
  }

  .favicon-lab-card {
    display: grid;
    gap: var(--space-12);
  }

  .favicon-lab-sizes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16);
    align-items: end;
  }

  .favicon-lab-size {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    font-size: 0.78rem;
    color: #8f8aa7;
  }

  .favicon-lab-chip {
    display: grid;
    place-items: center;
    padding: var(--space-8);
    border-radius: var(--radius-8);
    border: 1px solid rgba(167, 139, 250, 0.18);
    background: rgba(26, 22, 48, 0.72);
  }

  .favicon-lab-chip :global(svg) {
    display: block;
    image-rendering: pixelated;
  }

  .favicon-lab-tabs-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
    align-items: flex-end;
  }

  .favicon-lab-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    width: var(--tabWidth);
    height: var(--tabHeight);
    padding: 0 12px;
    border-radius: 8px 8px 0 0;
    font-family: "Segoe UI", system-ui, sans-serif;
    font-size: 12px;
    line-height: 1;
    flex-shrink: 0;
  }

  .favicon-lab-tab-icon {
    display: grid;
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
    place-items: center;
  }

  .favicon-lab-tab-icon :global(svg) {
    display: block;
    width: 16px;
    height: 16px;
  }

  .favicon-lab-tab-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .favicon-lab-tab--dark.is-active {
    background: #323639;
    color: #e8eaed;
  }

  .favicon-lab-tab--light.is-active {
    background: #ffffff;
    color: #202124;
    box-shadow: inset 0 -1px 0 #dadce0;
  }

  .favicon-lab-chrome-caption {
    margin: 0;
    font-size: 0.78rem;
    color: #8f8aa7;
  }

  .favicon-lab-path {
    margin: 0;
    font-size: 0.82rem;
    color: #8f8aa7;
  }
</style>
