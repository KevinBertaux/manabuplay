---
import DesignDocLayout from "../../../layouts/DesignDocLayout.astro";
import DeviceFrame from "../../../components/archives-mockup/DeviceFrame.astro";
import { DESKTOP_DEVICE, MOBILE_DEVICES, VARIANTS } from "../../../lib/archives-mockup-data";
---

<DesignDocLayout
  title="Mockup — calendrier Archives"
  active="mockups"
  description="3 variantes responsive : iPhone XR, autre mobile, desktop. Clique un jour pour mettre à jour le panneau focus."
  containerClass="page admin-wrap"
  bodyClass="ar-body"
>
  <div class="ar-page">
  <header class="ar-hero">
    <p class="ar-kicker">Design public · Archives</p>
    <h1>Calendrier archives — 3 options</h1>
    <p class="ar-lead">
      Refonte du mockup : comparaison par device, interaction sur la sélection de jour. Hypothèse produit inchangée —
      drawers par mois, score + tentatives, quotidien du jour distinct des archives rejouables.
    </p>
    <ul class="ar-rules">
      <li><strong>Mobile</strong> : cible tactile 44px, grille 7 colonnes ou agenda selon variante.</li>
      <li><strong>Desktop</strong> : cartes plus denses, CTA visible sur le jour sélectionné.</li>
      <li><strong>Natif</strong> : on ne remplace pas par un picker OS — inspiration iOS/Android pour densité et pastilles.</li>
    </ul>
  </header>

  {
    VARIANTS.map((variant) => (
      <section class:list={["ar-variant", `ar-v-${variant.id}`]} data-ar-variant={variant.id} aria-labelledby={`ar-v-${variant.id}-title`}>
        <header class="ar-variant-head">
          <div class="ar-variant-title-row">
            {variant.badge && <span class="ar-badge">{variant.badge}</span>}
            <span class="ar-variant-id">Option {variant.id.toUpperCase()}</span>
            <h2 id={`ar-v-${variant.id}-title`}>{variant.title}</h2>
          </div>
          <p class="ar-variant-intent">{variant.intent}</p>
          <p class="ar-variant-fit">
            <strong>Quand choisir :</strong> {variant.fit}
          </p>
        </header>

        <div class="ar-device-stack">
          <div class="ar-device-row ar-device-row--mobile">
            {MOBILE_DEVICES.map((device) => (
              <DeviceFrame id={device.id} label={device.label} width={device.width} form={device.form} />
            ))}
          </div>
          <div class="ar-device-row ar-device-row--desktop">
            <p class="ar-device-row-label">Desktop</p>
            <DeviceFrame
              id={DESKTOP_DEVICE.id}
              label={DESKTOP_DEVICE.label}
              width={DESKTOP_DEVICE.width}
              form={DESKTOP_DEVICE.form}
            />
          </div>
        </div>
      </section>
    ))
  }
  </div>
</DesignDocLayout>

<script src="../../../scripts/archives-mockup.ts"></script>

<style is:global>
  .ar-body {
    background: #080911;
  }

  .ar-page {
    color: #e8e4f4;
    font-family: var(--font-body, "Chakra Petch", sans-serif);
  }
  .ar-page {
    display: grid;
    gap: 28px;
    max-width: 1280px;
    margin-inline: auto;
    padding-bottom: 48px;
  }

  .ar-hero {
    display: grid;
    gap: 12px;
    padding: 22px;
    border: 1px solid rgba(139, 92, 246, 0.28);
    border-radius: 12px;
    background:
      radial-gradient(circle at 12% 0%, rgba(34, 211, 238, 0.12), transparent 34%),
      rgba(12, 10, 24, 0.96);
  }

  .ar-kicker,
  .ar-variant-id {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    margin: 0;
    padding: 6px 10px;
    border: 1px solid rgba(34, 211, 238, 0.28);
    border-radius: 8px;
    background: rgba(34, 211, 238, 0.08);
    color: #67e8f9;
    font-family: var(--font-pixel);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ar-hero h1 {
    margin: 0;
    color: #fff;
    font-family: var(--font-pixel);
    font-size: clamp(1.2rem, 2.4vw, 1.85rem);
    letter-spacing: 0.04em;
  }

  .ar-lead,
  .ar-variant-intent,
  .ar-variant-fit {
    margin: 0;
    color: #c7c2df;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .ar-rules {
    margin: 0;
    padding-left: 1.1rem;
    color: #a7a1be;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .ar-variant {
    display: grid;
    gap: 16px;
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    background: rgba(8, 7, 18, 0.72);
  }

  .ar-variant-head {
    display: grid;
    gap: 8px;
  }

  .ar-variant-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .ar-variant-title-row h2 {
    margin: 0;
    flex: 1 1 100%;
    color: #fff;
    font-family: var(--font-pixel);
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .ar-badge {
    padding: 6px 8px;
    border-radius: 8px;
    background: rgba(236, 72, 153, 0.16);
    border: 1px solid rgba(236, 72, 153, 0.38);
    color: #fbcfe8;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ar-device-stack {
    display: grid;
    gap: 20px;
  }

  .ar-device-row--mobile {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }

  .ar-device-row--desktop {
    display: grid;
    gap: 10px;
    padding-top: 6px;
    border-top: 1px solid rgba(139, 92, 246, 0.18);
  }

  .ar-device-row-label {
    margin: 0;
    color: rgba(34, 211, 238, 0.72);
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ar-device-row--desktop .ar-device {
    width: min(100%, var(--ar-device-w));
    justify-self: stretch;
    max-width: 100%;
  }

  .ar-device {
    width: min(100%, var(--ar-device-w));
    justify-self: center;
    border: 1px solid rgba(139, 92, 246, 0.24);
    border-radius: 12px;
    overflow: hidden;
    background: #05040a;
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.32);
  }

  .ar-device-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 12px;
    border-bottom: 1px solid rgba(139, 92, 246, 0.16);
    color: rgba(167, 139, 250, 0.78);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ar-device-chrome strong {
    color: #8deeff;
  }

  .ar-device-body {
    display: grid;
    gap: 10px;
    padding: 10px;
    background: rgba(15, 12, 26, 0.94);
  }

  .ar-shell-intro {
    text-align: center;
  }

  .ar-shell-label {
    margin: 0;
    color: #ec4899;
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ar-shell-selected {
    margin: 4px 0 0;
    color: #cffafe;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .ar-month {
    border: 1px solid rgba(139, 92, 246, 0.22);
    border-radius: 8px;
    background: rgba(12, 10, 24, 0.88);
    overflow: hidden;
  }

  .ar-month-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 12px;
    cursor: pointer;
    list-style: none;
    color: #f8f3ff;
    font-weight: 800;
  }

  .ar-month-summary::-webkit-details-marker {
    display: none;
  }

  .ar-month-summary-end {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ar-month-summary strong {
    color: rgba(34, 211, 238, 0.78);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .ar-month-chevron {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid rgba(139, 92, 246, 0.28);
    border-radius: 8px;
    background: rgba(139, 92, 246, 0.1);
    color: rgba(167, 139, 250, 0.92);
    transition: transform 160ms ease;
  }

  .ar-month-chevron svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .ar-month[open] .ar-month-chevron {
    transform: rotate(180deg);
    border-color: rgba(34, 211, 238, 0.34);
    background: rgba(34, 211, 238, 0.1);
    color: rgba(103, 232, 249, 0.95);
  }

  .ar-weekdays,
  .ar-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 4px;
    padding: 0 8px;
  }

  .ar-weekdays {
    padding-top: 4px;
    color: rgba(167, 139, 250, 0.62);
    font-size: 0.58rem;
    font-weight: 900;
    text-align: center;
    text-transform: uppercase;
  }

  .ar-grid {
    padding-bottom: 8px;
  }

  .ar-day {
    display: grid;
    gap: 2px;
    align-content: start;
    min-width: 0;
    min-height: 2.75rem;
    aspect-ratio: 1;
    padding: 4px;
    border: 1px solid rgba(139, 92, 246, 0.22);
    border-radius: 8px;
    background: rgba(13, 16, 36, 0.82);
    color: rgba(226, 217, 243, 0.88);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      border-color 140ms ease,
      box-shadow 140ms ease;
  }

  .ar-day--empty {
    opacity: 0;
    pointer-events: none;
    border-color: transparent;
    background: transparent;
  }

  .ar-day.is-disabled {
    opacity: 0.42;
    cursor: default;
    pointer-events: none;
  }

  .ar-day--played.has-record {
    border-color: rgba(250, 204, 21, 0.32);
  }

  .ar-day--current {
    border-color: rgba(34, 211, 238, 0.42);
    background: rgba(34, 211, 238, 0.1);
  }

  .ar-day--open {
    border-color: rgba(45, 212, 191, 0.28);
  }

  .ar-day.is-selected {
    border-color: rgba(236, 72, 153, 0.58);
    box-shadow:
      0 0 0 1px rgba(236, 72, 153, 0.2),
      0 0 16px rgba(236, 72, 153, 0.14);
  }

  .ar-day-top {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 2px;
  }

  .ar-day-top strong {
    font-family: var(--font-pixel);
    font-size: 0.72rem;
    color: #fff;
  }

  .ar-day-medal {
    display: grid;
    place-items: center;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 999px;
    border: 1px solid rgba(250, 204, 21, 0.34);
    background: rgba(250, 204, 21, 0.12);
    color: #facc15;
    font-size: 0.52rem;
    line-height: 1;
  }

  .ar-day-dot {
    justify-self: center;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.35);
  }

  .ar-day--played .ar-day-dot,
  .ar-day--current .ar-day-dot {
    background: #facc15;
  }

  .ar-day--open .ar-day-dot {
    background: #2dd4bf;
  }

  .ar-day--current .ar-day-dot {
    background: #22d3ee;
    box-shadow: 0 0 8px rgba(34, 211, 238, 0.5);
  }

  .ar-day-score {
    font-size: 0.58rem;
    font-weight: 850;
    color: #dbeafe;
    line-height: 1.1;
  }

  .ar-day-title,
  .ar-day-meta,
  .ar-day-cta {
    display: none;
  }

  .ar-focus {
    display: grid;
    gap: 6px;
    margin: 0 8px 8px;
    padding: 10px 12px;
    border: 1px solid rgba(34, 211, 238, 0.22);
    border-radius: 8px;
    background: rgba(2, 10, 22, 0.72);
  }

  .ar-focus-status {
    margin: 0;
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #67e8f9;
  }

  .ar-focus-status[data-ar-tone="played"] {
    color: #facc15;
  }

  .ar-focus-title {
    margin: 0;
    color: #fff;
    font-size: 0.88rem;
    font-weight: 900;
  }

  .ar-focus-pack {
    margin: 0;
    color: #a7a1be;
    font-size: 0.76rem;
  }

  .ar-focus-stats {
    display: flex;
    gap: 10px;
    color: #dbeafe;
    font-size: 0.76rem;
    font-weight: 800;
  }

  .ar-focus-stats strong {
    color: #facc15;
    font-family: var(--font-pixel);
    font-size: 0.82rem;
  }

  .ar-focus-cta {
    justify-self: start;
    min-height: 2.25rem;
    padding: 0 12px;
    border: 1px solid rgba(34, 211, 238, 0.42);
    border-radius: 8px;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.24), rgba(139, 92, 246, 0.2));
    color: #e0fbff;
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .ar-reset {
    justify-self: center;
    border: 1px solid rgba(139, 92, 246, 0.28);
    border-radius: 8px;
    background: rgba(26, 22, 48, 0.55);
    color: rgba(226, 217, 243, 0.78);
    font-size: 0.72rem;
    font-weight: 800;
    padding: 6px 10px;
    cursor: pointer;
  }

  .ar-quiz-stub {
    margin: 0;
    text-align: center;
    color: rgba(148, 163, 184, 0.45);
    font-size: 0.68rem;
  }

  /* —— Option A : dense + focus (mobile) ; cartes (desktop) —— */
  .ar-v-a .ar-device--narrow .ar-day-title,
  .ar-v-a .ar-device--narrow .ar-day-meta,
  .ar-v-a .ar-device--narrow .ar-day-cta {
    display: none;
  }

  .ar-v-a .ar-device--narrow .ar-day-dot {
    display: none;
  }

  .ar-v-a .ar-device--desktop .ar-day {
    aspect-ratio: auto;
    min-height: 5.5rem;
    gap: 4px;
    padding: 8px;
  }

  .ar-v-a .ar-device--desktop .ar-day-dot {
    display: none;
  }

  .ar-v-a .ar-device--desktop .ar-day-title,
  .ar-v-a .ar-device--desktop .ar-day-meta {
    display: block;
    font-size: 0.68rem;
    line-height: 1.25;
  }

  .ar-v-a .ar-device--desktop .ar-day-meta {
    display: grid;
    gap: 2px;
    color: rgba(226, 217, 243, 0.68);
  }

  .ar-v-a .ar-device--desktop .ar-day.is-selected .ar-day-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 1.6rem;
    margin-top: 2px;
    padding: 0 8px;
    border: 1px solid rgba(34, 211, 238, 0.42);
    border-radius: 8px;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.22), rgba(139, 92, 246, 0.18));
    color: #e0fbff;
    font-family: var(--font-pixel);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ar-v-a .ar-device--desktop .ar-focus {
    display: none;
  }

  /* —— Option B : pastilles —— */
  .ar-v-b .ar-day-score,
  .ar-v-b .ar-day-title,
  .ar-v-b .ar-day-meta,
  .ar-v-b .ar-day-cta,
  .ar-v-b .ar-day-medal {
    display: none !important;
  }

  .ar-v-b .ar-day-top {
    justify-content: center;
  }

  .ar-v-b .ar-day-dot {
    display: block;
  }

  .ar-v-b .ar-device--desktop .ar-day-score {
    display: block !important;
    text-align: center;
    font-size: 0.6rem;
  }

  /* —— Option C : agenda sur narrow, grille sur desktop —— */
  .ar-v-c .ar-cal--agenda {
    display: none;
  }

  .ar-v-c .ar-device--narrow .ar-cal--grid {
    display: none;
  }

  .ar-v-c .ar-device--narrow .ar-cal--agenda {
    display: block;
    padding: 0 8px 8px;
  }

  .ar-v-c .ar-device--desktop .ar-focus {
    display: none;
  }

  .ar-v-c .ar-device--desktop .ar-day {
    aspect-ratio: auto;
    min-height: 5.25rem;
    padding: 8px;
  }

  .ar-v-c .ar-device--desktop .ar-day-dot {
    display: none;
  }

  .ar-v-c .ar-device--desktop .ar-day-title,
  .ar-v-c .ar-device--desktop .ar-day-meta {
    display: block;
    font-size: 0.66rem;
  }

  .ar-v-c .ar-device--desktop .ar-day-meta {
    display: grid;
  }

  .ar-v-c .ar-device--desktop .ar-day.is-selected .ar-day-cta {
    display: inline-flex;
    min-height: 1.5rem;
    align-items: center;
    padding: 0 8px;
    border-radius: 8px;
    border: 1px solid rgba(34, 211, 238, 0.4);
    font-family: var(--font-pixel);
    font-size: 0.56rem;
    text-transform: uppercase;
    color: #e0fbff;
  }

  .ar-agenda-list {
    display: grid;
    gap: 6px;
  }

  .ar-agenda-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: 8px;
    align-items: center;
    width: 100%;
    padding: 8px 10px;
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 8px;
    background: rgba(13, 16, 36, 0.82);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .ar-agenda-row.is-disabled {
    opacity: 0.4;
    pointer-events: none;
  }

  .ar-agenda-row.is-selected {
    border-color: rgba(236, 72, 153, 0.55);
    box-shadow: 0 0 14px rgba(236, 72, 153, 0.12);
  }

  .ar-agenda-date strong {
    display: block;
    font-family: var(--font-pixel);
    color: #fff;
    font-size: 0.82rem;
  }

  .ar-agenda-date small {
    color: #8deeff;
    font-size: 0.58rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .ar-agenda-title {
    display: block;
    color: #fff;
    font-size: 0.76rem;
    font-weight: 900;
  }

  .ar-agenda-status {
    display: block;
    color: #a7a1be;
    font-size: 0.66rem;
  }

  .ar-agenda-score {
    color: #facc15;
    font-family: var(--font-pixel);
    font-size: 0.68rem;
  }

  @media (max-width: 860px) {
    .ar-device-row--mobile {
      grid-template-columns: 1fr;
    }
  }
</style>
