---
import DesignDocLayout from "../../../layouts/DesignDocLayout.astro";

const MOBILE_W = 390;
const MOBILE_H = 844;
const DESKTOP_W = 1120;
const DESKTOP_H = 820;

const removedLayers = [
  "// 10 QUESTIONS · Quiz du jour · sous-titre long",
  "RUN DU JOUR",
  "Défi du jour · traits décor (meter)",
  "10 questions en meta doublon",
];
---

<DesignDocLayout
  title="Mockups quiz — chantiers A & B"
  active="mockups"
  description="Validation interne : dépouillage pré-lancement (A) et jeu dans 100dvh sans scroll local (B)."
  containerClass="qc-page"
  bodyClass="qc-body"
>
  <header class="qc-hero">
    <p class="qc-kicker">Design public · Quiz</p>
    <h1>Chantiers A &amp; B</h1>
    <p class="qc-lead">
      Maquettes statiques pour valider la direction avant intégration web. CTA unique :
      <strong>Jouer</strong> / <strong>Play</strong>.
    </p>
  </header>

  <section class="qc-chantier" id="chantier-a" aria-labelledby="chantier-a-title">
    <div class="qc-chantier-head">
      <span class="qc-chantier-tag">Chantier A</span>
      <h2 id="chantier-a-title">Dépouillage pré-lancement</h2>
      <p>
        Une seule couche de texte avant le CTA. Intro section, labels picker, kicker, meter et meta
        retirés. Landing : picker direct (on réévalue un titre plus tard si trop pauvre).
      </p>
      <ul class="qc-removed" aria-label="Éléments supprimés">
        {removedLayers.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>

    <div class="qc-pair" aria-label="Mockups chantier A">
      <article class="qc-shot">
        <h3>Desktop</h3>
        <div class="qc-device qc-device--desktop" style={`--w: ${DESKTOP_W}px; --h: ${DESKTOP_H}px;`}>
          <div class="qc-device-chrome"><span>{DESKTOP_W}px</span></div>
          <div class="qc-canvas qc-canvas--a">
            <div class="qc-nav qc-nav--desktop">
              <span class="qc-brand">ManabuPlay</span>
              <span class="qc-nav-modes">
                <span class="is-active">Quotidien</span>
                <span>Arcade</span>
                <span>Archives</span>
              </span>
              <span class="qc-locale">FR | EN</span>
            </div>
            <div class="qc-main">
              <div class="qc-shell qc-shell--pre">
                <p class="qc-shell-date">Quotidien · 4 juin 2026</p>
                <p class="qc-shell-note">10 questions · renouvelée chaque jour</p>
                <button type="button" class="qc-cta">Jouer</button>
              </div>
            </div>
          </div>
        </div>
        <p class="qc-shot-note">Arcade : grille 4 difficultés + CTA, sans bloc intro.</p>
      </article>

      <article class="qc-shot">
        <h3>Mobile</h3>
        <div class="qc-device qc-device--mobile" style={`--w: ${MOBILE_W}px; --h: ${MOBILE_H}px;`}>
          <div class="qc-device-chrome"><span>{MOBILE_W}×{MOBILE_H}</span></div>
          <div class="qc-canvas qc-canvas--a qc-canvas--mobile">
            <div class="qc-nav qc-nav--mobile">
              <span class="qc-brand">ManabuPlay</span>
              <span class="qc-burger" aria-hidden="true">≡</span>
            </div>
            <div class="qc-main">
              <div class="qc-shell qc-shell--pre">
                <p class="qc-shell-date">Quotidien · 4 juin 2026</p>
                <p class="qc-shell-note">10 questions · renouvelée chaque jour</p>
                <button type="button" class="qc-cta">Jouer</button>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="qc-chantier qc-chantier--b" id="chantier-b" aria-labelledby="chantier-b-title">
    <div class="qc-chantier-head">
      <span class="qc-chantier-tag">Chantier B</span>
      <h2 id="chantier-b-title">Vue <code>100dvh</code> · carte quiz centrée</h2>
      <p>
        Pattern type app mobile : la <strong>vue</strong> (nav + zone sous nav) fait
        <code>100dvh</code>. La <strong>carte quiz</strong> garde sa hauteur contenu (pas étirée). Le surplus
        va dans des bandes flexibles au-dessus et en dessous de la carte, plus un peu de padding/gap
        <em>dans</em> la carte.
      </p>
      <p class="qc-rule">
        Réf. : shell flex colonne ·
        <code>main &#123; flex:1; display:flex; flex-direction:column &#125;</code> · spacers
        <code>flex:1</code> haut/bas · carte <code>flex:0</code> · pas de scroll local. Si la carte
        dépasse (indices ouverts), <code>max-height</code> + resserrement des gaps internes — pas étirer la
        carte à 100dvh.
      </p>
    </div>

    <div class="qc-pair" aria-label="Mockups chantier B">
      <article class="qc-shot">
        <h3>Desktop</h3>
        <div class="qc-device qc-device--desktop" style={`--w: ${DESKTOP_W}px; --h: ${DESKTOP_H}px;`}>
          <div class="qc-device-chrome">
            <span>{DESKTOP_W}px · vue 100dvh, carte centrée</span>
          </div>
          <div class="qc-canvas qc-canvas--b qc-canvas--desktop-play">
            <div class="qc-dvh-label">Vue 100dvh</div>
            <div class="qc-nav qc-nav--desktop">
              <span class="qc-brand">ManabuPlay</span>
              <span class="qc-nav-modes">
                <span class="is-active">Quotidien</span>
                <span>Arcade</span>
                <span>Archives</span>
              </span>
              <span class="qc-locale">FR | EN</span>
            </div>
            <main class="qc-viewport">
              <div class="qc-view-breathe qc-view-breathe--top" aria-hidden="true">
                <span>espace vue</span>
              </div>
              <article class="qc-quiz-card">
                <div class="qc-play-meta">
                  <div class="qc-progress">
                    <span>03/10</span>
                    <span class="qc-progress-bar"><span style="width: 30%"></span></span>
                  </div>
                  <div class="qc-hud">
                    <span>Score <strong>120</strong></span>
                    <span class="qc-streak">×2</span>
                    <span>Niv. <strong>II</strong></span>
                  </div>
                </div>
                <div class="qc-play-body">
                  <section class="qc-panel qc-word">
                    <span class="qc-chip">Gacha &amp; Rewards</span>
                    <strong class="qc-romaji">haifu</strong>
                    <span class="qc-jp"><span class="qc-kana">はいふ</span><span class="qc-kanji">配布</span></span>
                  </section>
                  <section class="qc-panel qc-action">
                    <div class="qc-prompt">
                      <div>
                        <strong>Choisis le sens</strong>
                        <span>Contexte gaming / pop culture.</span>
                      </div>
                      <span class="qc-hint-btn">?</span>
                    </div>
                    <div class="qc-hints">
                      <div class="qc-hint is-open"><span>Indice 1</span> Distribution offerte en jeu.</div>
                      <div class="qc-hint is-open"><span>Indice 2</span> Souvent lié au login bonus.</div>
                    </div>
                    <div class="qc-explain is-open">
                      <span>Explication</span>
                      <p>En gacha, la haifu désigne les unités ou items distribués gratuitement.</p>
                    </div>
                    <div class="qc-answer-block">
                      <div class="qc-answers qc-answers--grid-2">
                        <span class="qc-answer"><b>1</b>Récompense</span>
                        <span class="qc-answer is-good"><b>2</b>Distribution gratuite</span>
                        <span class="qc-answer"><b>3</b>Bonus de connexion</span>
                        <span class="qc-answer"><b>4</b>Boutique d'échange</span>
                      </div>
                      <div class="qc-next-row"><span class="qc-next">Suivant</span></div>
                    </div>
                  </section>
                </div>
              </article>
              <div class="qc-view-breathe qc-view-breathe--bottom" aria-hidden="true">
                <span>espace vue</span>
              </div>
            </main>
          </div>
        </div>
      </article>

      <article class="qc-shot">
        <h3>Mobile</h3>
        <div class="qc-device qc-device--mobile" style={`--w: ${MOBILE_W}px; --h: ${MOBILE_H}px;`}>
          <div class="qc-device-chrome">
            <span>{MOBILE_W}×{MOBILE_H} · 100dvh</span>
          </div>
          <div class="qc-canvas qc-canvas--b qc-canvas--mobile-play">
            <div class="qc-dvh-label">Vue 100dvh</div>
            <div class="qc-nav qc-nav--mobile">
              <span class="qc-brand">ManabuPlay</span>
              <span class="qc-burger" aria-hidden="true">≡</span>
            </div>
            <main class="qc-viewport">
              <div class="qc-view-breathe qc-view-breathe--top" aria-hidden="true">
                <span>espace vue</span>
              </div>
              <article class="qc-quiz-card">
                <div class="qc-play-meta">
                  <div class="qc-progress">
                    <span>03/10</span>
                    <span class="qc-progress-bar"><span style="width: 30%"></span></span>
                  </div>
                  <div class="qc-hud">
                    <span>120</span>
                    <span class="qc-streak">×2</span>
                    <span>II</span>
                  </div>
                </div>
                <div class="qc-play-body qc-play-body--stack">
                  <section class="qc-panel qc-word">
                    <span class="qc-chip">Gacha</span>
                    <strong class="qc-romaji">haifu</strong>
                    <span class="qc-jp"><span class="qc-kana">はいふ</span><span class="qc-kanji">配布</span></span>
                  </section>
                  <section class="qc-panel qc-action">
                    <div class="qc-prompt qc-prompt--tight">
                      <strong>Choisis le sens</strong>
                      <span class="qc-hint-btn">?</span>
                    </div>
                    <div class="qc-hints qc-hints--stack">
                      <div class="qc-hint is-open"><span>1</span> Distribution offerte.</div>
                      <div class="qc-hint is-open"><span>2</span> Login bonus.</div>
                    </div>
                    <div class="qc-explain is-open"><span>OK</span> Unités distribuées gratuitement.</div>
                    <div class="qc-answer-block">
                      <div class="qc-answers qc-answers--grid-2">
                        <span class="qc-answer"><b>1</b>Récompense</span>
                        <span class="qc-answer is-good"><b>2</b>Distribution gratuite</span>
                        <span class="qc-answer"><b>3</b>Bonus login</span>
                        <span class="qc-answer"><b>4</b>Boutique</span>
                      </div>
                      <div class="qc-next-row"><span class="qc-next">Suivant</span></div>
                    </div>
                  </section>
                </div>
              </article>
              <div class="qc-view-breathe qc-view-breathe--bottom" aria-hidden="true">
                <span>espace vue · footer hors vue</span>
              </div>
            </main>
          </div>
        </div>
      </article>
    </div>
  </section>
</DesignDocLayout>

<style>
  .qc-body {
    background: #080911;
  }

  .qc-page {
    display: grid;
    gap: 2.5rem;
    max-width: 1240px;
    margin: 0 auto;
    padding-bottom: 3rem;
    color: #e8e4f4;
    font-family: var(--font-body, "Chakra Petch", sans-serif);
  }

  .qc-hero h1 {
    margin: 0.35rem 0 0.5rem;
    font-family: var(--font-pixel, "Joystix", sans-serif);
    font-size: 1.35rem;
    color: #c4b5fd;
  }

  .qc-kicker,
  .qc-chantier-tag {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #22d3ee;
  }

  .qc-lead {
    margin: 0;
    max-width: 62ch;
    line-height: 1.65;
    color: #aab2c7;
  }

  .qc-chantier {
    display: grid;
    gap: 1.25rem;
    padding: 1.5rem;
    border: 1px solid rgba(139, 92, 246, 0.28);
    border-radius: 12px;
    background: rgba(17, 19, 34, 0.72);
  }

  .qc-chantier--b {
    border-color: rgba(34, 211, 238, 0.28);
    box-shadow: inset 0 0 0 1px rgba(34, 211, 238, 0.06);
  }

  .qc-chantier-head h2 {
    margin: 0.35rem 0 0.5rem;
    font-family: var(--font-pixel, "Joystix", sans-serif);
    font-size: 1.05rem;
    color: #f5f7ff;
  }

  .qc-chantier-head p {
    margin: 0;
    max-width: 70ch;
    line-height: 1.6;
    color: #b6bfd4;
  }

  .qc-rule {
    margin-top: 0.65rem !important;
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    border: 1px solid rgba(34, 211, 238, 0.22);
    background: rgba(34, 211, 238, 0.06);
    font-size: 0.88rem !important;
    color: #c8eef8 !important;
  }

  .qc-removed {
    margin: 0.85rem 0 0;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background: rgba(248, 113, 113, 0.08);
    border: 1px dashed rgba(248, 113, 113, 0.35);
    color: #fca5a5;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .qc-removed li + li {
    margin-top: 0.25rem;
  }

  .qc-pair {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }

  .qc-shot h3 {
    margin: 0 0 0.65rem;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a78bfa;
  }

  .qc-shot-note {
    margin: 0.5rem 0 0;
    font-size: 0.82rem;
    color: #8b93a7;
  }

  .qc-device {
    width: min(100%, var(--w));
    border: 1px solid rgba(210, 220, 255, 0.16);
    border-radius: 12px;
    overflow: hidden;
    background: #0a0911;
  }

  .qc-device-chrome {
    padding: 0.4rem 0.65rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: #8b93a7;
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(210, 220, 255, 0.1);
  }

  .qc-canvas {
    position: relative;
    min-height: 280px;
    background:
      radial-gradient(ellipse 80% 50% at 50% 0%, rgba(139, 92, 246, 0.12), transparent 70%),
      #0a0911;
  }

  .qc-canvas--mobile {
    min-height: var(--h);
  }

  .qc-canvas--b {
    display: flex;
    flex-direction: column;
    height: var(--h);
    min-height: var(--h);
    overflow: hidden;
  }

  /* Chantier B : vue 100dvh, carte hauteur contenu, spacers flex haut/bas. */
  .qc-canvas--desktop-play {
    --qc-view-pad-x: 1.25rem;
    --qc-breathe-min: 0.75rem;
    --qc-card-pad: 0.65rem;
    --qc-card-gap: 0.45rem;
    --qc-panel-gap: 0.35rem;
    --qc-tight-gap: 0.28rem;
  }

  .qc-canvas--mobile-play {
    --qc-view-pad-x: 0.65rem;
    --qc-breathe-min: 1rem;
    --qc-card-pad: 0.55rem;
    --qc-card-gap: 0.5rem;
    --qc-panel-gap: 0.4rem;
    --qc-tight-gap: 0.3rem;
  }

  .qc-dvh-label {
    position: absolute;
    top: 0.35rem;
    right: 0.45rem;
    z-index: 2;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #22d3ee;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.35);
  }

  .qc-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.65rem;
    border-bottom: 1px solid rgba(139, 92, 246, 0.2);
    background: rgba(10, 9, 17, 0.92);
    flex-shrink: 0;
  }

  .qc-nav--desktop {
    justify-content: space-between;
  }

  .qc-brand {
    font-family: var(--font-pixel, "Joystix", sans-serif);
    font-size: 0.62rem;
    color: #a78bfa;
  }

  .qc-nav-modes {
    display: flex;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .qc-nav-modes .is-active {
    color: #fff;
    padding: 0.2rem 0.45rem;
    border-radius: 8px;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.35);
  }

  .qc-nav-modes span:not(.is-active) {
    color: rgba(226, 217, 243, 0.55);
  }

  .qc-locale {
    font-size: 0.72rem;
    color: rgba(167, 139, 250, 0.7);
  }

  .qc-burger {
    margin-left: auto;
    padding: 0.25rem 0.45rem;
    border-radius: 8px;
    border: 1px solid rgba(139, 92, 246, 0.3);
    color: #e2d9f3;
  }

  .qc-main {
    display: grid;
    place-items: center;
    padding: 1rem 0.75rem 1.5rem;
  }

  .qc-shell--pre {
    width: min(100%, 520px);
    margin: 0 auto;
    padding: 1.25rem 1rem 1.35rem;
    border-radius: 12px;
    border: 1px solid rgba(139, 92, 246, 0.45);
    background: rgba(10, 8, 20, 0.96);
    text-align: center;
    display: grid;
    gap: 0.65rem;
  }

  .qc-shell-date {
    margin: 0;
    font-family: var(--font-pixel, "Joystix", sans-serif);
    font-size: clamp(0.78rem, 2.8vw, 0.95rem);
    line-height: 1.6;
    color: #fff;
  }

  .qc-shell-note {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 700;
    color: #94a3b8;
  }

  .qc-cta {
    margin-top: 0.35rem;
    min-height: 48px;
    padding: 0.65rem 1.5rem;
    border: none;
    border-radius: 8px;
    font-family: var(--font-pixel, "Joystix", sans-serif);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: #fff;
    background: linear-gradient(135deg, #8b5cf6, #e879f9);
    box-shadow: 0 4px 24px rgba(139, 92, 246, 0.4);
  }

  .qc-viewport {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding-inline: var(--qc-view-pad-x);
    overflow: hidden;
  }

  .qc-view-breathe {
    flex: 1 1 0;
    min-height: var(--qc-breathe-min);
    display: flex;
    align-items: center;
    justify-content: center;
    border-left: 1px dashed rgba(34, 211, 238, 0.14);
    border-right: 1px dashed rgba(34, 211, 238, 0.14);
    background: rgba(34, 211, 238, 0.03);
  }

  .qc-view-breathe span {
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(34, 211, 238, 0.38);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .qc-quiz-card {
    flex: 0 0 auto;
    width: 100%;
    max-width: 100%;
    max-height: calc(100% - var(--qc-breathe-min) * 2);
    display: flex;
    flex-direction: column;
    gap: var(--qc-card-gap);
    padding: var(--qc-card-pad);
    border-radius: 12px;
    border: 1px solid rgba(139, 92, 246, 0.45);
    background: rgba(10, 8, 20, 0.96);
    box-shadow: 0 0 28px rgba(139, 92, 246, 0.12);
    overflow: hidden;
  }

  .qc-canvas--desktop-play .qc-quiz-card {
    max-width: 52rem;
    margin-inline: auto;
  }

  .qc-play-meta {
    display: flex;
    flex-direction: column;
    gap: var(--qc-card-gap);
    flex-shrink: 0;
  }

  .qc-progress,
  .qc-hud {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    padding: 0.35rem 0.5rem;
    border-radius: 8px;
    border: 1px solid rgba(34, 211, 238, 0.2);
    background: rgba(34, 211, 238, 0.06);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .qc-progress-bar {
    flex: 1;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .qc-progress-bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #22d3ee, #e879f9);
  }

  .qc-hud {
    justify-content: space-between;
  }

  .qc-streak {
    color: #e879f9;
    font-family: var(--font-pixel, "Joystix", sans-serif);
  }

  .qc-play-body {
    display: grid;
    grid-template-columns: minmax(180px, 0.8fr) minmax(0, 1.2fr);
    gap: var(--qc-card-gap);
    align-items: stretch;
  }

  .qc-play-body--stack {
    display: flex;
    flex-direction: column;
    gap: var(--qc-card-gap);
  }

  .qc-panel {
    display: flex;
    flex-direction: column;
    gap: var(--qc-panel-gap);
    padding: var(--qc-panel-gap);
    border-radius: 8px;
    border: 1px solid rgba(139, 92, 246, 0.28);
    background: rgba(17, 14, 31, 0.94);
  }

  .qc-panel.qc-word {
    align-items: center;
    text-align: center;
    justify-content: center;
  }

  .qc-chip {
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #d6c6ff;
    padding: 0.15rem 0.45rem;
    border-radius: 8px;
    border: 1px solid rgba(169, 120, 255, 0.34);
  }

  .qc-romaji {
    font-size: 1.45rem;
    font-weight: 900;
    color: #fff;
    line-height: 1;
  }

  .qc-canvas--mobile-play .qc-romaji {
    font-size: 1.2rem;
  }

  .qc-jp {
    display: flex;
    gap: 0.35rem;
    align-items: baseline;
    flex-wrap: wrap;
    justify-content: center;
  }

  .qc-kana {
    color: #22d3ee;
    font-weight: 800;
  }

  .qc-kanji {
    color: #ff9cf0;
    font-weight: 800;
  }

  .qc-answer-block {
    display: flex;
    flex-direction: column;
    gap: var(--qc-tight-gap);
    margin-top: var(--qc-panel-gap);
  }


  .qc-prompt {
