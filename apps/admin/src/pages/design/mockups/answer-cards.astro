---
import DesignDocLayout from "../../../layouts/DesignDocLayout.astro";

const answers = [
  { key: "1", label: "Récompense", state: "bad" },
  { key: "2", label: "Distribution gratuite", state: "good" },
  { key: "3", label: "Bonus de connexion", state: "neutral" },
  { key: "4", label: "Boutique d'échange", state: "neutral" },
];

const variants = [
  {
    id: "A",
    theme: "balanced",
    title: "Card de décision",
    status: "Recommandée",
    intent:
      "La version la plus directe : romaji en point d'entrée, kana/kanji en support, réponses toujours stables.",
    bestFor:
      "Premier passage en production, parce qu'elle corrige le problème sans changer radicalement le produit.",
    rules: [
      "Romaji toujours visible et dominant.",
      "Un seul tiroir pédagogique remplace indice et explication.",
      "CTA bas toujours atteignable en mobile.",
    ],
  },
  {
    id: "B",
    theme: "tutor",
    title: "Tutor split",
    status: "Pédagogique",
    intent:
      "Une version plus didactique : le mot, les aides et le feedback sont traités comme une mini fiche d'apprentissage.",
    bestFor:
      "Mode libre ou relecture, quand on accepte un peu plus de texte pour mieux expliquer les nuances.",
    rules: [
      "Lecture, contexte et explication ont chacun une zone claire.",
      "Le drawer devient une fiche courte, pas une pile de blocs.",
      "Desktop exploite une vraie colonne de contexte.",
    ],
  },
  {
    id: "C",
    theme: "arcade",
    title: "Console arcade",
    status: "Plus jeu",
    intent:
      "Une version plus nerveuse : HUD compact, grosses commandes et feedback très proche de l'action.",
    bestFor:
      "Quiz quotidien, si on veut privilégier le rythme et l'identité arcade au côté fiche de cours.",
    rules: [
      "HUD serré : progression, score et pack sur une ligne.",
      "Les réponses ressemblent à un command deck.",
      "Le drawer est court, presque comme un log de combat.",
    ],
  },
];

const shots = [
  { layout: "mobile", state: "Plié", expanded: false },
  { layout: "mobile", state: "Déplié", expanded: true },
  { layout: "desktop", state: "Plié", expanded: false },
  { layout: "desktop", state: "Déplié", expanded: true },
];

const machineStates = [
  {
    state: "ready",
    label: "Question prête",
    purpose: "Afficher le mot et les 4 choix sans aide ouverte.",
    visible: "Progression, romaji, kana, kanji, pack, tier, 4 réponses.",
    next: "Ouvrir indice ou choisir une réponse.",
  },
  {
    state: "hint-open",
    label: "Indice ouvert",
    purpose: "Ajouter une aide courte sans déplacer les réponses.",
    visible: "Même layout que ready, drawer compact avec indice 1 puis indice 2.",
    next: "Fermer l'indice, ouvrir l'indice suivant ou choisir une réponse.",
  },
  {
    state: "answered",
    label: "Réponse verrouillée",
    purpose: "Bloquer le choix et marquer correct/incorrect.",
    visible: "Réponses colorées, bonne réponse explicite, score mis à jour.",
    next: "Afficher l'explication courte.",
  },
  {
    state: "explain-open",
    label: "Explication ouverte",
    purpose: "Remplacer le drawer d'indice par le feedback pédagogique.",
    visible: "Pourquoi, piège évité, lecture utile, CTA mot suivant.",
    next: "Passer au mot suivant.",
  },
  {
    state: "next",
    label: "Transition",
    purpose: "Nettoyer l'état local avant le mot suivant.",
    visible: "Aucun ancien indice, aucune ancienne explication.",
    next: "Retour à ready avec un nouveau mot.",
  },
];
---

<DesignDocLayout
  title="ManabuPlay - Mockup quiz public"
  active="mockups"
  description="Variantes internes pour la refonte du panneau quiz public."
  containerClass="quiz-redesign-page"
  bodyClass="quiz-redesign-body"
>
  <style is:global>
    :root {
      --page-bg: #080911;
      --page-panel: #111322;
      --page-panel-soft: #171a2b;
      --page-line: rgba(210, 220, 255, 0.12);
      --page-line-strong: rgba(210, 220, 255, 0.24);
      --page-text: #f5f7ff;
      --page-muted: #aab2c7;
      --page-soft: #d7dcef;
      --mp-bg: #080711;
      --mp-panel: rgba(17, 13, 33, 0.96);
      --mp-panel-strong: rgba(27, 21, 50, 0.98);
      --mp-line: rgba(151, 87, 255, 0.42);
      --mp-cyan: #23d9ff;
      --mp-pink: #ff73e9;
      --mp-violet: #9a6cff;
      --mp-green: #42f59c;
      --mp-gold: #f4c760;
      --mp-red: #ff6870;
    }

    .quiz-redesign-body {
      background: var(--page-bg);
      color: var(--page-text);
    }

    .quiz-redesign-page {
      width: min(1520px, calc(100vw - 24px));
      margin: 0 auto;
      padding: 24px 0 56px;
      color: var(--page-text);
      font-family: "Chakra Petch", "Segoe UI", sans-serif;
    }

    .quiz-redesign-page * {
      box-sizing: border-box;
    }

    .quiz-redesign-page h1,
    .quiz-redesign-page h2,
    .quiz-redesign-page h3,
    .quiz-redesign-page p {
      margin: 0;
    }

    .quiz-redesign-page a {
      color: inherit;
    }

    .doc-stack {
      display: grid;
      gap: 20px;
    }

    .doc-hero,
    .doc-card,
    .variant-section,
    .state-card,
    .decision-row {
      border: 1px solid var(--page-line);
      background: var(--page-panel);
      box-shadow: 0 18px 56px rgba(0, 0, 0, 0.24);
    }

    .doc-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
      gap: 24px;
      align-items: end;
      padding: 28px;
      border-radius: 12px;
    }

    .doc-kicker {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      min-height: 28px;
      padding: 0 10px;
      border: 1px solid rgba(35, 217, 255, 0.28);
      border-radius: 999px;
      background: rgba(35, 217, 255, 0.08);
      color: var(--mp-cyan);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .doc-hero h1 {
      max-width: 720px;
      margin-top: 12px;
      font-size: clamp(2rem, 4vw, 3.4rem);
      line-height: 0.98;
      letter-spacing: -0.05em;
      text-transform: uppercase;
    }

    .doc-hero p,
    .doc-card p,
    .variant-summary p,
    .state-card p {
      color: var(--page-muted);
      line-height: 1.62;
    }

    .doc-hero p {
      max-width: 760px;
      margin-top: 12px;
      font-size: 1rem;
    }

    .hero-note {
      display: grid;
      gap: 10px;
      padding: 16px;
      border: 1px solid rgba(244, 199, 96, 0.22);
      border-radius: 12px;
      background: rgba(244, 199, 96, 0.06);
    }

    .hero-note strong {
      color: var(--page-text);
    }

    .doc-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .doc-card {
      display: grid;
      gap: 10px;
      padding: 18px;
      border-radius: 12px;
    }

    .doc-card h2,
    .doc-card h3 {
      font-size: 1.1rem;
      line-height: 1.15;
    }

    .doc-card ul {
      display: grid;
      gap: 8px;
      margin: 0;
      padding-left: 18px;
      color: var(--page-muted);
      line-height: 1.48;
    }

    .section-head {
      display: grid;
      gap: 8px;
      max-width: 940px;
    }

    .section-head h2 {
      font-size: clamp(1.45rem, 2.6vw, 2.2rem);
      line-height: 1.05;
      letter-spacing: -0.04em;
    }

    .section-head p {
      color: var(--page-muted);
      line-height: 1.62;
    }

    .variant-section {
      display: grid;
      gap: 18px;
      padding: 20px;
      border-radius: 12px;
    }

    .variant-summary {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) minmax(260px, 0.55fr);
      gap: 16px;
      align-items: start;
    }

    .variant-id {
      display: grid;
      place-items: center;
      width: 56px;
      height: 56px;
      border: 1px solid rgba(35, 217, 255, 0.3);
      border-radius: 12px;
      background: rgba(35, 217, 255, 0.08);
      color: var(--mp-cyan);
      font-size: 1.7rem;
      font-weight: 900;
    }

    .variant-summary h2 {
      font-size: clamp(1.5rem, 2.5vw, 2.3rem);
      line-height: 1.05;
      letter-spacing: -0.04em;
    }

    .variant-status {
      color: var(--mp-gold);
      font-size: 0.78rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .variant-rules {
      display: grid;
      gap: 8px;
      margin: 0;
      padding: 14px 14px 14px 32px;
      border: 1px solid var(--page-line);
      border-radius: 12px;
      background: var(--page-panel-soft);
      color: var(--page-muted);
      line-height: 1.42;
    }

    .shot-grid {
      display: grid;
      grid-template-columns: minmax(320px, 0.76fr) minmax(0, 1.24fr);
      gap: 16px;
    }

    .shot-pair {
      display: grid;
      gap: 16px;
    }

    .shot {
      display: grid;
      gap: 10px;
      min-width: 0;
    }

    .shot-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-height: 36px;
      padding: 0 2px;
    }

    .shot-title {
      color: var(--page-soft);
      font-weight: 900;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .shot-badge {
      display: inline-flex;
      align-items: center;
      min-height: 28px;
      padding: 0 10px;
      border: 1px solid var(--page-line-strong);
      border-radius: 999px;
      color: var(--page-muted);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .quiz-frame {
      overflow: hidden;
      border: 1px solid rgba(151, 87, 255, 0.3);
      border-radius: 12px;
      background:
        linear-gradient(90deg, rgba(151, 87, 255, 0.08) 1px, transparent 1px),
        linear-gradient(180deg, rgba(151, 87, 255, 0.06) 1px, transparent 1px),
        var(--mp-bg);
      background-size: 48px 48px, 48px 48px, auto;
      color: #f8f3ff;
    }

    .quiz-frame.is-mobile {
      width: min(390px, 100%);
      margin: 0 auto;
    }

    .quiz-frame.is-desktop {
      width: 100%;
    }

    .quiz-shell {
      display: grid;
      gap: 12px;
      padding: 14px;
    }

    .quiz-shell.is-mobile {
      min-height: 720px;
      align-content: start;
    }

    .quiz-shell.is-desktop {
      min-height: 430px;
      grid-template-columns: minmax(250px, 0.8fr) minmax(0, 1.2fr);
      align-items: stretch;
      padding: 18px;
    }

    .quiz-hud {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 10px;
      align-items: center;
      min-height: 44px;
      padding: 8px 10px;
      border: 1px solid rgba(151, 87, 255, 0.3);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.04);
    }

    .is-desktop .quiz-hud {
      grid-column: 1 / -1;
    }

    .hud-step {
      color: var(--mp-cyan);
      font-weight: 900;
    }

    .hud-meter {
      overflow: hidden;
      height: 8px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
    }

    .hud-meter span {
      display: block;
      width: 30%;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--mp-cyan), var(--mp-pink));
    }

    .hud-score {
      color: #bfb5db;
      font-size: 0.78rem;
      font-weight: 900;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .word-panel,
    .action-panel,
    .learn-drawer {
      border: 1px solid rgba(151, 87, 255, 0.34);
      background:
        linear-gradient(180deg, rgba(42, 32, 75, 0.86), rgba(17, 14, 31, 0.96)),
        var(--mp-panel);
    }

    .word-panel {
      display: grid;
      gap: 10px;
      justify-items: center;
      align-content: center;
      min-height: 184px;
      padding: 16px;
      border-radius: 12px;
      text-align: center;
    }

    .is-mobile .word-panel {
      min-height: 176px;
    }

    .chip-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
    }

    .chip {
      display: inline-flex;
      align-items: center;
      min-height: 26px;
      padding: 0 10px;
      border: 1px solid rgba(169, 120, 255, 0.34);
      border-radius: 999px;
      background: rgba(169, 120, 255, 0.1);
      color: #d6c6ff;
      font-size: 0.72rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .romaji {
      color: #fff;
      font-size: clamp(2.5rem, 11vw, 4.6rem);
      font-weight: 900;
      line-height: 0.9;
      letter-spacing: -0.04em;
      text-transform: lowercase;
    }

    .japanese-line {
      display: flex;
      align-items: baseline;
      justify-content: center;
      gap: 12px;
    }

    .kana {
      color: var(--mp-cyan);
      font-size: 1rem;
      font-weight: 800;
    }

    .kanji {
      color: #ff9cf0;
      font-size: 2rem;
      font-weight: 800;
      line-height: 1;
      text-shadow: 0 0 6px rgba(255, 115, 233, 0.24);
    }

    .action-panel {
      display: grid;
      gap: 10px;
      align-content: start;
      padding: 12px;
      border-radius: 12px;
    }

    .prompt-line {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 10px;
      align-items: center;
      min-height: 48px;
      padding: 8px 10px;
      border: 1px solid rgba(35, 217, 255, 0.24);
      border-radius: 8px;
      background: rgba(35, 217, 255, 0.08);
    }

    .prompt-line strong {
      display: block;
      color: #f8f3ff;
      line-height: 1.2;
    }

    .prompt-line span {
      color: #aacfe0;
      font-size: 0.84rem;
    }

    .hint-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
      padding: 0 12px;
      border: 1px solid rgba(35, 217, 255, 0.44);
      border-radius: 999px;
      color: var(--mp-cyan);
      font-size: 0.76rem;
      font-weight: 900;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .answer-list {
      display: grid;
      gap: 8px;
    }

    .is-desktop .answer-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .answer {
      display: grid;
      grid-template-columns: 30px minmax(0, 1fr);
      gap: 10px;
      align-items: center;
      min-height: 54px;
      padding: 8px 10px;
      border: 1px solid rgba(151, 87, 255, 0.42);
      border-radius: 8px;
      background: linear-gradient(180deg, rgba(42, 32, 76, 0.88), rgba(23, 18, 42, 0.96));
      color: #eee7ff;
      font-weight: 900;
    }

    .answer-key {
      display: grid;
      place-items: center;
      width: 28px;
      height: 28px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.06);
      color: #cdbdff;
      font-size: 0.78rem;
    }

    .is-expanded .answer[data-state="bad"] {
      border-color: rgba(255, 104, 112, 0.76);
      background: linear-gradient(180deg, rgba(96, 38, 52, 0.78), rgba(46, 20, 29, 0.96));
      color: #ffb0b5;
    }

    .is-expanded .answer[data-state="good"] {
      border-color: rgba(66, 245, 156, 0.78);
      background: linear-gradient(180deg, rgba(32, 83, 60, 0.78), rgba(16, 43, 33, 0.96));
      color: var(--mp-green);
    }

    .learn-drawer {
      display: grid;
      gap: 8px;
      padding: 12px;
      border-radius: 8px;
    }

    .drawer-title {
      color: var(--mp-gold);
      font-size: 0.78rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .drawer-copy {
      color: #f2e7ca;
      line-height: 1.44;
    }

    .drawer-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    .drawer-fact {
      padding: 8px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.04);
      color: #ded6f7;
      font-size: 0.84rem;
      line-height: 1.35;
    }

    .bottom-bar {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      align-items: center;
      min-height: 52px;
    }

    .next-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 46px;
      padding: 0 14px;
      border-radius: 8px;
      background: linear-gradient(135deg, #7552f6, #c65df2);
      color: #fff;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .balanced .word-panel {
      min-height: 190px;
    }

    .tutor .word-panel {
      align-content: start;
      justify-items: start;
      text-align: left;
    }

    .tutor .chip-row,
    .tutor .japanese-line {
      justify-content: start;
    }

    .arcade .quiz-hud {
      border-color: rgba(35, 217, 255, 0.34);
      background: rgba(35, 217, 255, 0.07);
    }

    .arcade .word-panel {
      min-height: 160px;
      border-color: rgba(255, 115, 233, 0.3);
      background:
        radial-gradient(circle at 50% 30%, rgba(255, 115, 233, 0.08), transparent 180px),
        linear-gradient(180deg, rgba(37, 24, 58, 0.9), rgba(15, 12, 28, 0.98));
    }

    .arcade .answer {
      border-color: rgba(35, 217, 255, 0.28);
      background: linear-gradient(180deg, rgba(18, 44, 60, 0.8), rgba(17, 18, 40, 0.96));
    }

    .arcade.is-expanded .answer[data-state="good"] {
      border-color: rgba(66, 245, 156, 0.78);
    }

    .machine-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 12px;
    }

    .state-card {
      display: grid;
      gap: 10px;
      padding: 14px;
      border-radius: 12px;
    }

    .state-code {
      color: var(--mp-cyan);
      font-size: 0.72rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .state-card h3 {
      font-size: 1rem;
      line-height: 1.2;
    }

    .state-meta {
      display: grid;
      gap: 6px;
      padding-top: 4px;
      border-top: 1px solid var(--page-line);
      color: var(--page-muted);
      font-size: 0.84rem;
      line-height: 1.38;
    }

    .state-meta strong {
      color: var(--page-soft);
    }

    .decision-table {
      overflow: hidden;
      border: 1px solid var(--page-line);
      border-radius: 12px;
      background: var(--page-panel);
    }

    .decision-row {
      display: grid;
      grid-template-columns: 180px minmax(0, 1fr) minmax(0, 1fr);
      border-width: 0;
      border-top: 1px solid var(--page-line);
      box-shadow: none;
    }

    .decision-row:first-child {
      border-top: 0;
    }

    .decision-row > * {
      padding: 14px 16px;
      color: var(--page-muted);
      line-height: 1.48;
    }

    .decision-row strong {
      color: var(--page-text);
    }

    .decision-row.header > * {
      background: #191d34;
      color: var(--page-text);
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .mobile-comparison {
      display: grid;
      gap: 18px;
    }

    .mobile-comparison-row {
      display: grid;
      gap: 12px;
    }

    .mobile-comparison-row h3 {
      font-size: 1rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .mobile-comparison-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      align-items: start;
    }

    .comparison-shot {
      display: grid;
      gap: 8px;
      min-width: 0;
    }

    .comparison-shot-title {
      color: var(--page-soft);
      font-size: 0.8rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    @media (max-width: 1260px) {
      .doc-hero,
      .variant-summary,
      .shot-grid {
        grid-template-columns: 1fr;
      }

      .machine-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 840px) {
      .quiz-redesign-page {
        width: min(100% - 16px, 1520px);
        padding-top: 12px;
      }

      .doc-grid,
      .machine-grid {
        grid-template-columns: 1fr;
      }

      .doc-hero,
      .variant-section {
        padding: 16px;
      }

      .mobile-comparison-grid {
        grid-template-columns: 1fr;
      }

      .quiz-shell.is-desktop {
        grid-template-columns: 1fr;
        min-height: 560px;
      }

      .is-desktop .answer-list,
      .drawer-grid {
        grid-template-columns: 1fr;
      }

      .decision-row {
        grid-template-columns: 1fr;
      }

      .decision-row > * {
        border-top: 1px solid var(--page-line);
      }

      .decision-row > *:first-child {
        border-top: 0;
      }
    }
  </style>

  <main class="doc-stack">
    <header class="doc-hero">
      <div>
        <span class="doc-kicker">Document interne</span>
        <h1>Refonte du panneau quiz public</h1>
        <p>
          Cette page sert à comparer des directions d'interface exploitables, pas à vendre un design.
          Le contenant admin reste sobre. Les prototypes de quiz gardent volontairement le langage
          visuel ManabuPlay pour pouvoir juger le produit tel qu'il serait en place.
        </p>
      </div>
      <aside class="hero-note">
        <strong>Hypothèse de lecture</strong>
        <p>
          "Plié" = question compacte avant aide ou réponse. "Déplié" = état contraignant après
          interaction, avec feedback pédagogique visible sans casser le panneau.
        </p>
      </aside>
    </header>

    <section class="doc-grid" aria-label="Constats de cadrage">
      <article class="doc-card">
        <span class="doc-kicker">Problème produit</span>
        <h2>Le quiz ne doit pas tester la lecture japonaise</h2>
        <p>
          Le romaji est l'information d'accès. Kana et kanji restent visibles, mais en support. Sans
          romaji, un débutant ne peut pas répondre proprement.
        </p>
      </article>
      <article class="doc-card">
        <span class="doc-kicker">Problème layout</span>
        <h2>Un panneau, pas une pile de blocs</h2>
        <p>
          Indices, réponse et explication doivent partager un emplacement d'état. Le contenu change,
          la structure reste stable.
        </p>
      </article>
      <article class="doc-card">
        <span class="doc-kicker">Problème goût</span>
        <h2>Néon contrôlé, lecture prioritaire</h2>
        <p>
          Le glow doit devenir une signature, pas une lampe torche. Le mot, les choix et le feedback
          doivent rester plus importants que l'effet.
        </p>
      </article>
    </section>

    <section class="doc-stack">
      <div class="section-head">
        <span class="doc-kicker">Variantes finies</span>
        <h2>Trois directions comparables</h2>
        <p>
          Chaque variante montre quatre rendus : mobile plié, mobile déplié, desktop plié, desktop
          déplié. Les composants sont présentés comme s'ils étaient déjà implémentés.
        </p>
      </div>

      {
        variants.map((variant) => (
          <section class="variant-section" aria-labelledby={`variant-${variant.id}`}>
            <div class="variant-summary">
              <div class="variant-id">{variant.id}</div>
              <div>
                <span class="variant-status">{variant.status}</span>
                <h2 id={`variant-${variant.id}`}>{variant.title}</h2>
                <p>{variant.intent}</p>
                <p>{variant.bestFor}</p>
              </div>
              <ul class="variant-rules">
                {variant.rules.map((rule) => (
                  <li>{rule}</li>
                ))}
              </ul>
            </div>

            <div class="shot-grid">
              <div class="shot-pair">
                {shots
                  .filter((shot) => shot.layout === "mobile")
                  .map((shot) => (
                    <article class="shot">
                      <div class="shot-head">
                        <strong class="shot-title">Mobile {shot.state}</strong>
                        <span class="shot-badge">390px</span>
                      </div>
                      <div class:list={["quiz-frame", "is-mobile", variant.theme]}>
                        <div
                          class:list={[
                            "quiz-shell",
                            "is-mobile",
                            variant.theme,
                            shot.expanded && "is-expanded",
                          ]}
                        >
                          <div class="quiz-hud">
                            <span class="hud-step">03/10</span>
                            <span class="hud-meter">
                              <span></span>
                            </span>
                            <span class="hud-score">Score 1</span>
                          </div>

                          <section class="word-panel">
                            <div class="chip-row">
                              <span class="chip">Gacha & Rewards</span>
                            </div>
                            <strong class="romaji">haifu</strong>
                            <div class="japanese-line">
                              <span class="kana">はいふ</span>
                              <span class="kanji">配布</span>
                            </div>
                          </section>

                          <section class="action-panel">
                            <div class="prompt-line">
                              <div>
                                <strong>{shot.expanded ? "Réponse verrouillée" : "Choisis le sens"}</strong>
                                <span>
                                  {shot.expanded
                                    ? "Distribution gratuite."
                                    : "Contexte gaming / pop culture."}
                                </span>
                              </div>
                              <span class="hint-button">{shot.expanded ? "+1" : "Indice"}</span>
                            </div>

                            <div class="answer-list">
                              {answers.map((answer) => (
                                <span class="answer" data-state={answer.state}>
                                  <span class="answer-key">{answer.key}</span>
                                  <span>{answer.label}</span>
                                </span>
                              ))}
                            </div>

                            {shot.expanded && (
                              <section class="learn-drawer">
                                <strong class="drawer-title">Pourquoi cette réponse</strong>
                                <p class="drawer-copy">
                                  Haifu désigne une distribution gratuite : compensation,
                                  maintenance ou cadeau de campagne.
                                </p>
                                <div class="drawer-grid">
                                  <span class="drawer-fact">Indice utilisé : le jeu te le donne.</span>
                                  <span class="drawer-fact">Piège : récompense est trop générique.</span>
                                </div>
                              </section>
                            )}

                            <div class="bottom-bar">
                              <span class="next-button">{shot.expanded ? "Mot suivant" : "Valider"}</span>
                            </div>
                          </section>
                        </div>
                      </div>
                    </article>
                  ))}
              </div>

              <div class="shot-pair">
                {shots
                  .filter((shot) => shot.layout === "desktop")
                  .map((shot) => (
                    <article class="shot">
                      <div class="shot-head">
                        <strong class="shot-title">Desktop {shot.state}</strong>
                        <span class="shot-badge">Full width</span>
                      </div>
                      <div class:list={["quiz-frame", "is-desktop", variant.theme]}>
                        <div
                          class:list={[
                            "quiz-shell",
                            "is-desktop",
                            variant.theme,
                            shot.expanded && "is-expanded",
                          ]}
                        >
                          <div class="quiz-hud">
                            <span class="hud-step">03/10</span>
                            <span class="hud-meter">
                              <span></span>
                            </span>
                            <span class="hud-score">Score 1</span>
                          </div>

                          <section class="word-panel">
                            <div class="chip-row">
                              <span class="chip">Gacha & Rewards</span>
                            </div>
                            <strong class="romaji">haifu</strong>
                            <div class="japanese-line">
                              <span class="kana">はいふ</span>
                              <span class="kanji">配布</span>
                            </div>
                          </section>

                          <section class="action-panel">
                            <div class="prompt-line">
                              <div>
                                <strong>{shot.expanded ? "Réponse verrouillée" : "Choisis le sens"}</strong>
                                <span>
                                  {shot.expanded
                                    ? "Distribution gratuite."
                                    : "Contexte gaming / pop culture."}
                                </span>
                              </div>
                              <span class="hint-button">{shot.expanded ? "+1" : "Indice"}</span>
                            </div>

                            <div class="answer-list">
                              {answers.map((answer) => (
                                <span class="answer" data-state={answer.state}>
                                  <span class="answer-key">{answer.key}</span>
                                  <span>{answer.label}</span>
                                </span>
                              ))}
                            </div>

                            {shot.expanded && (
                              <section class="learn-drawer">
                                <strong class="drawer-title">Pourquoi cette réponse</strong>
                                <p class="drawer-copy">
                                  Haifu désigne une distribution gratuite : compensation,
                                  maintenance ou cadeau de campagne.
                                </p>
                                <div class="drawer-grid">
                                  <span class="drawer-fact">Indice utilisé : le jeu te le donne.</span>
                                  <span class="drawer-fact">Piège : récompense est trop générique.</span>
                                </div>
                              </section>
                            )}

                            <div class="bottom-bar">
                              <span class="next-button">{shot.expanded ? "Mot suivant" : "Valider"}</span>
                            </div>
                          </section>
                        </div>
                      </div>
                    </article>
                  ))}
              </div>
            </div>
          </section>
        ))
      }
    </section>

    <section class="doc-stack">
      <div class="section-head">
        <span class="doc-kicker">State machine</span>
        <h2>Le panneau doit fonctionner comme une machine à états</h2>
        <p>
          Le composant ne doit plus être une page qui empile du HTML. Il doit avoir des états
          exclusifs, des transitions explicites et des invariants visuels. C'est ce qui évitera les
          régressions du type "ancienne réponse encore visible", "indices qui restent ouverts" ou
          "bouton suivant hors champ".
        </p>
      </div>

      <div class="machine-grid">
        {
          machineStates.map((step) => (
            <article class="state-card">
              <span class="state-code">{step.state}</span>
              <h3>{step.label}</h3>
              <p>{step.purpose}</p>
              <div class="state-meta">
                <span>
                  <strong>Visible :</strong> {step.visible}
                </span>
                <span>
                  <strong>Transition :</strong> {step.next}
                </span>
              </div>
            </article>
          ))
        }
      </div>

      <section class="doc-card">
        <span class="doc-kicker">Invariants</span>
        <h3>Règles que tous les états doivent respecter</h3>
        <ul>
          <li>Le romaji reste visible dans tous les états.</li>
          <li>Les 4 réponses gardent leur emplacement jusqu'au mot suivant.</li>
          <li>Un seul drawer pédagogique peut être ouvert à la fois.</li>
          <li>Le bouton principal reste dans le panneau actif.</li>
          <li>Changer de mot réinitialise indice, feedback, sélection et explication.</li>
          <li>Desktop et mobile partagent les mêmes états, seule la composition responsive change.</li>
        </ul>
      </section>
    </section>

    <section class="doc-stack">
      <div class="section-head">
        <span class="doc-kicker">Décision</span>
        <h2>Comparatif de choix</h2>
      </div>

      <div class="decision-table">
        <div class="decision-row header">
          <span>Variante</span>
          <span>Avantage</span>
          <span>Risque</span>
        </div>
        <div class="decision-row">
          <strong>A - Card de décision</strong>
          <span>Meilleur compromis : clair, compact, rapide à implémenter.</span>
          <span>Moins spectaculaire que C, moins didactique que B.</span>
        </div>
        <div class="decision-row">
          <strong>B - Tutor split</strong>
          <span>Meilleur pour apprendre et relire, surtout en desktop.</span>
          <span>Peut ralentir le quiz quotidien si le texte prend trop de place.</span>
        </div>
        <div class="decision-row">
          <strong>C - Console arcade</strong>
          <span>Meilleur rythme et plus forte identité jeu.</span>
          <span>Demande plus de discipline pour ne pas redevenir trop chargé visuellement.</span>
        </div>
      </div>
    </section>

    <section class="doc-stack">
      <div class="section-head">
        <span class="doc-kicker">Comparatif mobile</span>
        <h2>Lecture directe des variantes A, B et C</h2>
        <p>
          Même mot, mêmes réponses, mêmes états. Cette section sert à comparer uniquement le rendu
          final côté utilisateur, sans notes dans les écrans.
        </p>
      </div>

      <div class="mobile-comparison">
        <div class="mobile-comparison-row">
          <h3>Mobile plié</h3>
          <div class="mobile-comparison-grid">
            {
              variants.map((variant) => (
                <article class="comparison-shot">
                  <strong class="comparison-shot-title">
                    {variant.id} - {variant.title}
                  </strong>
                  <div class:list={["quiz-frame", "is-mobile", variant.theme]}>
                    <div class:list={["quiz-shell", "is-mobile", variant.theme]}>
                      <div class="quiz-hud">
                        <span class="hud-step">03/10</span>
                        <span class="hud-meter">
                          <span></span>
                        </span>
                        <span class="hud-score">Score 1</span>
                      </div>

                      <section class="word-panel">
                        <div class="chip-row">
                          <span class="chip">Gacha & Rewards</span>
                        </div>
                        <strong class="romaji">haifu</strong>
                        <div class="japanese-line">
                          <span class="kana">はいふ</span>
                          <span class="kanji">配布</span>
                        </div>
                      </section>

                      <section class="action-panel">
                        <div class="prompt-line">
                          <div>
                            <strong>Choisis le sens</strong>
                            <span>Contexte gaming / pop culture.</span>
                          </div>
                          <span class="hint-button">Indice</span>
                        </div>

                        <div class="answer-list">
                          {answers.map((answer) => (
                            <span class="answer" data-state={answer.state}>
                              <span class="answer-key">{answer.key}</span>
                              <span>{answer.label}</span>
                            </span>
                          ))}
                        </div>

                        <div class="bottom-bar">
                          <span class="next-button">Valider</span>
                        </div>
                      </section>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>

        <div class="mobile-comparison-row">
          <h3>Mobile déplié</h3>
          <div class="mobile-comparison-grid">
            {
              variants.map((variant) => (
                <article class="comparison-shot">
                  <strong class="comparison-shot-title">
                    {variant.id} - {variant.title}
                  </strong>
                  <div class:list={["quiz-frame", "is-mobile", variant.theme]}>
                    <div class:list={["quiz-shell", "is-mobile", variant.theme, "is-expanded"]}>
                      <div class="quiz-hud">
                        <span class="hud-step">03/10</span>
                        <span class="hud-meter">
                          <span></span>
                        </span>
                        <span class="hud-score">Score 1</span>
                      </div>

                      <section class="word-panel">
                        <div class="chip-row">
                          <span class="chip">Gacha & Rewards</span>
                        </div>
                        <strong class="romaji">haifu</strong>
                        <div class="japanese-line">
                          <span class="kana">はいふ</span>
                          <span class="kanji">配布</span>
                        </div>
                      </section>

                      <section class="action-panel">
                        <div class="prompt-line">
                          <div>
                            <strong>Réponse verrouillée</strong>
                            <span>Distribution gratuite.</span>
                          </div>
                          <span class="hint-button">+1</span>
                        </div>

                        <div class="answer-list">
                          {answers.map((answer) => (
                            <span class="answer" data-state={answer.state}>
                              <span class="answer-key">{answer.key}</span>
                              <span>{answer.label}</span>
                            </span>
                          ))}
                        </div>

                        <section class="learn-drawer">
                          <strong class="drawer-title">Pourquoi cette réponse</strong>
                          <p class="drawer-copy">
                            Haifu désigne une distribution gratuite : compensation, maintenance ou
                            cadeau de campagne.
                          </p>
                          <div class="drawer-grid">
                            <span class="drawer-fact">Indice utilisé : le jeu te le donne.</span>
                            <span class="drawer-fact">Piège : récompense est trop générique.</span>
                          </div>
                        </section>

                        <div class="bottom-bar">
                          <span class="next-button">Mot suivant</span>
                        </div>
                      </section>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>
</DesignDocLayout>
