    className: "font-lab-chakra",
    usage: "Fonte retenue pour le corps, le quiz, les boutons, les aides et l'administration.",
  },
  {
    id: "joystix",
    name: "Joystix",
    className: "font-lab-joystix",
    usage: "Fonte validée pour les titres courts, la signature arcade et les accents de marque.",
  },
];

const fontDecisionNotes = [
  {
    title: "Titres",
    body: "Joystix est validée pour les titres courts, le logo, les signatures arcade et quelques accents visuels. Elle reste interdite pour le romaji, les textes longs et les chaînes dynamiques.",
  },
  {
    title: "Corps",
    body: "Chakra Petch est la fonte retenue pour le corps produit : quiz, UI, hints, réponses, pages pack, administration et textes multilingues.",
  },
  {
    title: "Pourquoi Chakra",
    body: "Elle garde mieux la lisibilité utile sur les accents FR, romaji accentués, kana/kanji, labels et textes denses. Elle donne une identité techno sans transformer chaque bloc en affiche arcade.",
  },
  {
    title: "Écart corrigé",
    body: "Le brand system, shared/styles/typography.css et tailwind.config.cjs pointent maintenant tous vers Chakra Petch pour .font-body.",
