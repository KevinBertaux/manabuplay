    text: "à â ä æ ç é è ê ë î ï ô œ ù û ü ÿ ñ",
  },
  {
    label: "Accents majuscules FR",
    text: "À Â Ä Æ Ç É È Ê Ë Î Ï Ô Œ Ù Û Ü Ÿ Ñ",
  },
  {
    label: "Phrase FR",
    text: "Équipement légendaire, coût d'énergie, unité indispensable, récompenses limitées.",
  },
  {
    label: "Kana hiragana",
    text: "あいうえお · さんかくかんけい · しゅじんこう · げんかいとっぱ",
  },
  {
    label: "Kana katakana",
    text: "アイウエオ · ワイフ · ガチャ · メガネっこ · ピックアップ",
  },
  {
    label: "Kanji",
    text: "三角関係 · 主人公 · 限界突破 · 周回 · 人権 · 報酬",
  },
  {
    label: "Mix quiz",
    text: "sankaku kankei / さんかくかんけい / 三角関係 / Triangle amoureux",
  },
  {
    label: "Chiffres et UI",
    text: "Score 200 pts · 3/10 · Combo x2.0 · T1 T2 T3 T4 · 96/100",
  },
  {
    label: "Ponctuation",
    text: "« Guillemets » — tiret long - tiret court… points ? ! (parenthèses) [chips]",
  },
];

const quizCases = [
  {
    romaji: "sankaku kankei",
    kana: "さんかくかんけい",
    kanji: "三角関係",
    fr: "Triangle amoureux",
    note: "Cas qui déborde aujourd'hui sur le panneau mot desktop.",
  },
  {
    romaji: "genkai toppa",
    kana: "げんかいとっぱ",
    kanji: "限界突破",
    fr: "Repousser les limites",
    note: "Romaji moyen, kanji dense, traduction FR longue.",
  },
  {
    romaji: "shugyō",
    kana: "しゅぎょう",
    kanji: "修行",
    fr: "Entraînement",
    note: "Macron sur ō : utile pour juger lisibilité romaji accentué.",
  },
  {
    romaji: "shujinkō",
    kana: "しゅじんこう",
    kanji: "主人公",
    fr: "Protagoniste",
    note: "Romaji accentué courant dans le pack Anime Codes.",
  },
  {
    romaji: "kouryaku jouhou",
    kana: "こうりゃくじょうほう",
    kanji: "攻略情報",
