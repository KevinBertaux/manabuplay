---
import AdminLayout from "../layouts/AdminLayout.astro";
import { getAllPacks } from "../../../../shared/lib/manabuplay-pack-reader";

const packs = getAllPacks();

function getReadiness(pack: (typeof packs)[number]) {
  return pack.score?.readiness?.value ?? null;
}

function getMinProd(pack: (typeof packs)[number]) {
  return pack.score?.readiness?.minProdScore ?? 90;
}

function getReviewLabel(pack: (typeof packs)[number]) {
  switch (pack.score?.readiness?.reviewStatus) {
    case "validee":
      return "validée";
    case "faite":
      return "faite";
    case "partielle":
      return "partielle";
    case "non-relue":
      return "non faite";
    default:
      return "n.c.";
  }
}

function getReleaseLabel(pack: (typeof packs)[number]) {
  switch (pack.score?.readiness?.releaseStatus) {
    case "prod":
      return "prod";
    case "preprod":
      return "préprod";
    case "dev":
      return "dev";
    default:
      return "n.c.";
  }
}

function getScoreTone(score: number | null) {
  if (score === null) return "na";
  if (score >= 100) return "perfect";
  if (score >= 90) return "good";
  if (score >= 75) return "mid";
  return "bad";
}

function formatDelta(value: number | null) {
  if (value === null) return "n.c.";
  return value === 0 ? "0" : `-${value}`;
}

function getTierBreakdown(pack: (typeof packs)[number]) {
  return pack.tierBreakdown ?? null;
}

function getTransparentSummary(pack: (typeof packs)[number]) {
  return pack.transparentBreakdown ?? null;
}
---
<AdminLayout
  title="Admin — ManabuPlay"
  activeNav="hub"
  description="Hub local pour piloter le produit, relire les packs, vérifier le design et suivre les opérations."
  bodyClass="text-slate-200 admin-shell"
  containerClass="admin-wrap"
>
  <Fragment slot="head">
  <style>
    .admin-shell { min-height:100vh; background:
      radial-gradient(ellipse 70% 45% at 50% -10%,rgba(139,92,246,.22) 0%,transparent 70%),
      radial-gradient(ellipse 40% 40% at 90% 15%,rgba(34,211,238,.14) 0%,transparent 60%),
      #0a0911; }
    .admin-wrap { width:min(1200px,calc(100% - 24px)); margin:0 auto; padding:88px 0 32px; }
    .admin-card { background:rgba(15,12,26,.92); border:1px solid rgba(139,92,246,.18); border-radius:8px; box-shadow:0 12px 32px rgba(0,0,0,.32); }
    .admin-hero { padding:20px; margin-bottom:16px; }
    .admin-eyebrow { display:inline-flex; align-items:center; gap:8px; min-height:32px; padding:0 12px; border-radius:8px; background:rgba(34,211,238,.12); border:1px solid rgba(34,211,238,.28); color:#22d3ee; font-size:.82rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
    .admin-eyebrow::before { content:""; width:8px; height:8px; border-radius:999px; background:currentColor; }
    .admin-title { margin:12px 0 8px; font-family:'Joystix',sans-serif; font-size:clamp(1.5rem,3vw,2.5rem); color:#fff; line-height:1.15; }
    .admin-title span { color:#e879f9; }
    .admin-copy { max-width:72ch; color:#c7c2df; font:500 1.1rem/1.68 'Chakra Petch',sans-serif; }
    .admin-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; margin-bottom:16px; }
    .tool-card { padding:16px; text-decoration:none; color:inherit; transition:border-color .18s ease,transform .18s ease,box-shadow .18s ease; }
    .tool-card:hover { border-color:rgba(139,92,246,.42); transform:translateY(-2px); box-shadow:0 12px 28px rgba(139,92,246,.14); }
    .tool-kicker { color:#22d3ee; font:700 .88rem/1 'Chakra Petch',sans-serif; letter-spacing:.08em; text-transform:uppercase; margin-bottom:8px; }
    .tool-title { color:#fff; font:700 1.26rem/1.2 'Chakra Petch',sans-serif; margin-bottom:8px; }
    .tool-copy { color:#a9a3c3; font:500 1.04rem/1.6 'Chakra Petch',sans-serif; }
    .pack-list { padding:16px; }
    .pack-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; margin-top:12px; }
    .pack-card { display:grid; gap:10px; padding:16px; border:1px solid rgba(255,255,255,.08); border-radius:8px; background:rgba(255,255,255,.04); text-decoration:none; transition:border-color .18s ease,background .18s ease,transform .18s ease; }
    .pack-card:hover { border-color:rgba(232,121,249,.38); background:rgba(232,121,249,.06); transform:translateY(-2px); }
    .pack-head { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }
    .pack-name { color:#fff; font:700 1.16rem/1.25 'Chakra Petch',sans-serif; }
    .pack-score { display:inline-flex; align-items:center; justify-content:center; min-height:32px; padding:0 12px; border-radius:8px; border:1px solid rgba(255,255,255,.1); background:rgba(255,255,255,.05); color:#d7fbff; font:800 .92rem/1 'Chakra Petch',sans-serif; letter-spacing:.04em; white-space:nowrap; }
    .pack-score.na { border-color:rgba(255,255,255,.1); background:rgba(255,255,255,.04); color:#8f8aa7; }
    .pack-score.bad { border-color:rgba(248,113,113,.28); background:rgba(248,113,113,.12); color:#fecaca; }
    .pack-score.mid { border-color:rgba(250,204,21,.28); background:rgba(250,204,21,.12); color:#fde68a; }
    .pack-score.good { border-color:rgba(34,211,238,.24); background:rgba(34,211,238,.12); color:#d7fbff; }
    .pack-score.perfect { border-color:rgba(74,222,128,.34); background:rgba(74,222,128,.14); color:#dcfce7; }
    .pack-summary { min-height:3em; color:#c7c2df; font:600 .98rem/1.5 'Chakra Petch',sans-serif; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
    .pack-meta { display:flex; gap:8px; flex-wrap:wrap; }
    .pack-chip { display:inline-flex; align-items:center; height:32px; padding:0 12px; border-radius:8px; border:1px solid rgba(139,92,246,.22); background:rgba(139,92,246,.12); color:#a78bfa; font:700 .9rem/1 'Chakra Petch',sans-serif; letter-spacing:.04em; white-space:nowrap; }
    .pack-strip { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
    .pack-strip-item { display:flex; align-items:center; justify-content:space-between; gap:8px; min-height:36px; padding:0 10px; border-radius:8px; border:1px solid rgba(255,255,255,.06); background:rgba(255,255,255,.03); color:#c7c2df; font:700 .84rem/1 'Chakra Petch',sans-serif; letter-spacing:.04em; }
    .pack-strip-label { color:#8f8aa7; text-transform:uppercase; }
    .pack-strip-value { color:#fff; text-align:right; }
    .pack-strip-value.gift-watch { color:#fde68a; }
    .pack-strip-value.gift-act { color:#fecaca; }
    .pack-tiers { display:grid; gap:8px; }
    .pack-tier-chips { display:flex; flex-wrap:wrap; gap:8px; }
    .pack-tier-chip { display:inline-flex; align-items:center; min-height:30px; padding:0 10px; border-radius:8px; border:1px solid rgba(255,255,255,.12); background:rgba(255,255,255,.05); color:#fff; font:800 .84rem/1 'Chakra Petch',sans-serif; letter-spacing:.03em; white-space:nowrap; }
    .pack-tier-chip.easy { border-color:rgba(34,211,238,.24); background:rgba(34,211,238,.12); color:#d7fbff; }
    .pack-tier-chip.mid { border-color:rgba(250,204,21,.28); background:rgba(250,204,21,.12); color:#fde68a; }
    .pack-tier-chip.hard { border-color:rgba(251,146,60,.28); background:rgba(251,146,60,.12); color:#fed7aa; }
    .pack-tier-chip.expert { border-color:rgba(248,113,113,.28); background:rgba(248,113,113,.12); color:#fecaca; }
    @media (max-width:960px) {
      .admin-grid,.pack-grid { grid-template-columns:1fr; }
      .pack-strip { grid-template-columns:1fr; }
    }
  </style>
  </Fragment>
    <section class="admin-card admin-hero">
      <span class="admin-eyebrow">Admin</span>
      <h1 class="admin-title">Manabu<span>Play</span> Admin</h1>
      <p class="admin-copy">Hub local pour piloter le produit, relire les packs, vérifier le design et suivre les opérations sans repasser par le site public.</p>
    </section>

    <section class="admin-grid">
      <a class="admin-card tool-card" href="/pilotage/backlog">
        <div class="tool-kicker">Roadmap</div>
        <div class="tool-title">Backlog produit</div>
        <p class="tool-copy">Vue principale du travail par version, à partir du roadmap.json et sans dépendre de GitHub Projects.</p>
      </a>
      <a class="admin-card tool-card" href="/pilotage/business">
        <div class="tool-kicker">Business</div>
        <div class="tool-title">Bibliotheque premium</div>
        <p class="tool-copy">Projection Free / Premium du modele retenu, avec features groupees, versions cibles et points encore a cadrer.</p>
      </a>
      <a class="admin-card tool-card" href="/pilotage/architecture">
        <div class="tool-kicker">Architecture</div>
        <div class="tool-title">Plan public</div>
        <p class="tool-copy">Programme des 14 étapes et plan de migration fichier par fichier vers Daily, Practice et Archives.</p>
      </a>
      <a class="admin-card tool-card" href="/ops/maintenance">
        <div class="tool-kicker">Maintenance</div>
        <div class="tool-title">Stockage local</div>
        <p class="tool-copy">Diagnostic et purge du vrai localStorage du navigateur courant, avec actions ciblées et remise à zéro complète.</p>
      </a>
      <a class="admin-card tool-card" href="/ops/waitlist">
        <div class="tool-kicker">Waitlist</div>
        <div class="tool-title">Collecte email</div>
        <p class="tool-copy">Lecture des inscriptions locales, export CSV daté et contrôle du parcours avant smoke test Netlify Forms.</p>
      </a>
      <a class="admin-card tool-card" href="/content/packs">
        <div class="tool-kicker">Pack Reader</div>
        <div class="tool-title">Lecteur de pack</div>
        <p class="tool-copy">Vue continue de toutes les cartes d’un pack, avec hints révélés et bonne réponse affichée.</p>
      </a>
      <a class="admin-card tool-card" href="/content/catalog">
        <div class="tool-kicker">Catalogue</div>
        <div class="tool-title">Mots futurs</div>
        <p class="tool-copy">Catalogue des mots existants mis de côté et des distracteurs assez solides pour nourrir les packs v0.2+.</p>
      </a>
      <a class="admin-card tool-card" href="/copy/landing">
        <div class="tool-kicker">Copy</div>
        <div class="tool-title">Wording landing</div>
        <p class="tool-copy">Comparatif bloc par bloc entre le wording actuel et les variantes A, B, C du lot 1.</p>
      </a>
      <a class="admin-card tool-card" href="/design/mockups/answer-cards">
        <div class="tool-kicker">UI</div>
        <div class="tool-title">Mockups réponses</div>
        <p class="tool-copy">Comparatif visuel des variantes de cartes réponses avant intégration dans le reader ou le quiz.</p>
      </a>
      <a class="admin-card tool-card" href="/design/mockups/tier-breakdown">
        <div class="tool-kicker">UI</div>
        <div class="tool-title">Mockups tiers</div>
        <p class="tool-copy">Comparatif visuel des façons d’afficher la répartition facile, moyen, difficile et expert dans les cartouches pack.</p>
      </a>
      <a class="admin-card tool-card" href="/design/fx">
        <div class="tool-kicker">FX</div>
        <div class="tool-title">FX</div>
        <p class="tool-copy">Réglage CRT, glow, glitch et démos de feedback sans toucher au site public.</p>
      </a>
      <a class="admin-card tool-card" href="/design/brand-system">
        <div class="tool-kicker">Design</div>
        <div class="tool-title">Charte graphique</div>
        <p class="tool-copy">Typo, palette, composants, règles et preview visuelle dans une route dédiée.</p>
      </a>
      <a class="admin-card tool-card" href="/guide">
        <div class="tool-kicker">Guide</div>
        <div class="tool-title">Lexique & commandes</div>
        <p class="tool-copy">Repères rapides sur les zones du dashboard, la logique du repo et les commandes utiles du split multi-app.</p>
      </a>
    </section>

    <section class="admin-card pack-list">
      <div class="tool-kicker">v0.1 Packs</div>
      <h2 class="tool-title">Packs en relecture</h2>
      <div class="pack-grid">
        {packs.map((pack) => {
          const readiness = getReadiness(pack);
          const tiers = getTierBreakdown(pack);
          const transparent = getTransparentSummary(pack);
          return (
          <a class="pack-card" href={`/content/packs/${pack.id}`}>
            <div class="pack-head">
              <div class="pack-name">{pack.locales.fr.name}</div>
              <div class:list={["pack-score", getScoreTone(readiness)]}>
                {readiness === null ? "n.c." : `${readiness}/100`}
              </div>
            </div>
            <p class="pack-summary">{pack.locales.fr.description}</p>
            <div class="pack-meta">
              <span class="pack-chip">{pack.targetWordCount} mots</span>
              <span class="pack-chip">{pack.themeId}</span>
              <span class="pack-chip">{pack.status}</span>
            </div>
            <div class="pack-tiers">
              <div class="pack-tier-chips">
                <span class="pack-tier-chip easy">{tiers ? `${tiers.counts[1]} faciles · ${tiers.percents[1]}%` : "T1 n.c."}</span>
                <span class="pack-tier-chip mid">{tiers ? `${tiers.counts[2]} moyens · ${tiers.percents[2]}%` : "T2 n.c."}</span>
                <span class="pack-tier-chip hard">{tiers ? `${tiers.counts[3]} difficiles · ${tiers.percents[3]}%` : "T3 n.c."}</span>
                <span class="pack-tier-chip expert">{tiers ? `${tiers.counts[4]} experts · ${tiers.percents[4]}%` : "T4 n.c."}</span>
              </div>
            </div>
            <div class="pack-strip">
              <div class="pack-strip-item">
                <span class="pack-strip-label">Release</span>
                <span class="pack-strip-value">{getReleaseLabel(pack)}</span>
              </div>
              <div class="pack-strip-item">
                <span class="pack-strip-label">Relecture</span>
                <span class="pack-strip-value">{getReviewLabel(pack)}</span>
              </div>
              <div class="pack-strip-item">
                <span class="pack-strip-label">Cadeaux</span>
                <span class:list={["pack-strip-value", { "gift-watch": transparent?.tone === "watch", "gift-act": transparent?.tone === "act" }]}>
                  {transparent ? `${transparent.count} · ${transparent.percent}%` : "n.c."}
                </span>
              </div>
              <div class="pack-strip-item">
                <span class="pack-strip-label">Delta prod</span>
                <span class="pack-strip-value">{formatDelta(readiness === null ? null : Math.max(0, getMinProd(pack) - readiness))}</span>
              </div>
              <div class="pack-strip-item">
                <span class="pack-strip-label">Delta max</span>
                <span class="pack-strip-value">{formatDelta(readiness === null ? null : 100 - readiness)}</span>
              </div>
            </div>
          </a>
          );
        })}
      </div>
    </section>
</AdminLayout>
