---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getAllPacks } from "../../../../../../shared/lib/manabuplay-pack-reader";

const packs = getAllPacks();
function getReadiness(pack: (typeof packs)[number]) {
  return pack.score?.readiness?.value ?? null;
}

function getContentReadyLabel(pack: (typeof packs)[number]) {
  return pack.score?.readiness?.contentReady ? "prêt" : "à stabiliser";
}

function getReleaseApprovalLabel(pack: (typeof packs)[number]) {
  return pack.score?.readiness?.releaseApproved ? "validé" : "à valider";
}

function getReviewLabel(pack: (typeof packs)[number]) {
  const progress = pack.score?.readiness?.reviewProgress;
  const progressLabel = progress ? ` · ${progress.reviewedWords}/${progress.totalWords}` : "";

  switch (pack.score?.readiness?.reviewStatus) {
    case "validee":
      return "validée";
    case "faite":
      return `faite${progressLabel}`;
    case "partielle":
      return `partielle${progressLabel}`;
    case "non-relue":
      return "non faite";
    default:
      return "n.c.";
  }
}

function getReleaseLabel(pack: (typeof packs)[number]) {
  switch (pack.score?.readiness?.releaseStatus) {
    case "prod":
      return "prod";
    case "preprod":
      return "préprod";
    case "dev":
      return "dev";
    default:
      return "n.c.";
  }
}

function getScoreTone(score: number | null) {
  if (score === null) return "na";
  if (score >= 100) return "perfect";
  if (score >= 90) return "good";
  if (score >= 75) return "mid";
  return "bad";
}

function getTierBreakdown(pack: (typeof packs)[number]) {
  return pack.tierBreakdown ?? null;
}

function getTransparentSummary(pack: (typeof packs)[number]) {
  return pack.transparentBreakdown ?? null;
}

function formatTransparencyScore(value: number) {
  return Number.isInteger(value) ? String(value) : value.toFixed(1);
}
---
<AdminLayout
  title="Lecteur de packs — ManabuPlay Admin"
  activeNav="packs"
  description="Vue liste du lecteur de packs avec score, tiers, état contenu et validation release."
  bodyClass="text-slate-200 packs-shell"
  containerClass="packs-wrap"
>
    <section class="packs-card packs-hero">
      <span class="packs-eyebrow">Lecteur</span>
      <h1 class="packs-title">Packs <span>v0.1</span></h1>
      <p class="packs-copy">Le lecteur sert à relire un pack comme un quiz figé. On vérifie le contenu mot par mot, la difficulté par tiers, la qualité des réponses, l’état contenu et le go release manuel.</p>
      <div class="score-grid">
        <div class="score-rule">
          <div class="score-label">Taille : 15 points</div>
          <p class="score-text">Vérifie que le pack a assez de mots pour exister sans paraître pauvre. La cible active v0.1 est maintenant de 34 mots.</p>
        </div>
        <div class="score-rule">
          <div class="score-label">Tiers : 15 points</div>
          <p class="score-text">Mesure l’écart avec la répartition cible 10 / 8 / 7 / 5. Le pack fournit la matière, puis le quiz s’appuie dessus pour composer des sessions crédibles.</p>
        </div>
        <div class="score-rule">
          <div class="score-label">Contenu : 40 points</div>
          <p class="score-text">Champ par champ : gloss, définition, hints, explication, lecture, romaji. C’est le plus gros morceau du score.</p>
        </div>
        <div class="score-rule">
          <div class="score-label">Qualité quiz : 15 points</div>
          <p class="score-text">Regarde comment le pack se comporte une fois joué : distracteurs faibles, mots trop évidents, variété insuffisante, cohérence quiz moyenne.</p>
        </div>
        <div class="score-rule">
          <div class="score-label">Relecture : 15 points</div>
          <p class="score-text">Validation humaine du pack. Un contenu est prêt à partir de 90/100, relecture complète et transparence sous contrôle. Le go release reste manuel.</p>
        </div>
      </div>
    </section>

    <section class="packs-card packs-grid-shell">
      <div class="score-label">Packs disponibles</div>
      <div class="packs-grid">
        {packs.map((pack) => {
          const readiness = getReadiness(pack);
          const tiers = getTierBreakdown(pack);
          const transparent = getTransparentSummary(pack);
          return (
            <a class="pack-card" href={`/content/packs/${pack.id}/`}>
              <div class="pack-head">
                <div class="pack-name">{pack.locales.fr.name}</div>
                <div class:list={["pack-score", getScoreTone(readiness)]}>
                  {readiness === null ? "n.c." : `${readiness}/100`}
                </div>
              </div>
              <p class="pack-summary">{pack.locales.fr.description}</p>
              <div class="pack-meta">
                <span class="pack-chip">{pack.targetWordCount} mots</span>
                <span class="pack-chip">{pack.themeId}</span>
                <span class="pack-chip">{pack.status}</span>
              </div>
              <div class="pack-tiers">
                <div class="pack-tier-chips">
                  <span class="pack-tier-chip easy">{tiers ? `${tiers.counts[1]} faciles · ${tiers.percents[1]}%` : "T1 n.c."}</span>
                  <span class="pack-tier-chip mid">{tiers ? `${tiers.counts[2]} moyens · ${tiers.percents[2]}%` : "T2 n.c."}</span>
                  <span class="pack-tier-chip hard">{tiers ? `${tiers.counts[3]} difficiles · ${tiers.percents[3]}%` : "T3 n.c."}</span>
                  <span class="pack-tier-chip expert">{tiers ? `${tiers.counts[4]} experts · ${tiers.percents[4]}%` : "T4 n.c."}</span>
                </div>
              </div>
              <div class="pack-strip">
                <div class="pack-strip-item">
                  <span class="pack-strip-label">Release</span>
                  <span class="pack-strip-value">{getReleaseLabel(pack)}</span>
                </div>
                <div class="pack-strip-item">
                  <span class="pack-strip-label">Contenu</span>
                  <span class="pack-strip-value">{getContentReadyLabel(pack)}</span>
                </div>
                <div class="pack-strip-item">
                  <span class="pack-strip-label">Go final</span>
                  <span class="pack-strip-value">{getReleaseApprovalLabel(pack)}</span>
                </div>
                <div class="pack-strip-item">
                  <span class="pack-strip-label">Relecture</span>
                  <span class="pack-strip-value">{getReviewLabel(pack)}</span>
                </div>
                <div class="pack-strip-item">
                  <span class="pack-strip-label">Transparence</span>
                  <span class:list={["pack-strip-value", { "gift-watch": transparent?.tone === "watch", "gift-act": transparent?.tone === "act" }]}>
                    {transparent ? `${formatTransparencyScore(transparent.weightedScore)} · ${transparent.weightedPercent}%` : "n.c."}
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>
</AdminLayout>
