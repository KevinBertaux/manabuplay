---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getRoadmapCatalog } from "../../lib/manabuplay-roadmap";

const catalog = getRoadmapCatalog();
const existingWords = catalog.candidateWords.filter((word) => word.status === "existing-word");
const candidateWords = catalog.candidateWords.filter((word) => word.status === "candidate-word");

function getSourceLabel(source: string) {
  return source === "legacy-mvp" ? "Mot existant" : "Distracteur promu";
}
---
<AdminLayout
  title="Catalogue futur — ManabuPlay Admin"
  activeNav="catalog"
  description="Catalogue des mots réutilisables et packs futurs hors lecteur de pack jouable."
  bodyClass="text-slate-200 catalog-shell"
  containerClass="catalog-wrap"
>
  <Fragment slot="head">
  <style>
    .catalog-shell { min-height:100vh; background:
      radial-gradient(ellipse 70% 45% at 50% -10%,rgba(139,92,246,.22) 0%,transparent 70%),
      radial-gradient(ellipse 40% 40% at 90% 15%,rgba(34,211,238,.14) 0%,transparent 60%),
      #0a0911; }
    .catalog-wrap { width:min(1240px,calc(100% - 24px)); margin:0 auto; padding:88px 0 32px; }
    .catalog-card { background:rgba(15,12,26,.92); border:1px solid rgba(139,92,246,.18); border-radius:8px; box-shadow:0 12px 32px rgba(0,0,0,.32); }
    .catalog-hero,.catalog-section { padding:20px; margin-bottom:16px; }
    .catalog-eyebrow { display:inline-flex; align-items:center; gap:8px; min-height:32px; padding:0 12px; border-radius:8px; background:rgba(34,211,238,.12); border:1px solid rgba(34,211,238,.28); color:#22d3ee; font-size:.82rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
    .catalog-eyebrow::before { content:""; width:8px; height:8px; border-radius:999px; background:currentColor; }
    .catalog-title { margin:12px 0 8px; font-family:'Joystix',sans-serif; font-size:clamp(1.4rem,2.8vw,2.3rem); color:#fff; line-height:1.15; }
    .catalog-title span { color:#e879f9; }
    .catalog-copy { max-width:80ch; color:#c7c2df; font:500 1.08rem/1.66 'Chakra Petch',sans-serif; }
    .catalog-notes { display:grid; gap:8px; margin-top:14px; }
    .catalog-note { color:#a9a3c3; font:500 1rem/1.6 'Chakra Petch',sans-serif; }
    .catalog-stats { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; margin-top:16px; }
    .catalog-stat { display:grid; gap:6px; min-height:72px; padding:12px; border-radius:8px; border:1px solid rgba(255,255,255,.08); background:rgba(255,255,255,.04); }
    .catalog-stat-label { color:#8f8aa7; font:700 .82rem/1 'Chakra Petch',sans-serif; letter-spacing:.08em; text-transform:uppercase; }
    .catalog-stat-value { color:#fff; font:800 1.12rem/1 'Chakra Petch',sans-serif; }
    .catalog-section-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; }
    .catalog-section-title { color:#fff; font:700 1.32rem/1.2 'Chakra Petch',sans-serif; }
    .catalog-section-copy { color:#a9a3c3; font:500 1rem/1.6 'Chakra Petch',sans-serif; }
    .catalog-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
    .catalog-item { display:grid; gap:10px; padding:16px; border-radius:8px; border:1px solid rgba(255,255,255,.08); background:rgba(255,255,255,.04); }
    .catalog-item-top { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }
    .catalog-item-title { color:#fff; font:700 1.14rem/1.2 'Chakra Petch',sans-serif; }
    .catalog-item-jp { color:#e879f9; font:700 1.24rem/1.1 'Chakra Petch',sans-serif; }
    .catalog-item-assist { color:#22d3ee; font:600 1rem/1.4 'Chakra Petch',sans-serif; }
    .catalog-chip-row,.catalog-pack-row { display:flex; gap:8px; flex-wrap:wrap; }
    .catalog-chip { display:inline-flex; align-items:center; min-height:32px; padding:0 12px; border-radius:8px; border:1px solid rgba(139,92,246,.22); background:rgba(139,92,246,.12); color:#c7c2df; font:700 .88rem/1 'Chakra Petch',sans-serif; letter-spacing:.04em; }
    .catalog-chip.source-distractor { border-color:rgba(250,204,21,.24); background:rgba(250,204,21,.12); color:#fde68a; }
    .catalog-chip.source-existing { border-color:rgba(34,211,238,.24); background:rgba(34,211,238,.12); color:#d7fbff; }
    .catalog-pack { display:inline-flex; align-items:center; min-height:32px; padding:0 12px; border-radius:8px; border:1px solid rgba(232,121,249,.22); background:rgba(232,121,249,.1); color:#f5d0fe; font:700 .88rem/1 'Chakra Petch',sans-serif; letter-spacing:.04em; }
    .catalog-field { color:#8f8aa7; font:700 .82rem/1 'Chakra Petch',sans-serif; letter-spacing:.08em; text-transform:uppercase; }
    .catalog-value { color:#c7c2df; font:500 1rem/1.55 'Chakra Petch',sans-serif; }
    .catalog-roadmap { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; align-items:start; }
    .catalog-roadmap-card { display:grid; gap:10px; padding:16px; border-radius:8px; border:1px solid rgba(255,255,255,.08); background:rgba(255,255,255,.04); align-self:start; }
    .catalog-roadmap-version { color:#22d3ee; font:700 .86rem/1 'Chakra Petch',sans-serif; letter-spacing:.08em; text-transform:uppercase; }
    .catalog-roadmap-title { color:#fff; font:700 1.12rem/1.2 'Chakra Petch',sans-serif; }
    .catalog-roadmap-theme { color:#a9a3c3; font:500 .98rem/1.5 'Chakra Petch',sans-serif; }
    .catalog-roadmap-toggle { display:grid; gap:8px; }
    .catalog-roadmap-summary { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:40px; padding:0 12px; border-radius:8px; border:1px solid rgba(255,255,255,.08); background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.03)); cursor:pointer; list-style:none; }
    .catalog-roadmap-summary::-webkit-details-marker { display:none; }
    .catalog-roadmap-summary-main { display:flex; align-items:center; gap:10px; min-width:0; }
    .catalog-roadmap-summary-text { color:#fff; font:700 .98rem/1 'Chakra Petch',sans-serif; }
    .catalog-roadmap-count { display:inline-flex; align-items:center; min-height:28px; padding:0 10px; border-radius:8px; border:1px solid rgba(255,255,255,.1); background:rgba(255,255,255,.05); color:#d7fbff; font:800 .82rem/1 'Chakra Petch',sans-serif; letter-spacing:.04em; white-space:nowrap; }
    .catalog-roadmap-chevron { color:#8f8aa7; font:800 1rem/1 'Chakra Petch',sans-serif; transition:transform .18s ease,color .18s ease; }
    .catalog-roadmap-toggle[open] .catalog-roadmap-summary { border-color:rgba(232,121,249,.22); background:linear-gradient(180deg,rgba(232,121,249,.08),rgba(255,255,255,.04)); }
    .catalog-roadmap-toggle[open] .catalog-roadmap-count { border-color:rgba(232,121,249,.24); background:rgba(232,121,249,.08); color:#f5d0fe; }
    .catalog-roadmap-toggle[open] .catalog-roadmap-chevron { color:#f5d0fe; transform:rotate(180deg); }
    .catalog-roadmap-list { display:flex; gap:8px; flex-wrap:wrap; padding:2px 2px 0; }
    .catalog-rejects { display:flex; gap:8px; flex-wrap:wrap; }
    .catalog-reject { display:inline-flex; align-items:center; min-height:32px; padding:0 12px; border-radius:8px; border:1px solid rgba(248,113,113,.18); background:rgba(248,113,113,.08); color:#fecaca; font:700 .88rem/1 'Chakra Petch',sans-serif; letter-spacing:.04em; }
    @media (max-width:1080px) {
      .catalog-roadmap { grid-template-columns:1fr; }
      .catalog-stats { grid-template-columns:repeat(2,minmax(0,1fr)); }
      .catalog-grid { grid-template-columns:1fr; }
    }
    @media (max-width:620px) {
      .catalog-stats { grid-template-columns:1fr; }
    }
  </style>
  </Fragment>

    <section class="catalog-card catalog-hero">
      <span class="catalog-eyebrow">Catalogue futur</span>
      <h1 class="catalog-title">Mots réutilisables <span>& packs possibles</span></h1>
      <p class="catalog-copy">Cette page sépare les vrais mots existants du MVP et les distracteurs assez solides pour devenir de futurs mots. Le lecteur de pack reste réservé aux packs jouables. Ici, on trie la matière pour les packs `v0.2+`.</p>
      <div class="catalog-notes">
        {catalog.notes.map((note) => <p class="catalog-note">{note}</p>)}
      </div>
      <div class="catalog-stats">
        <div class="catalog-stat">
          <span class="catalog-stat-label">Mots existants</span>
          <span class="catalog-stat-value">{existingWords.length}</span>
        </div>
        <div class="catalog-stat">
          <span class="catalog-stat-label">Distracteurs promus</span>
          <span class="catalog-stat-value">{candidateWords.length}</span>
        </div>
        <div class="catalog-stat">
          <span class="catalog-stat-label">Packs futurs</span>
          <span class="catalog-stat-value">{catalog.packs.length}</span>
        </div>
        <div class="catalog-stat">
          <span class="catalog-stat-label">Distracteurs rejetés</span>
          <span class="catalog-stat-value">{catalog.rejectedDistractors.length}</span>
        </div>
      </div>
    </section>

    <section class="catalog-card catalog-section">
      <div class="catalog-section-head">
        <div>
          <h2 class="catalog-section-title">Mots existants mis de côté</h2>
          <p class="catalog-section-copy">Les `8` mots déjà présents dans le stock actuel, rangés avec leurs packs possibles.</p>
        </div>
      </div>
      <div class="catalog-grid">
        {existingWords.map((word) => (
          <article class="catalog-item">
            <div class="catalog-item-top">
              <div>
                {word.jp && <div class="catalog-item-jp">{word.jp}</div>}
                <div class="catalog-item-title">{word.locales.fr.label} / {word.locales.en.label}</div>
                {word.assist && <div class="catalog-item-assist">{word.assist}</div>}
              </div>
              <div class="catalog-chip-row">
                <span class="catalog-chip source-existing">{getSourceLabel(word.source)}</span>
              </div>
            </div>
            <div>
              <div class="catalog-field">Source technique</div>
              <div class="catalog-value">{word.existingWordId || "n.c."}</div>
            </div>
            <div>
              <div class="catalog-field">Packs possibles</div>
              <div class="catalog-pack-row">
                {word.candidatePackIds.map((packId) => <span class="catalog-pack">{packId}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="catalog-card catalog-section">
      <div class="catalog-section-head">
        <div>
          <h2 class="catalog-section-title">Distracteurs promus en candidats</h2>
          <p class="catalog-section-copy">{candidateWords.length} distracteurs ont déjà été promus en mots candidats. Ils viennent du pack 1, puis des packs 2 et 3 après harmonisation, quand ils paraissent assez solides pour soutenir un vrai pack plus tard.</p>
        </div>
      </div>
      <div class="catalog-grid">
        {candidateWords.map((word) => (
          <article class="catalog-item">
            <div class="catalog-item-top">
              <div>
                <div class="catalog-item-title">{word.locales.fr.label} / {word.locales.en.label}</div>
              </div>
              <div class="catalog-chip-row">
                <span class="catalog-chip source-distractor">{getSourceLabel(word.source)}</span>
              </div>
            </div>
            <div>
              <div class="catalog-field">Packs possibles</div>
              <div class="catalog-pack-row">
                {word.candidatePackIds.map((packId) => <span class="catalog-pack">{packId}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="catalog-card catalog-section">
      <div class="catalog-section-head">
        <div>
          <h2 class="catalog-section-title">Roadmap packs</h2>
          <p class="catalog-section-copy">Vue pack-first de ce qui pourra être rempli ensuite, avec les candidats déjà identifiés et les mots encore à écrire.</p>
        </div>
      </div>
      <div class="catalog-roadmap">
        {catalog.packs.map((pack) => (
          <article class="catalog-roadmap-card">
            <div class="catalog-roadmap-version">{pack.targetVersion}</div>
            <div class="catalog-roadmap-title">{pack.locales.fr.name}</div>
            <div class="catalog-roadmap-theme">{pack.themeId}</div>
            <details class="catalog-roadmap-toggle">
              <summary class="catalog-roadmap-summary">
                <span class="catalog-roadmap-summary-main">
                  <span class="catalog-roadmap-summary-text">Mots candidats</span>
                  <span class="catalog-roadmap-count">{pack.candidateWordIds.length}</span>
                </span>
                <span class="catalog-roadmap-chevron">▾</span>
              </summary>
              <div class="catalog-roadmap-list">
                {pack.candidateWordIds.map((candidateId) => <span class="catalog-pack">{candidateId}</span>)}
              </div>
            </details>
            <details class="catalog-roadmap-toggle">
              <summary class="catalog-roadmap-summary">
                <span class="catalog-roadmap-summary-main">
                  <span class="catalog-roadmap-summary-text">Mots à écrire</span>
                  <span class="catalog-roadmap-count">{pack.plannedWords.length}</span>
                </span>
                <span class="catalog-roadmap-chevron">▾</span>
              </summary>
              <div class="catalog-roadmap-list">
                {pack.plannedWords.map((word) => <span class="catalog-pack">{word}</span>)}
              </div>
            </details>
          </article>
        ))}
      </div>
    </section>

    <section class="catalog-card catalog-section">
      <div class="catalog-section-head">
        <div>
          <h2 class="catalog-section-title">Distracteurs rejetés</h2>
          <p class="catalog-section-copy">Labels jugés trop utilitaires, trop liés au quiz ou trop faibles pour devenir de vrais mots à ce stade.</p>
        </div>
      </div>
      <div class="catalog-rejects">
        {catalog.rejectedDistractors.map((word) => <span class="catalog-reject">{word}</span>)}
      </div>
    </section>
</AdminLayout>
