---
import AdminLayout from "./AdminLayout.astro";
import type { AdminNavKey } from "../lib/admin-nav";

interface Props {
  title: string;
  active: AdminNavKey;
  description?: string;
  lang?: string;
  containerClass?: string;
  bodyClass?: string;
}

const {
  title,
  active,
  description,
  lang = "fr",
  containerClass = "page",
  bodyClass = "",
} = Astro.props;
---
<AdminLayout
  title={title}
  activeNav={active}
  description={description}
  lang={lang}
  bodyClass={bodyClass}
  containerClass={containerClass}
>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>
  <slot />
  <Fragment slot="scripts">
    <slot name="scripts" />
  </Fragment>
</AdminLayout>
