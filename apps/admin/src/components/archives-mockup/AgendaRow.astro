---
import { getMayDayDetail, DEFAULT_SELECTED_DAY, type CalendarCell } from "../../lib/archives-mockup-data";

interface Props {
  cell: CalendarCell;
}

const { cell } = Astro.props;
const skip = !cell.day || cell.tone === "empty";
const selected = cell.day === DEFAULT_SELECTED_DAY;
const detail = cell.day ? getMayDayDetail(cell.day) : undefined;

const classList = [
  "ar-agenda-row",
  `ar-agenda-row--${cell.tone}`,
  selected && "is-selected",
  cell.disabled && "is-disabled",
];

const dataAttrs = {
  "data-ar-day": "",
  "data-ar-day-num": cell.day,
  "data-ar-disabled": cell.disabled ? "true" : "false",
  "data-ar-tone": cell.tone,
  "data-ar-title": detail?.title ?? cell.title ?? "",
  "data-ar-pack": detail?.pack ?? "",
  "data-ar-status": detail?.status ?? cell.status ?? "",
  "data-ar-score": detail?.score ?? cell.score ?? "",
  "data-ar-attempts": detail?.attempts ?? cell.attempts ?? "",
  "data-ar-cta": detail?.cta ?? "Jouer",
};
---

{
  skip ? null : cell.disabled ? (
    <span class:list={classList} {...dataAttrs}>
      <span class="ar-agenda-date">
        <strong>{cell.day}</strong>
        <small>mai</small>
      </span>
      <span class="ar-agenda-main">
        <span class="ar-agenda-title">{cell.title}</span>
        <span class="ar-agenda-status">{cell.status}</span>
      </span>
      <span class="ar-agenda-score">{cell.score === "—" ? "—" : `${cell.score} pts`}</span>
    </span>
  ) : (
    <button type="button" class:list={classList} {...dataAttrs}>
      <span class="ar-agenda-date">
        <strong>{cell.day}</strong>
        <small>mai</small>
      </span>
      <span class="ar-agenda-main">
        <span class="ar-agenda-title">{cell.title}</span>
        <span class="ar-agenda-status">{cell.status}</span>
      </span>
      <span class="ar-agenda-score">{cell.score === "—" ? "—" : `${cell.score} pts`}</span>
    </button>
  )
}
