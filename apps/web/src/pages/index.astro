---
import { DEFAULT_PUBLIC_LOCALE, PUBLIC_LOCALES } from "../lib/public-locales";

const redirectPayload = {
  supportedLocales: PUBLIC_LOCALES,
  fallbackLocale: DEFAULT_PUBLIC_LOCALE,
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, follow" />
  <title>ManabuPlay</title>
  <template id="public-root-redirect-data">{JSON.stringify(redirectPayload)}</template>
  <script src="../scripts/public-root-redirect.ts"></script>
</head>
<body class="m-0 bg-[#0a0911] font-sans text-[#f3f1ff]">
  <main class="grid min-h-[100svh] place-items-center p-6 text-center">
    <div>
      <h1>ManabuPlay</h1>
      <p>Choose your language.</p>
      <p>
        <a class="text-[#22d3ee]" href="/en/">English</a>
        <span aria-hidden="true"> · </span>
        <a class="text-[#22d3ee]" href="/fr/">Français</a>
      </p>
    </div>
  </main>
</body>
</html>
