---
import { DEFAULT_PUBLIC_LOCALE, PUBLIC_LOCALES } from "../lib/public-locales";

const supportedLocales = JSON.stringify(PUBLIC_LOCALES);
const fallbackLocale = JSON.stringify(DEFAULT_PUBLIC_LOCALE);
const redirectScript = `
(function () {
  var supported = ${supportedLocales};
  var fallback = ${fallbackLocale};
  var preferred = (navigator.languages || [navigator.language || fallback])
    .map(function (lang) { return String(lang || '').toLowerCase().split('-')[0]; })
    .find(function (lang) { return supported.indexOf(lang) !== -1; }) || fallback;
  window.location.replace('/' + preferred + '/' + window.location.search + window.location.hash);
})();
`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, follow" />
  <title>ManabuPlay</title>
  <script is:inline set:html={redirectScript}></script>
</head>
<body style="margin:0;background:#0a0911;color:#f3f1ff;font-family:sans-serif;">
  <main style="min-height:100svh;display:grid;place-items:center;text-align:center;padding:24px;">
    <div>
      <h1>ManabuPlay</h1>
      <p>Choose your language.</p>
      <p>
        <a href="/en/" style="color:#22d3ee;">English</a>
        <span aria-hidden="true"> · </span>
        <a href="/fr/" style="color:#22d3ee;">Français</a>
      </p>
    </div>
  </main>
</body>
</html>
