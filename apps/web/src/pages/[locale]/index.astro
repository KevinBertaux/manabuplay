---
import PublicLayout from "../../layouts/PublicLayout.astro";
import PublicQuiz from "../../components/PublicQuiz.astro";
import { buildDailyBootData } from "../../../../../shared/lib/manabuplay-daily";

import { normalizePublicLocale } from "../../lib/public-locales";
import { getPublicStaticLocalePaths } from "../../lib/public-routes";

export function getStaticPaths() {
  return getPublicStaticLocalePaths();
}

const locale = normalizePublicLocale(Astro.params.locale);
const bootData = buildDailyBootData();
const lang = bootData.lang[locale] ?? bootData.lang.en;
const bootPayload = {
  locale,
  data: bootData,
};
const heroSectionClass =
  "hero-bg grid-bg relative flex min-h-[100svh] flex-col items-center justify-center overflow-hidden px-6 pb-12 pt-24 text-center";
const heroBadgeClass =
  "mb-8 inline-flex items-center gap-2 rounded-full border border-[rgba(34,211,238,.3)] bg-[rgba(34,211,238,.07)] px-4 py-2 font-body text-base font-[600] text-[var(--cyan)]";
const heroTitleClass =
  "relative mb-6 flex flex-wrap items-center justify-center gap-3 font-pixel text-[clamp(1.52rem,3.2vw,2.5rem)] leading-relaxed";
const heroTaglineClass =
  "mb-4 max-w-4xl font-body text-[clamp(1.56rem,2.5vw,2.35rem)] font-[600] leading-snug text-slate-300";
const heroSubClass =
  "mb-8 max-w-3xl font-body text-[clamp(1.02rem,1.55vw,1.38rem)] leading-relaxed text-slate-400";
const statValueClass = "font-pixel text-2xl";
const featureIconBaseClass =
  "mb-4 flex h-11 w-11 items-center justify-center rounded-lg border text-2xl";
const noAccountStatValue = "0";
---
<PublicLayout
  locale={locale}
  title={lang.seo_title}
  description={lang.seo_description}
  ogTitle={lang.seo_title}
  ogDescription={lang.og_description}
  bootPayload={bootPayload}
  includeQuizRuntime
>

  <!-- ══ HERO ══ -->
  <section class={heroSectionClass}>
    <span class="kanji-bg left-[-2%] top-[5%] rotate-[-15deg] text-[var(--violet)]">学</span>
    <span class="kanji-bg bottom-[5%] right-[-2%] rotate-[10deg] text-[var(--fuchsia)]">遊</span>
    <div class="absolute left-[15%] top-[20%] h-64 w-64 rounded-full bg-[radial-gradient(circle,rgba(139,92,246,.2)_0%,transparent_70%)] blur-[40px] [animation:float_6s_ease-in-out_infinite]"></div>
    <div class="absolute bottom-[25%] right-[10%] h-48 w-48 rounded-full bg-[radial-gradient(circle,rgba(232,121,249,.2)_0%,transparent_70%)] blur-[30px] [animation:float_8s_ease-in-out_infinite_2s]"></div>

    <div class="w-full max-w-4xl mx-auto flex flex-col items-center">
      <div class={heroBadgeClass}>
        <span class="h-2 w-2 rounded-full bg-[var(--cyan)] [animation:pulse_2s_infinite]"></span>
        <span data-i18n="hero_badge"></span>
      </div>

      <div class={heroTitleClass}>
        <span class="glitch-text text-white" data-text="MANABU">MANABU</span>
        <span class="glow-fuchsia text-[var(--fuchsia)]">PLAY</span>
      </div>
      <h1 class={heroTaglineClass} data-i18n="hero_tagline"></h1>
      <p class={heroSubClass} data-i18n="hero_sub"></p>

      <div class="hero-actions">
        <a href="#quiz" class="cta-btn hero-cta inline-flex items-center justify-center" data-i18n="hero_cta" data-quiz-action="launchQuiz"></a>
        <a href="#features" class="font-body font-600 text-slate-400 hover:text-slate-200 transition-colors text-lg" data-i18n="hero_how"></a>
      </div>

      <div class="flex gap-8 mt-12 flex-wrap justify-center items-center">
        <div class="text-center min-w-24">
          <div class:list={[statValueClass, "text-[var(--violet)]"]}>170</div>
          <div class="stat-label text-slate-500 mt-1" data-i18n="stat_words"></div>
        </div>
        <div class="w-px h-10 bg-slate-800 hidden sm:block"></div>
        <div class="text-center min-w-24">
          <div class:list={[statValueClass, "text-[var(--fuchsia)]"]}>4</div>
          <div class="stat-label text-slate-500 mt-1" data-i18n="stat_diff"></div>
        </div>
        <div class="w-px h-10 bg-slate-800 hidden sm:block"></div>
        <div class="text-center min-w-24">
          <div class:list={[statValueClass, "text-[var(--cyan)]"]}>{noAccountStatValue}</div>
          <div class="stat-label text-slate-500 mt-1" data-i18n="stat_free"></div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 opacity-40">
      <div class="h-8 w-px bg-[linear-gradient(to_bottom,transparent,var(--violet))]"></div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--violet)" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
    </div>
  </section>

  <PublicQuiz />

  <!-- ══ FEATURES ══ -->
  <section id="features" class="py-16 px-6 max-w-5xl mx-auto">
    <div class="text-center mb-12 reveal">
      <p class="section-label text-[var(--cyan)]" data-i18n="features_label"></p>
      <h2 class="pixel-heading-md mt-4 text-white" data-i18n="features_title"></h2>
      <p class="font-body text-xl text-slate-400 mt-4 max-w-2xl mx-auto" data-i18n="features_sub"></p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <div class="feature-card p-6 reveal">
        <div class:list={[featureIconBaseClass, "border-[rgba(139,92,246,.3)] bg-[rgba(139,92,246,.15)]"]}>⚔️</div>
        <h3 class="pixel-card-title mb-4 text-[#a78bfa]" data-i18n="feat1_title"></h3>
        <p class="font-body text-lg text-slate-400 leading-relaxed" data-i18n="feat1_body"></p>
      </div>
      <div class="feature-card reveal p-6 delay-100">
        <div class:list={[featureIconBaseClass, "border-[rgba(232,121,249,.3)] bg-[rgba(232,121,249,.15)]"]}>🧠</div>
        <h3 class="pixel-card-title mb-4 text-[#e879f9]" data-i18n="feat2_title"></h3>
        <p class="font-body text-lg text-slate-400 leading-relaxed" data-i18n="feat2_body"></p>
      </div>
      <div class="feature-card reveal p-6 delay-200">
        <div class:list={[featureIconBaseClass, "border-[rgba(34,211,238,.2)] bg-[rgba(34,211,238,.1)]"]}>🎮</div>
        <h3 class="pixel-card-title mb-4 text-[#22d3ee]" data-i18n="feat3_title"></h3>
        <p class="font-body text-lg text-slate-400 leading-relaxed" data-i18n="feat3_body"></p>
      </div>
    </div>
  </section>

  <!-- ══ EMAIL ══ -->
  <section id="notify" class="py-20 px-6 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_60%_at_50%_50%,rgba(232,121,249,.07)_0%,transparent_70%)]"></div>
    <div class="max-w-xl mx-auto text-center relative z-10 reveal">
      <p class="section-label mb-4 text-[var(--fuchsia)]" data-i18n="email_label"></p>
      <h2 class="pixel-heading-md text-white leading-relaxed mb-4" data-i18n="email_title"></h2>
      <p class="font-body text-xl text-slate-400 mb-8" data-i18n="email_sub"></p>
      <!-- Netlify Forms hidden bot-trap (required by Netlify) -->
      <form name="manabuplay-waitlist" method="POST" data-netlify="true" netlify-honeypot="bot-field"
            class="flex flex-col sm:flex-row gap-3">
        <!-- Hidden fields required by Netlify -->
        <input type="hidden" name="form-name" value="manabuplay-waitlist" />
        <p class="hidden"><label>Don't fill this out: <input name="bot-field"/></label></p>
        <!-- Visible fields -->
        <input type="email" id="emailInput" name="email" class="email-input flex-1" data-i18n-ph="email_ph" required autocomplete="email"/>
        <button type="submit" class="cta-btn whitespace-nowrap text-[.72rem]" data-i18n="email_cta"></button>
      </form>
      <div id="emailSuccess" class="mt-5 hidden">
        <span class="font-pixel text-[.78rem] text-[var(--cyan)]" data-i18n="email_ok"></span>
      </div>
      <p class="font-body text-sm text-slate-600 mt-5" data-i18n="email_legal"></p>
    </div>
  </section>

  <!-- ══ FOOTER ══ -->
  <footer class="border-t border-[rgba(139,92,246,.15)] px-6 py-8">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
      <div class="flex items-center gap-2">
        <span class="glow-violet font-pixel text-[.78rem] text-[#a78bfa]">Manabu<span class="text-[#e879f9]">Play</span></span>
        <span class="text-slate-700">•</span>
        <span class="font-body text-sm text-slate-600"><span data-i18n="footer_by"></span> <span class="text-slate-400 font-600">Kxis</span></span>
      </div>
      <div class="font-body text-sm text-slate-700" data-i18n="footer_quote"></div>
      <div class="flex gap-5">
        <a href="#quiz"   class="font-body text-sm text-slate-600 hover:text-slate-400 transition-colors" data-i18n="footer_quiz"></a>
        <a href="#notify" class="font-body text-sm text-slate-600 hover:text-slate-400 transition-colors" data-i18n="footer_updates"></a>
      </div>
    </div>
  </footer>

</PublicLayout>
