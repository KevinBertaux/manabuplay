---
import PublicLayout from "../../layouts/PublicLayout.astro";
import PublicQuiz from "../../components/PublicQuiz.astro";
import { buildCatalogBootData } from "../../../../../shared/data/manabuplay/catalog";
import { buildArchivesBootData, getArchiveMonthGroups, getLatestArchiveDateKey } from "../../../../../shared/lib/manabuplay-archives";
import { buildDailyBootData } from "../../../../../shared/lib/manabuplay-daily";
import { buildPracticeBootData } from "../../../../../shared/lib/manabuplay-practice";
import { normalizePublicLocale } from "../../lib/public-locales";
import {
  PUBLIC_MODE_COPY,
  type PublicModeKey,
  getLocalizedHomePath,
  getPublicStaticModePaths,
} from "../../lib/public-routes";

export function getStaticPaths() {
  return getPublicStaticModePaths();
}

const locale = normalizePublicLocale(Astro.params.locale);
const mode = Astro.params.mode as PublicModeKey;
const copy = PUBLIC_MODE_COPY[mode] ?? PUBLIC_MODE_COPY.daily;
const isDailyMode = mode === "daily";
const isPracticeMode = mode === "practice";
const isArchivesMode = mode === "archives";
const isQuizMode = isDailyMode || isPracticeMode || isArchivesMode;
const latestArchiveDate = isArchivesMode ? getLatestArchiveDateKey() : null;
const archiveMonthGroups = isArchivesMode
  ? getArchiveMonthGroups({ locale, selectedDate: latestArchiveDate })
  : [];
const bootData = isDailyMode
  ? buildDailyBootData()
  : isPracticeMode
    ? buildPracticeBootData()
    : isArchivesMode
      ? buildArchivesBootData(latestArchiveDate ?? undefined)
    : buildCatalogBootData();
const lang = bootData.lang[locale] ?? bootData.lang.en;
const bootPayload = {
  locale,
  mode,
  data: bootData,
};

const modeMainClass = "hero-bg grid min-h-[100svh] place-items-center px-6 pb-8 pt-28";
const modeCardClass = "border-glow w-full max-w-[920px] rounded-xl bg-[rgba(15,12,26,.94)] px-6 py-8 text-center sm:p-10 lg:p-14";
const modeTitleClass = "mx-auto my-4 max-w-[760px] font-pixel text-[clamp(1.4rem,3vw,2.3rem)] leading-[1.55] text-white";
const modeDescriptionClass = "mx-auto mb-6 max-w-[720px] text-[clamp(1.05rem,1.7vw,1.28rem)] leading-[1.7] text-[rgba(226,217,243,.74)]";
const routeStatusClass = "mx-auto my-6 grid max-w-[560px] gap-2 rounded-lg border border-[rgba(34,211,238,.22)] bg-[rgba(34,211,238,.07)] p-4 text-white";
const routeStatusLabelClass = "text-[.9rem] font-bold uppercase tracking-[.04em] text-[var(--cyan)]";
const backLinkClass = "font-bold text-[var(--cyan)] no-underline";
const modeKickerClass = "section-label text-[var(--cyan)]";

const archiveStatusCopy = {
  archive: locale === "fr" ? "Disponible" : "Available",
  today: locale === "fr" ? "Quotidien" : "Daily",
  future: locale === "fr" ? "À venir" : "Upcoming",
  unavailable: locale === "fr" ? "Indisponible" : "Unavailable",
  empty: "",
} as const;

const archiveKindCopy = {
  archive: locale === "fr" ? "Archive" : "Archive",
  today: locale === "fr" ? "Quotidien" : "Daily",
  future: locale === "fr" ? "À venir" : "Upcoming",
  unavailable: locale === "fr" ? "Indisponible" : "Unavailable",
  empty: "",
} as const;

const formatArchiveShortDate = (dateKey: string) =>
  new Intl.DateTimeFormat(locale, {
    day: "numeric",
    month: "short",
  }).format(new Date(`${dateKey}T12:00:00`));

const getArchiveCellTitle = (dateKey: string, tone: string) => {
  if (tone === "today") return locale === "fr" ? "Quotidien du jour" : "Today's daily";
  if (tone === "archive") {
    return locale === "fr" ? `Archive du ${formatArchiveShortDate(dateKey)}` : `${formatArchiveShortDate(dateKey)} archive`;
  }
  return formatArchiveShortDate(dateKey);
};

const noAttemptLabel = locale === "fr" ? "Aucune tentative" : "No attempt";
const defaultScoreLabel = locale === "fr" ? "0 pt" : "0 pts";
---
<PublicLayout
  locale={locale}
  title={`${copy.title[locale]} — ManabuPlay`}
  description={copy.description[locale]}
  ogTitle={`${copy.title[locale]} — ManabuPlay`}
  ogDescription={copy.description[locale]}
  activeMode={mode}
  bootPayload={bootPayload}
  includeQuizRuntime={isQuizMode}
>
  {isDailyMode ? (
    <main class={modeMainClass}>
      <article class={modeCardClass}>
        <a class={backLinkClass} href={getLocalizedHomePath(locale)}>{lang.footer_quiz}</a>
        <p class={modeKickerClass}>{copy.kicker[locale]}</p>
        <h1 class:list={[modeTitleClass, "glow-fuchsia"]}>{copy.title[locale]}</h1>
        <p class={modeDescriptionClass}>{copy.description[locale]}</p>
        <div class={routeStatusClass}>
          <strong class={routeStatusLabelClass}>{copy.status[locale]}</strong>
          <span class={routeStatusLabelClass}>{locale === "fr" ? "10 questions seedées par date locale." : "10 questions seeded from the local date."}</span>
        </div>
        <a class="cta-btn hero-cta inline-flex items-center justify-center" href="#quiz" data-quiz-action="launchQuiz">
          {lang.hero_cta}
        </a>
      </article>
      <PublicQuiz />
    </main>
  ) : isPracticeMode ? (
    <main class={modeMainClass}>
      <article class={modeCardClass}>
        <a class={backLinkClass} href={getLocalizedHomePath(locale)}>{lang.footer_quiz}</a>
        <p class={modeKickerClass}>{copy.kicker[locale]}</p>
        <h1 class:list={[modeTitleClass, "glow-fuchsia"]}>{copy.title[locale]}</h1>
        <p class={modeDescriptionClass}>{copy.description[locale]}</p>
        <div class={routeStatusClass}>
          <strong class={routeStatusLabelClass}>{copy.status[locale]}</strong>
          <span class={routeStatusLabelClass}>
            {locale === "fr"
              ? "4 difficultés, 10 questions, cooldown de 2 sessions."
              : "4 difficulties, 10 questions, 2-session cooldown."}
          </span>
        </div>
        <a class="cta-btn hero-cta inline-flex items-center justify-center" href="#quiz">
          {lang.hero_cta}
        </a>
      </article>
      <PublicQuiz />
    </main>
  ) : isArchivesMode ? (
    <main class={modeMainClass}>
      <article class={modeCardClass}>
        <a class={backLinkClass} href={getLocalizedHomePath(locale)}>{lang.footer_quiz}</a>
        <p class={modeKickerClass}>{copy.kicker[locale]}</p>
        <h1 class:list={[modeTitleClass, "glow-fuchsia"]}>{copy.title[locale]}</h1>
        <p class={modeDescriptionClass}>{copy.description[locale]}</p>
        <div class={routeStatusClass}>
          <strong class={routeStatusLabelClass}>{copy.status[locale]}</strong>
          <span
            class={routeStatusLabelClass}
            id="archiveSelectedLabel"
            data-default-date={latestArchiveDate ?? ""}
            data-prefix-fr="Archive sélectionnée"
            data-prefix-en="Selected archive"
          >
            {locale === "fr"
              ? `Archive sélectionnée : ${latestArchiveDate}`
              : `Selected archive: ${latestArchiveDate}`}
          </span>
        </div>
        <a class="cta-btn hero-cta inline-flex items-center justify-center" href="#quiz" data-quiz-action="launchQuiz">
          {locale === "fr" ? "Jouer cette archive" : "Play this archive"}
        </a>
      </article>

      <section class="archive-calendar-shell" id="archives-list" data-default-date={latestArchiveDate ?? ""}>
        <div class="archive-calendar-intro">
          <p class="section-label text-[var(--violet)]">
            {locale === "fr" ? "ARCHIVES DISPONIBLES" : "AVAILABLE ARCHIVES"}
          </p>
          <p class={modeDescriptionClass}>
            {locale === "fr"
              ? "Chaque mois regroupe les quotidiens passés. Les archives sont rejouables, avec score max et tentatives."
              : "Each month groups past dailies. Archives are replayable, with best score and attempts."}
          </p>
        </div>

        <div class="archive-month-list">
          {archiveMonthGroups.map((month) => (
            <details
              class="archive-month-drawer"
              open={month.open ? true : undefined}
              data-archive-month={month.key}
            >
              <summary class="archive-month-summary">
                <span>{month.label}</span>
                <strong data-archive-month-summary>{month.summary}</strong>
              </summary>

              <div class="archive-calendar-weekdays" aria-hidden="true">
                {month.weekdays.map((weekday) => <span>{weekday}</span>)}
              </div>

              <div class="archive-calendar-grid">
                {month.cells.map((cell) =>
                  cell.tone === "empty" ? (
                    <span class="archive-calendar-cell archive-calendar-cell--empty" aria-hidden="true"></span>
                  ) : cell.disabled ? (
                    <span
                      class:list={[
                        "archive-calendar-cell",
                        `archive-calendar-cell--${cell.tone}`,
                        cell.isSelected && "is-active",
                      ]}
                      data-archive-date={cell.dateKey}
                      data-archive-tone={cell.tone}
                      aria-disabled="true"
                    >
                      <span class="archive-calendar-cell-top">
                        <strong>{cell.day}</strong>
                        <small>{archiveKindCopy[cell.tone]}</small>
                      </span>
                      <span class="archive-calendar-cell-title">
                        {getArchiveCellTitle(cell.dateKey!, cell.tone)}
                      </span>
                      <span class="archive-calendar-status" data-archive-status>
                        {archiveStatusCopy[cell.tone]}
                      </span>
                    </span>
                  ) : (
                    <a
                      class:list={[
                        "archive-calendar-cell",
                        `archive-calendar-cell--${cell.tone}`,
                        cell.isSelected && "is-active",
                      ]}
                      href={cell.href}
                      data-archive-date={cell.dateKey}
                      data-archive-tone={cell.tone}
                      aria-label={getArchiveCellTitle(cell.dateKey!, cell.tone)}
                    >
                      <span class="archive-calendar-cell-top">
                        <strong>{cell.day}</strong>
                        <small>{archiveKindCopy[cell.tone]}</small>
                      </span>
                      <span class="archive-calendar-cell-title">
                        {getArchiveCellTitle(cell.dateKey!, cell.tone)}
                      </span>
                      <span class="archive-calendar-status" data-archive-status>
                        {archiveStatusCopy[cell.tone]}
                      </span>
                      <span class="archive-calendar-cell-meta">
                        <span data-archive-score>{defaultScoreLabel}</span>
                        <span data-archive-attempts>{noAttemptLabel}</span>
                      </span>
                    </a>
                  )
                )}
              </div>
            </details>
          ))}
        </div>
      </section>

      <PublicQuiz />
      <script src="../../scripts/public-archives.ts"></script>
    </main>
  ) : (
    <main class={modeMainClass}>
      <article class={modeCardClass}>
        <a class={backLinkClass} href={getLocalizedHomePath(locale)}>{lang.footer_quiz}</a>
        <p class={modeKickerClass}>{copy.kicker[locale]}</p>
        <h1 class:list={[modeTitleClass, "glow-fuchsia"]}>{copy.title[locale]}</h1>
        <p class={modeDescriptionClass}>{copy.description[locale]}</p>
        <div class={routeStatusClass}>
          <strong class={routeStatusLabelClass}>{copy.status[locale]}</strong>
          <span class={routeStatusLabelClass}>Mode: {mode} · Locale: {locale}</span>
        </div>
        <a class="cta-btn hero-cta inline-flex items-center justify-center" href={getLocalizedHomePath(locale) + "#quiz"}>
          {lang.hero_cta}
        </a>
      </article>
    </main>
  )}
</PublicLayout>
