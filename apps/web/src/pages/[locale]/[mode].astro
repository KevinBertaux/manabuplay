---
import PublicLayout from "../../layouts/PublicLayout.astro";
import PublicFooter from "../../components/PublicFooter.astro";
import PublicQuiz from "../../components/PublicQuiz.astro";
import { buildCatalogBootData } from "../../../../../shared/data/manabuplay/catalog";
import {
  buildArchivesBootData,
  getArchiveCalendarCopy,
  getArchiveMonthGroups,
  getLatestArchiveDateKey,
  type ArchiveCalendarTone,
} from "../../../../../shared/lib/manabuplay-archives";
import { buildDailyBootData } from "../../../../../shared/lib/manabuplay-daily";
import { buildPracticeBootData } from "../../../../../shared/lib/manabuplay-practice";
import { normalizePublicLocale } from "../../lib/public-locales";
import {
  PUBLIC_MODE_COPY,
  type PublicModeKey,
  getPublicStaticModePaths,
} from "../../lib/public-routes";

export function getStaticPaths() {
  return getPublicStaticModePaths();
}

const locale = normalizePublicLocale(Astro.params.locale);
const mode = Astro.params.mode as PublicModeKey;
const copy = PUBLIC_MODE_COPY[mode] ?? PUBLIC_MODE_COPY.daily;
const isDailyMode = mode === "daily";
const isArcadeMode = mode === "arcade";
const isArchivesMode = mode === "archives";
const isQuizMode = isDailyMode || isArcadeMode || isArchivesMode;
const latestArchiveDate = isArchivesMode ? getLatestArchiveDateKey() : null;
const archiveMonthGroups = isArchivesMode
  ? getArchiveMonthGroups({ locale, selectedDate: latestArchiveDate })
  : [];
const archiveCalendarCopy = getArchiveCalendarCopy(locale);
const bootData = isDailyMode
  ? buildDailyBootData()
  : isArcadeMode
    ? buildPracticeBootData()
    : isArchivesMode
      ? buildArchivesBootData(latestArchiveDate ?? undefined)
    : buildCatalogBootData();
const bootPayload = {
  locale,
  mode,
  data: bootData,
};

const modeMainClass =
  "hero-bg flex flex-1 flex-col px-6 pb-12 pt-24 sm:pt-28";
const modeCenteredMainClass =
  "public-mode-main hero-bg flex min-h-0 flex-1 flex-col px-6 pb-6 pt-[calc(var(--public-nav-h)+0.75rem)] sm:pb-8";
const modeViewportClass = "public-mode-viewport flex min-h-0 flex-1 flex-col";
const modeSpacerClass = "public-mode-spacer flex-1";
const modeDescriptionClass =
  "mx-auto mb-6 max-w-[720px] text-[clamp(1.05rem,1.7vw,1.28rem)] leading-[1.7] text-[rgba(226,217,243,.74)]";
const archiveSelectedLineClass =
  "mx-auto mb-2 max-w-[720px] text-center text-[.9rem] font-bold uppercase tracking-[.04em] text-[var(--cyan)]";

const formatArchiveShortDate = (dateKey: string) =>
  new Intl.DateTimeFormat(locale, {
    day: "numeric",
    month: "short",
  }).format(new Date(`${dateKey}T12:00:00`));

const formatArchiveLongDate = (dateKey: string) =>
  new Intl.DateTimeFormat(locale === "fr" ? "fr-FR" : "en-US", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(new Date(`${dateKey}T12:00:00`));

const getArchiveCellTitle = (dateKey: string, tone: string) => {
  if (tone === "today") return locale === "fr" ? "Quiz du jour" : "Today's quiz";
  if (tone === "archive") {
    return locale === "fr" ? `Rejouer le ${formatArchiveShortDate(dateKey)}` : `Replay ${formatArchiveShortDate(dateKey)}`;
  }
  return formatArchiveShortDate(dateKey);
};

type VisibleArchiveTone = Exclude<ArchiveCalendarTone, "empty">;
const getArchiveKindCopy = (tone: ArchiveCalendarTone) =>
  tone === "empty" ? "" : archiveCalendarCopy.kind[tone as VisibleArchiveTone];

const noAttemptLabel = archiveCalendarCopy.noAttemptLabel;
const defaultScoreLabel = archiveCalendarCopy.defaultScoreLabel;
---
<PublicLayout
  locale={locale}
  title={`${copy.title[locale]} — ManabuPlay`}
  description={copy.description[locale]}
  ogTitle={`${copy.title[locale]} — ManabuPlay`}
  ogDescription={copy.description[locale]}
  activeMode={mode}
  bootPayload={bootPayload}
  includeQuizRuntime={isQuizMode}
>
  {isDailyMode ? (
    <main class={modeCenteredMainClass}>
      <div class={modeViewportClass}>
        <div class={modeSpacerClass} aria-hidden="true"></div>
        <PublicQuiz />
        <div class={modeSpacerClass} aria-hidden="true"></div>
      </div>
    </main>
  ) : isArcadeMode ? (
    <main class={modeCenteredMainClass}>
      <div class={modeViewportClass}>
        <div class={modeSpacerClass} aria-hidden="true"></div>
        <PublicQuiz />
        <div class={modeSpacerClass} aria-hidden="true"></div>
      </div>
    </main>
  ) : isArchivesMode ? (
    <main class={modeMainClass}>
      <section
        class="archive-calendar-shell mx-auto w-full"
        id="archives-list"
        data-default-date={latestArchiveDate ?? ""}
        data-selected-prefix={archiveCalendarCopy.selectedPrefix}
        data-score-best-suffix={archiveCalendarCopy.scoreBestSuffix}
        data-attempt-singular={archiveCalendarCopy.attemptSingular}
        data-attempt-plural={archiveCalendarCopy.attemptPlural}
        data-summary-played={archiveCalendarCopy.summaryPlayed}
        data-summary-remaining={archiveCalendarCopy.summaryRemaining}
        data-play-action={archiveCalendarCopy.playAction}
        data-replay-action={archiveCalendarCopy.replayAction}
      >
        <div class="archive-calendar-intro">
          <p class="section-label text-[var(--violet)]">
            {archiveCalendarCopy.sectionLabel}
          </p>
          <p
            class={archiveSelectedLineClass}
            id="archiveSelectedLabel"
            data-default-date={latestArchiveDate ?? ""}
          >
            {`${archiveCalendarCopy.selectedPrefix} : ${latestArchiveDate}`}
          </p>
          <p class={modeDescriptionClass}>
            {archiveCalendarCopy.intro}
          </p>
        </div>

        <div class="archive-month-list">
          {archiveMonthGroups.map((month) => (
            <details
              class="archive-month-drawer"
              open={month.open ? true : undefined}
              data-archive-month={month.key}
            >
              <summary class="archive-month-summary">
                <span>{month.label}</span>
                <strong data-archive-month-summary>{month.summary}</strong>
              </summary>

              <div class="archive-calendar-weekdays" aria-hidden="true">
                {month.weekdays.map((weekday) => <span>{weekday}</span>)}
              </div>

              <div class="archive-calendar-grid">
                {month.cells.map((cell) =>
                  cell.tone === "empty" ? (
                    <span class="archive-calendar-cell archive-calendar-cell--empty" aria-hidden="true"></span>
                  ) : cell.tone === "today" ? (
                    <div
                      class="archive-calendar-cell archive-calendar-cell--today"
                      data-archive-date={cell.dateKey}
                      data-archive-tone={cell.tone}
                    >
                      <span class="archive-calendar-cell-top">
                        <strong>{cell.day}</strong>
                        {getArchiveKindCopy(cell.tone) && <small>{getArchiveKindCopy(cell.tone)}</small>}
                      </span>
                      <span class="archive-calendar-cell-date">
                        {formatArchiveLongDate(cell.dateKey!)}
                      </span>
                      <span class="archive-calendar-cell-title">
                        {getArchiveCellTitle(cell.dateKey!, cell.tone)}
                      </span>
                      <a
                        class="archive-calendar-daily-link"
                        href={cell.dailyHref ?? `/${locale}/daily/`}
                        data-archive-daily-link
                      >
                        {archiveCalendarCopy.goToDaily}
                      </a>
                    </div>
                  ) : cell.disabled ? (
                    <span
                      class:list={[
                        "archive-calendar-cell",
                        `archive-calendar-cell--${cell.tone}`,
                        cell.isSelected && "is-active",
                      ]}
                      data-archive-date={cell.dateKey}
                      data-archive-tone={cell.tone}
                      aria-disabled="true"
                    >
                      <span class="archive-calendar-cell-top">
                        <strong>{cell.day}</strong>
                        {getArchiveKindCopy(cell.tone) && <small>{getArchiveKindCopy(cell.tone)}</small>}
                      </span>
                      <span class="archive-calendar-cell-title">
                        {getArchiveCellTitle(cell.dateKey!, cell.tone)}
                      </span>
                    </span>
                  ) : (
                    <a
                      class:list={[
                        "archive-calendar-cell",
                        `archive-calendar-cell--${cell.tone}`,
                        cell.isSelected && "is-active",
                      ]}
                      href={cell.href}
                      data-archive-date={cell.dateKey}
                      data-archive-tone={cell.tone}
                      aria-label={getArchiveCellTitle(cell.dateKey!, cell.tone)}
                    >
                      <span class="archive-calendar-cell-top">
                        <strong>{cell.day}</strong>
                        <span
                          class="archive-calendar-medal"
                          data-archive-medal
                          hidden
                          aria-label={locale === "fr" ? "Déjà joué" : "Played"}
                          title={locale === "fr" ? "Déjà joué" : "Played"}
                        >
                          ★
                        </span>
                      </span>
                      <span class="archive-calendar-cell-title">
                        {getArchiveCellTitle(cell.dateKey!, cell.tone)}
                      </span>
                      <span class="archive-calendar-cell-meta">
                        <span data-archive-score>{defaultScoreLabel}</span>
                        <span data-archive-attempts>{noAttemptLabel}</span>
                      </span>
                      <span class="archive-calendar-action" data-archive-action>
                        {archiveCalendarCopy.playAction}
                      </span>
                    </a>
                  )
                )}
              </div>
            </details>
          ))}
        </div>
      </section>

      <div class="mx-auto mt-10 w-full max-w-[980px] flex-1">
        <PublicQuiz />
      </div>
      <script src="../../scripts/public-archives.ts"></script>
    </main>
  ) : (
    <main class={modeMainClass}>
      <p class={`${modeDescriptionClass} text-center`}>
        Mode: {mode} · Locale: {locale}
      </p>
    </main>
  )}
  <PublicFooter locale={locale} />
</PublicLayout>
