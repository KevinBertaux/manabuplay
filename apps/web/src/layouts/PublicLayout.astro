---
import "../styles/public.css";
import {
  PUBLIC_LOCALES,
  PUBLIC_LOCALE_LABELS,
  type PublicLocale,
} from "../lib/public-locales";
import {
  PUBLIC_MODE_COPY,
  PUBLIC_MODE_KEYS,
  type PublicModeKey,
  getLocalizedHomePath,
  getLocalizedModePath,
} from "../lib/public-routes";

interface Props {
  locale: PublicLocale;
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  activeMode?: PublicModeKey;
  bootPayload?: unknown;
  includeQuizRuntime?: boolean;
}

const {
  locale,
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  activeMode,
  bootPayload,
  includeQuizRuntime = false,
} = Astro.props;

const encodedBootPayload = bootPayload
  ? Buffer.from(JSON.stringify(bootPayload), "utf8").toString("base64")
  : "";

function getLocaleHref(targetLocale: PublicLocale) {
  return activeMode ? getLocalizedModePath(targetLocale, activeMode) : getLocalizedHomePath(targetLocale);
}

const topNavClass = "fixed inset-x-0 top-0 z-50 grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-4 border-b border-[rgba(139,92,246,.15)] bg-[rgba(10,9,17,.85)] px-6 py-2 backdrop-blur-[16px] max-[760px]:grid-cols-[1fr_auto] max-[760px]:gap-2 max-[760px]:px-3";
const brandLinkClass = "flex min-w-0 items-center gap-3 no-underline";
const navGroupClass = "flex min-w-0 items-center justify-center gap-2 max-[760px]:col-span-full max-[760px]:justify-start max-[760px]:overflow-x-auto max-[760px]:pb-[2px]";
const navLinkBaseClass = "whitespace-nowrap rounded-lg border bg-[rgba(26,22,48,.34)] px-3 py-2 font-body text-[.98rem] font-bold text-[rgba(226,217,243,.72)] transition-[color,border-color,background] duration-150";
const navLinkInactiveClass = "border-[rgba(139,92,246,.14)] hover:border-[rgba(34,211,238,.38)] hover:bg-[rgba(34,211,238,.08)] hover:text-white";
const navLinkActiveClass = "border-[rgba(34,211,238,.38)] bg-[rgba(34,211,238,.08)] text-white";
const localeSwitchClass = "flex items-center gap-1 rounded-md border border-[rgba(139,92,246,.15)] bg-[rgba(26,22,48,.8)] px-2 py-1 text-[rgba(139,92,246,.25)]";
const brandIconClass =
  "flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-md bg-[linear-gradient(135deg,var(--violet),var(--fuchsia))] text-white";
const brandWordmarkClass = "glow-violet font-pixel text-[.94rem] text-[#a78bfa]";
---
<!DOCTYPE html>
<html lang={locale} id="htmlRoot">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="Japanese gaming vocabulary, learn Japanese, anime words, JRPG quiz, gaming language" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#0a0911" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
</head>
<body class="text-slate-200">
  <nav class={topNavClass}>
    <a class={brandLinkClass} href={getLocalizedHomePath(locale)} aria-label="ManabuPlay">
      <span class={brandIconClass}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
        </svg>
      </span>
      <span class={brandWordmarkClass}>
        Manabu<span class="text-[#e879f9]">Play</span>
      </span>
    </a>
    <div class={navGroupClass} aria-label="Product navigation">
      {PUBLIC_MODE_KEYS.map((modeKey) => (
        <a
          href={getLocalizedModePath(locale, modeKey)}
          data-public-route={modeKey}
          aria-current={modeKey === activeMode ? "page" : undefined}
          class:list={[
            navLinkBaseClass,
            modeKey === activeMode ? navLinkActiveClass : navLinkInactiveClass,
            { "max-[760px]:text-[.9rem]": true },
          ]}
        >
          {PUBLIC_MODE_COPY[modeKey].navLabel[locale]}
        </a>
      ))}
    </div>
    <div class={`${localeSwitchClass} public-locale-switch`}>
      {PUBLIC_LOCALES.map((targetLocale, index) => (
        <>
          {index > 0 && <span>|</span>}
          <a
            id={`btn${PUBLIC_LOCALE_LABELS[targetLocale]}`}
            class:list={["lang-btn", { active: locale === targetLocale }]}
            data-locale-home={targetLocale}
            href={getLocaleHref(targetLocale)}
          >
            {PUBLIC_LOCALE_LABELS[targetLocale]}
          </a>
        </>
      ))}
    </div>
  </nav>

  <slot />

  {bootPayload && (
    <>
      <template id="manabuplay-boot" data-payload={encodedBootPayload}></template>
      <script src="../scripts/public-boot.ts"></script>
    </>
  )}
  {includeQuizRuntime && (
    <script src="../scripts/quiz-app.ts"></script>
  )}
</body>
</html>
