---
import { CURRENT_PRODUCT_COPY } from "../../../../shared/data/manabuplay/product-copy";
import type { PublicLocale } from "../lib/public-locales";
import { getLocalizedHomePath, getLocalizedLegalPath } from "../lib/public-routes";

interface Props {
  locale: PublicLocale;
  /** Preview interne : afficher le lien cookies sans Clarity prod. */
  forceCookiePreferences?: boolean;
}

const { locale, forceCookiePreferences = false } = Astro.props;
const copy = CURRENT_PRODUCT_COPY[locale];
const homePath = getLocalizedHomePath(locale);
const year = new Date().getFullYear();
const clarityProjectId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID?.trim() ?? "";
const showCookiePreferences = forceCookiePreferences || Boolean(clarityProjectId);
const linkClass =
  "font-body text-sm text-slate-600 no-underline transition-colors hover:text-slate-400";
const cookieButtonClass = `${linkClass} public-site-footer-cookie-btn cursor-pointer`;
---

<footer class="public-site-footer border-t border-[rgba(139,92,246,.15)] px-6">
  <div class="public-site-footer-inner public-shell-inner">
    <div class="public-site-footer-zone public-site-footer-zone--brand">
      <a href={homePath} class="public-site-footer-brand-link no-underline">
        <span class="glow-violet font-pixel text-[.78rem] text-[#a78bfa]">
          Manabu<span class="text-[#e879f9]">Play</span>
        </span>
      </a>
      <p class="public-site-footer-agency m-0 font-body text-sm text-slate-500">{copy.footer_agency}</p>
    </div>

    <p class="public-site-footer-zone public-site-footer-zone--tagline m-0 font-body text-sm text-slate-500">
      {copy.footer_tagline}
    </p>

    <div class="public-site-footer-zone public-site-footer-zone--legal">
      <nav
        class="public-site-footer-nav flex flex-wrap items-center gap-x-4 gap-y-1"
        aria-label={locale === "fr" ? "Informations légales" : "Legal information"}
      >
        <a href={getLocalizedLegalPath(locale, "legal")} class={linkClass}>{copy.footer_legal}</a>
        <a href={getLocalizedLegalPath(locale, "privacy")} class={linkClass}>{copy.footer_privacy}</a>
        {showCookiePreferences ? (
          <button
            type="button"
            class={cookieButtonClass}
            data-open-analytics-consent
          >
            {copy.footer_cookies}
          </button>
        ) : null}
      </nav>
      <p class="public-site-footer-copy m-0 mt-2 font-body text-xs text-slate-600">
        © {year} ManabuPlay
      </p>
    </div>
  </div>
</footer>
