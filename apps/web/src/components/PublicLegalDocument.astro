---
import type { LegalDocument } from "../../../../shared/data/manabuplay/legal-copy";
import { getLocalizedHomePath, getLocalizedLegalPath } from "../lib/public-routes";
import type { PublicLocale } from "../lib/public-locales";

interface Props {
  locale: PublicLocale;
  document: LegalDocument;
  activeDocument: "legal" | "privacy";
}

const { locale, document, activeDocument } = Astro.props;
const homePath = getLocalizedHomePath(locale);
const privacyPath = getLocalizedLegalPath(locale, "privacy");
const privacyLinkClass =
  "font-semibold text-[var(--cyan)] underline underline-offset-2 transition-colors hover:text-white";

const PERSONAL_DATA_HEADING = { fr: "Données personnelles", en: "Personal data" } as const;
const PRIVACY_PHRASE = { fr: "politique de confidentialité", en: "Privacy Policy" } as const;

type LegalSection = LegalDocument["sections"][number];

function splitPrivacyPhrase(section: LegalSection, paragraph: string) {
  if (activeDocument !== "legal" || section.heading !== PERSONAL_DATA_HEADING[locale]) {
    return null;
  }
  const phrase = PRIVACY_PHRASE[locale];
  const index = paragraph.indexOf(phrase);
  if (index === -1) {
    return null;
  }
  return {
    before: paragraph.slice(0, index),
    after: paragraph.slice(index + phrase.length),
    phrase,
  };
}
---

<main class="public-legal-page mx-auto max-w-3xl px-6 pb-16 pt-28">
  <a class="public-legal-back font-body text-sm font-semibold text-slate-500 no-underline hover:text-[var(--cyan)]" href={homePath}>
    <span aria-hidden="true">←</span>
    {document.backLabel}
  </a>

  <header class="public-legal-header mt-6">
    <p class="section-label mb-3 text-[var(--fuchsia)]">// LEGAL</p>
    <h1 class="pixel-heading-md text-white">{document.title}</h1>
    <p class="mt-3 font-body text-sm text-slate-500">
      {locale === "fr" ? "Dernière mise à jour : " : "Last updated: "}
      <time datetime="2026-05-20">{document.updatedAt}</time>
    </p>
  </header>

  <div class="public-legal-body mt-10 space-y-8">
    {document.sections.map((section) => (
      <section class="public-legal-section">
        <h2 class="font-body text-lg font-bold text-slate-200">{section.heading}</h2>
        <div class="mt-3 space-y-3">
          {section.paragraphs.map((paragraph) => {
            const privacyParts = splitPrivacyPhrase(section, paragraph);
            return (
              <p class="font-body text-base leading-relaxed text-slate-400">
                {privacyParts ? (
                  <>
                    {privacyParts.before}
                    <a href={privacyPath} class={privacyLinkClass}>
                      {privacyParts.phrase}
                    </a>
                    {privacyParts.after}
                  </>
                ) : (
                  paragraph
                )}
              </p>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</main>
