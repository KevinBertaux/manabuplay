  <!-- ══ QUIZ SECTION ══ -->
  <section id="quiz" class="public-quiz-section">
    <div class="quiz-section-glow"></div>
    <div class="public-quiz-container">

      <div class="border-glow quiz-shell reveal">
        <!-- ══ DIFFICULTY PICKER ══ -->
        <div id="diffArea">
          <p id="diffPickerTitle" class="quiz-picker-title section-label quiz-label-fuchsia" data-i18n="diff_title"></p>
          <section
            id="quizTitleScreen"
            hidden
            class="quiz-pre-launch"
            aria-label="Quiz start screen"
            data-aria-label-en="Quiz start screen"
            data-aria-label-fr="Écran de lancement du quiz"
          >
            <div class="quiz-pre-launch-inner">
              <strong class="quiz-title-headline" id="quizTitleHeadline"></strong>
              <p class="quiz-title-copy" id="quizTitleCopy">
                <span class="quiz-title-copy-text" id="quizTitleCopyText"></span>
                <span class="quiz-title-copy-score" id="quizTitleCopyScore" hidden></span>
                <span class="quiz-title-copy-return" id="quizTitleCopyReturn" hidden></span>
              </p>
              <div class="quiz-title-share-row" id="quizTitleShareRow" hidden>
                <button class="share-btn share-btn-x" data-quiz-action="shareOnX" type="button">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.912-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                  <span data-i18n="result_share_x"></span>
                </button>
                <button class="share-btn share-btn-copy" data-quiz-action="copyShareLink" type="button">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="10" y="10" width="12" height="12" rx="2"/><path d="M6 16H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v2"/>
                  </svg>
                  <span data-share-copy-label data-i18n="result_share_copy"></span>
                </button>
              </div>
              <div class="quiz-start-row quiz-title-action" id="singleRunStartSlot"></div>
            </div>
          </section>
          <div class="quiz-diff-grid" id="diffGrid">
            <!-- injected by JS -->
          </div>
          <div class="quiz-start-row" id="defaultStartSlot">
            <button class="start-btn" id="startBtn" data-quiz-action="launchQuiz" data-i18n="quiz_play"></button>
          </div>
        </div>

        <!-- ══ COMMAND HUD ══ -->
        <div id="progressRow" hidden class="quiz-progress-row">
          <span class="quiz-progress-text" id="progressText">0/10</span>
          <progress class="progress-bar quiz-progress" id="progressBar" value="0" max="10"></progress>
        </div>

        <div id="hudRow" hidden class="quiz-hud">
          <div class="quiz-hud-stat">
            <span class="quiz-hud-label" data-i18n="hud_score"></span>
            <span class="quiz-score-value quiz-hud-value" id="scoreDisplay">0</span>
          </div>
          <span class="quiz-streak-value quiz-streak" id="streakDisplay"></span>
          <div class="quiz-hud-stat">
            <span class="quiz-hud-label" data-i18n="hud_level"></span>
            <span class="quiz-hud-value quiz-level-value" id="levelDisplay">I</span>
          </div>
        </div>

        <!-- ══ QUIZ AREA ══ -->
        <div id="quizArea" hidden class="quiz-area">
          <section class="quiz-word-panel">
            <div class="quiz-word-romaji" id="wordRomaji"></div>
            <div class="quiz-word-forms">
              <span id="wordKana" class="quiz-word-kana"></span>
              <span class="quiz-word-kanji" id="wordDisplay"></span>
            </div>
          </section>

          <section class="quiz-play-panel">
            <div class="quiz-prompt-head">
              <p class="quiz-prompt-title" data-i18n="quiz_prompt_title"></p>
              <div
                id="hintChips"
                class="quiz-hint-chips"
                hidden
                role="group"
                data-aria-label-en="Hints"
                data-aria-label-fr="Indices"
              >
                <button
                  type="button"
                  class="quiz-hint-chip"
                  id="hintChip1"
                  data-quiz-action="revealHint"
                  data-hint-stage="1"
                  aria-pressed="false"
                >
                  <span class="quiz-hint-chip-icon" aria-hidden="true">💡</span>
                  <span class="quiz-hint-chip-num">1</span>
                  <span class="quiz-hint-chip-cost" data-i18n="hint_cost_one"></span>
                </button>
                <button
                  type="button"
                  class="quiz-hint-chip is-locked"
                  id="hintChip2"
                  data-quiz-action="revealHint"
                  data-hint-stage="2"
                  disabled
                  hidden
                  aria-pressed="false"
                >
                  <span class="quiz-hint-chip-icon" aria-hidden="true">💡</span>
                  <span class="quiz-hint-chip-num">2</span>
                  <span class="quiz-hint-chip-cost" data-i18n="hint_cost_two"></span>
                </button>
              </div>
            </div>

            <p class="quiz-feedback quiz-feedback-copy" id="feedback" hidden></p>

            <div id="hintReveals" class="quiz-hint-reveals">
              <div id="hintReveal1" class="quiz-hint-reveal" hidden>
                <span class="quiz-hint-label" data-i18n="hint_label_one"></span>
                <p class="quiz-hint-copy" id="hintContent"></p>
              </div>
              <div id="hintReveal2" class="quiz-hint-reveal" hidden>
                <span class="quiz-hint-label" data-i18n="hint_label_two"></span>
                <p class="quiz-hint-copy" id="hint2Content"></p>
              </div>
            </div>

            <div class="quiz-answer-grid" id="answersGrid"></div>

            <div id="explanationBox" hidden class="quiz-explanation-card">
              <span class="quiz-explanation-label" data-i18n="explanation_label"></span>
              <p class="quiz-explanation-copy" id="explanationContent"></p>
            </div>

            <div class="quiz-next-row">
              <button id="nextBtn" class="quiz-next-btn" data-quiz-action="nextQuestion">…</button>
            </div>
          </section>
        </div>

        <!-- ══ RESULTS ══ -->
        <div id="resultsArea" hidden class="quiz-results">
          <div class="quiz-final-emoji score-pop" id="finalEmoji">🏆</div>
          <h3 class="quiz-final-title pixel-heading-sm" id="finalTitle"></h3>
          <p class="quiz-final-message" id="finalMsg"></p>
          <!-- New record badge (conditionally shown) -->
          <div id="newRecordBadge" hidden class="quiz-record-badge-wrap">
            <span class="new-record-badge" data-i18n="result_newrecord"></span>
          </div>
          <div class="quiz-result-stats">
            <div>
              <div class="quiz-result-value glow-violet quiz-score-value" id="finalScore"></div>
              <div class="quiz-result-label result-label" data-i18n="result_score"></div>
            </div>
            <div class="quiz-result-divider"></div>
            <div>
              <div class="quiz-result-value quiz-cyan-value" id="finalBaseScore"></div>
              <div class="quiz-result-label result-label" id="finalBaseScoreLabel"></div>
            </div>
            <div class="quiz-result-divider"></div>
            <div>
              <div class="quiz-result-value quiz-streak-value" id="finalComboMultiplier"></div>
              <div class="quiz-result-label result-label" id="finalComboLabel"></div>
            </div>
            <div class="quiz-result-divider"></div>
            <div>
              <div class="quiz-result-value quiz-correct-value" id="finalCorrect"></div>
              <div class="quiz-result-label result-label" data-i18n="result_correct"></div>
            </div>
            <div class="quiz-result-divider"></div>
            <div>
              <div class="quiz-result-value quiz-streak-value" id="finalPercent"></div>
              <div class="quiz-result-label result-label" data-i18n="result_acc"></div>
            </div>
            <div class="quiz-result-divider"></div>
            <div>
              <div class="quiz-result-value quiz-cyan-value" id="finalStreak"></div>
              <div class="quiz-result-label result-label" data-i18n="result_streak"></div>
            </div>
          </div>
          <!-- Best score display -->
          <p class="quiz-best-score-message" id="bestScoreMsg"></p>
          <div class="quiz-result-actions">
            <button class="cta-btn" data-quiz-action="replayDifficulty" data-i18n="result_replay"></button>
            <button class="cta-btn quiz-secondary-cta" data-quiz-action="goToDiffPicker" data-i18n="result_change_diff"></button>
          </div>

          <!-- Share row -->
          <div class="quiz-share-row" id="shareRow">
            <p class="quiz-share-copy" data-i18n="result_share"></p>
            <div class="quiz-share-actions">
              <!-- X / Twitter -->
              <button class="share-btn share-btn-x" data-quiz-action="shareOnX" id="shareBtnX">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.912-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
                <span data-i18n="result_share_x"></span>
              </button>
              <!-- Copy link -->
              <button class="share-btn share-btn-copy" data-quiz-action="copyShareLink" id="shareBtnCopy">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="10" y="10" width="12" height="12" rx="2"/><path d="M6 16H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v2"/>
                </svg>
                <span id="copyBtnLabel" data-share-copy-label data-i18n="result_share_copy"></span>
              </button>
            </div>
          </div>
        </div>

      </div><!-- /card -->
    </div>
  </section>
