  <!-- ══ QUIZ SECTION ══ -->
  <section id="quiz" class="py-14 px-6 relative overflow-hidden">
    <div class="quiz-section-glow absolute inset-0"></div>
    <div class="max-w-2xl mx-auto relative z-10">

      <div class="text-center mb-8 reveal">
        <p class="section-label quiz-label-violet" data-i18n="quiz_label"></p>
        <h2 class="pixel-heading-md mt-4 text-white" data-i18n="quiz_title"></h2>
        <p class="font-body text-xl text-slate-400 mt-4" data-i18n="quiz_sub"></p>
      </div>

      <div class="border-glow quiz-shell rounded-xl p-6 sm:p-8 reveal">

        <!-- ══ DIFFICULTY PICKER ══ -->
        <div id="diffArea">
          <p class="section-label quiz-label-fuchsia text-center mb-6" data-i18n="diff_title"></p>
          <div class="grid grid-cols-2 gap-4 mb-6" id="diffGrid">
            <!-- injected by JS -->
          </div>
          <div class="text-center">
            <button class="start-btn" id="startBtn" onclick="launchQuiz()" data-i18n="diff_start"></button>
          </div>
        </div>

        <!-- ══ PROGRESS ══ -->
        <div id="progressRow" hidden class="flex items-center gap-3 mb-6">
          <div class="quiz-progress-track flex-1 h-1 rounded-full">
            <div class="progress-bar" id="progressBar"></div>
          </div>
          <span class="progress-text text-slate-400" id="progressText">0/10</span>
        </div>

        <!-- ══ HUD ══ -->
        <div id="hudRow" hidden class="flex justify-between items-center mb-6">
          <div class="flex items-center gap-2">
            <span class="hud-label text-slate-500" data-i18n="hud_score"></span>
            <span class="font-pixel text-base quiz-score-value" id="scoreDisplay">0</span>
          </div>
          <span class="font-pixel text-sm quiz-streak-value" id="streakDisplay"></span>
          <div class="flex items-center gap-2">
            <span class="hud-label text-slate-500" data-i18n="hud_level"></span>
            <span class="font-pixel text-base text-white" id="levelDisplay">I</span>
          </div>
        </div>

        <!-- ══ QUIZ AREA ══ -->
        <div id="quizArea" hidden>
          <div class="text-center mb-6">
            <div class="quiz-word-category inline-block px-4 py-2 rounded-lg mb-4 border">
              <span class="font-body text-sm tracking-widest uppercase font-700 quiz-word-category-text" id="wordCategory"></span>
            </div>
            <div id="wordKana" class="word-assist"></div>
            <div class="font-pixel text-4xl sm:text-5xl glow-fuchsia quiz-word-display" id="wordDisplay"></div>
          </div>

          <div class="text-center mb-6" id="hintZone">
            <button class="hint-reveal-btn" id="hintBtn" onclick="revealHint()">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              <span data-i18n="hint_btn"></span>
            </button>
            <div id="hintText" hidden class="mt-3 quiz-learning-stack">
              <div class="quiz-learning-card">
                <span class="quiz-learning-label" data-i18n="hint_label_one"></span>
                <span class="font-body italic quiz-learning-copy" id="hintContent"></span>
              </div>
              <div id="hintTextSecondary" hidden class="quiz-learning-card">
                <span class="quiz-learning-label" data-i18n="hint_label_two"></span>
                <span class="font-body italic quiz-learning-copy" id="hint2Content"></span>
              </div>
            </div>
          </div>

          <p class="font-body text-lg text-slate-400 text-center mb-4" data-i18n="quiz_question"></p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="answersGrid"></div>
          <div id="feedback" hidden class="quiz-feedback mt-5 text-center"></div>
          <div id="explanationBox" hidden class="quiz-explanation mt-4">
            <span class="quiz-learning-label" data-i18n="explanation_label"></span>
            <p class="font-body quiz-explanation-copy" id="explanationContent"></p>
          </div>
          <div class="mt-6 text-center">
            <button id="nextBtn" class="cta-btn opacity-0 pointer-events-none" onclick="nextQuestion()">…</button>
          </div>
        </div>

        <!-- ══ RESULTS ══ -->
        <div id="resultsArea" hidden class="text-center py-4">
          <div class="font-pixel text-5xl mb-5 score-pop" id="finalEmoji">🏆</div>
          <h3 class="pixel-heading-sm mb-3 text-white" id="finalTitle"></h3>
          <p class="font-body text-lg text-slate-400 mb-3" id="finalMsg"></p>
          <!-- New record badge (conditionally shown) -->
          <div id="newRecordBadge" hidden class="mb-4">
            <span class="new-record-badge" data-i18n="result_newrecord"></span>
          </div>
          <div class="flex justify-center gap-4 my-6 flex-wrap">
            <div>
              <div class="font-pixel text-xl glow-violet quiz-score-value" id="finalScore"></div>
              <div class="result-label text-slate-500 mt-2" data-i18n="result_score"></div>
            </div>
            <div class="w-px bg-slate-800 hidden sm:block"></div>
            <div>
              <div class="font-pixel text-xl quiz-correct-value" id="finalCorrect"></div>
              <div class="result-label text-slate-500 mt-2" data-i18n="result_correct"></div>
            </div>
            <div class="w-px bg-slate-800 hidden sm:block"></div>
            <div>
              <div class="font-pixel text-xl quiz-streak-value" id="finalPercent"></div>
              <div class="result-label text-slate-500 mt-2" data-i18n="result_acc"></div>
            </div>
            <div class="w-px bg-slate-800 hidden sm:block"></div>
            <div>
              <div class="font-pixel text-xl quiz-cyan-value" id="finalStreak"></div>
              <div class="result-label text-slate-500 mt-2" data-i18n="result_streak"></div>
            </div>
          </div>
          <!-- Best score display -->
          <p class="font-body text-base text-slate-500 mb-6" id="bestScoreMsg"></p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <button class="cta-btn" onclick="replayDifficulty()" data-i18n="result_replay"></button>
            <button class="cta-btn quiz-secondary-cta" onclick="goToDiffPicker()" data-i18n="result_change_diff"></button>
          </div>

          <!-- Share row -->
          <div class="mt-6" id="shareRow">
            <p class="font-body text-sm text-slate-500 mb-3" data-i18n="result_share"></p>
            <div class="flex gap-3 justify-center flex-wrap">
              <!-- X / Twitter -->
              <button class="share-btn share-btn-x" onclick="shareOnX()" id="shareBtnX">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.912-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
                <span data-i18n="result_share_x"></span>
              </button>
              <!-- Copy link -->
              <button class="share-btn share-btn-copy" onclick="copyShareLink()" id="shareBtnCopy">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="10" y="10" width="12" height="12" rx="2"/><path d="M6 16H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v2"/>
                </svg>
                <span id="copyBtnLabel" data-i18n="result_share_copy"></span>
              </button>
            </div>
          </div>
        </div>

      </div><!-- /card -->
    </div>
  </section>
