---
import "../styles/app.css";
import {
  PUBLIC_LOCALES,
  PUBLIC_LOCALE_LABELS,
  type PublicLocale,
} from "../lib/public-locales";
import {
  PUBLIC_MODE_COPY,
  PUBLIC_MODE_KEYS,
  type PublicModeKey,
  getLocalizedHomePath,
  getLocalizedModePath,
} from "../lib/public-routes";

interface Props {
  locale: PublicLocale;
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  activeMode?: PublicModeKey;
  bootDataScript?: string;
  includeQuizRuntime?: boolean;
}

const {
  locale,
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  activeMode,
  bootDataScript,
  includeQuizRuntime = false,
} = Astro.props;

function getLocaleHref(targetLocale: PublicLocale) {
  return activeMode ? getLocalizedModePath(targetLocale, activeMode) : getLocalizedHomePath(targetLocale);
}
---
<!DOCTYPE html>
<html lang={locale} id="htmlRoot">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="Japanese gaming vocabulary, learn Japanese, anime words, JRPG quiz, gaming language" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#0a0911" />
</head>
<body class="text-slate-200">
  <nav class="fixed top-0 inset-x-0 z-50 public-top-nav">
    <a class="flex items-center gap-3 public-brand-link" href={getLocalizedHomePath(locale)} aria-label="ManabuPlay">
      <span class="w-9 h-9 rounded-md flex items-center justify-center text-white flex-shrink-0"
            style="background:linear-gradient(135deg,var(--violet),var(--fuchsia));">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
        </svg>
      </span>
      <span class="glow-violet" style="font-family:'Joystix',sans-serif;font-size:.94rem;color:#a78bfa;">
        Manabu<span style="color:#e879f9;">Play</span>
      </span>
    </a>
    <div class="public-nav-links" aria-label="Product navigation">
      {PUBLIC_MODE_KEYS.map((modeKey) => (
        <a
          href={getLocalizedModePath(locale, modeKey)}
          data-public-route={modeKey}
          aria-current={modeKey === activeMode ? "page" : undefined}
        >
          {PUBLIC_MODE_COPY[modeKey].navLabel[locale]}
        </a>
      ))}
    </div>
    <div class="flex items-center gap-1 px-2 py-1 rounded-md public-locale-switch">
      {PUBLIC_LOCALES.map((targetLocale, index) => (
        <>
          {index > 0 && <span>|</span>}
          <a
            id={`btn${PUBLIC_LOCALE_LABELS[targetLocale]}`}
            class:list={["lang-btn", { active: locale === targetLocale }]}
            data-locale-home={targetLocale}
            href={getLocaleHref(targetLocale)}
          >
            {PUBLIC_LOCALE_LABELS[targetLocale]}
          </a>
        </>
      ))}
    </div>
  </nav>

  <slot />

  {bootDataScript && <script is:inline set:html={bootDataScript}></script>}
  {includeQuizRuntime && <script is:inline src="/scripts/quiz-app.js?v=waitlist-local-1"></script>}
</body>
</html>
