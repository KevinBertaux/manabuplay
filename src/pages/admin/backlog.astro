---
import "../../styles/app.css";
import { ADMIN_NAV_CSS, getAdminNavHtml } from "../../lib/admin-nav";
import { getRoadmapData, getRoadmapLabelMap, getRoadmapVersionSummaries, type RoadmapItem } from "../../lib/admin-roadmap";

const adminNav = getAdminNavHtml("backlog");
const roadmap = getRoadmapData();
const versionSummaries = getRoadmapVersionSummaries();
const labels = getRoadmapLabelMap();

const versionOptions = roadmap.versions;
const defaultVersion =
  versionOptions.find((version) => version.id === roadmap.meta.defaultVersionId) ??
  versionOptions[0];

const statusOptions = [
  { id: "all", label: "Tout" },
  { id: "todo", label: "À faire" },
  { id: "done", label: "Fait" },
];

const sortOptions = [
  { id: "roadmap", label: "Ordre roadmap" },
  { id: "status", label: "À faire puis fait" },
  { id: "priority", label: "Priorité" },
  { id: "area", label: "Zone" },
];

const kindLabels = {
  history: "historique",
  current: "actif",
  planned: "prévu",
  backlog: "backlog",
} as const;

function getSummary(versions: typeof roadmap.versions) {
  return versions.reduce(
    (totals, version) => {
      totals.done += version.items.filter((item) => item.status === "done").length;
      totals.total += version.items.length;
      totals.childDone += version.items.reduce(
        (sum, item) => sum + (item.children?.filter((child) => child.status === "done").length ?? 0),
        0,
      );
      totals.childTotal += version.items.reduce((sum, item) => sum + (item.children?.length ?? 0), 0);
      return totals;
    },
    { done: 0, total: 0, childDone: 0, childTotal: 0 },
  );
}

function getStatusRank(status: string) {
  return status === "done" ? 1 : 0;
}

function getPriorityRank(priority: string) {
  switch (priority) {
    case "P0":
      return 0;
    case "P1":
      return 1;
    case "P2":
      return 2;
    case "P3":
      return 3;
    default:
      return 4;
  }
}

function sortItems(items: RoadmapItem[], mode: string) {
  const withIndex = items.map((item, index) => ({ item, index }));

  withIndex.sort((left, right) => {
    if (mode === "status") {
      const byStatus = getStatusRank(left.item.status) - getStatusRank(right.item.status);
      if (byStatus !== 0) return byStatus;
    }

    if (mode === "priority") {
      const byPriority = getPriorityRank(left.item.priority) - getPriorityRank(right.item.priority);
      if (byPriority !== 0) return byPriority;
    }

    if (mode === "area") {
      const byArea = labels.area[left.item.area].localeCompare(labels.area[right.item.area], "fr");
      if (byArea !== 0) return byArea;
    }

    return left.index - right.index;
  });

  return withIndex.map((entry) => entry.item);
}

const initialVersionBlocks = [
  {
    version: defaultVersion,
    summary: versionSummaries.find((summary) => summary.id === defaultVersion.id),
    items: sortItems(defaultVersion.items, "roadmap"),
  },
];
const initialSummary = versionSummaries.find((summary) => summary.id === defaultVersion.id) ?? getSummary([defaultVersion]);
const roadmapPayload = {
  roadmap,
  versionSummaries,
  labels,
  statusOptions,
  sortOptions,
  kindLabels,
};
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin — Backlog</title>
  <meta name="robots" content="noindex, nofollow" />
  <style is:global>
    .backlog-shell { min-height:100vh; background:
      radial-gradient(ellipse 70% 45% at 50% -10%,rgba(139,92,246,.22) 0%,transparent 70%),
      radial-gradient(ellipse 40% 40% at 90% 15%,rgba(34,211,238,.14) 0%,transparent 60%),
      #0a0911; }
    .backlog-wrap { width:min(1440px,calc(100% - 24px)); margin:0 auto; padding:88px 0 32px; }
    .backlog-card,.backlog-hero,.backlog-version-card,.backlog-item { background:rgba(15,12,26,.92); border:1px solid rgba(139,92,246,.18); border-radius:8px; box-shadow:0 12px 32px rgba(0,0,0,.32); }
    .backlog-hero { padding:20px; margin-bottom:16px; display:grid; gap:14px; }
    .backlog-eyebrow { display:inline-flex; align-items:center; gap:8px; min-height:32px; padding:0 12px; border-radius:8px; background:rgba(34,211,238,.12); border:1px solid rgba(34,211,238,.28); color:#22d3ee; font-size:.82rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
    .backlog-eyebrow::before { content:""; width:8px; height:8px; border-radius:999px; background:currentColor; }
    .backlog-title { margin:0; font-family:'Joystix',sans-serif; font-size:clamp(1.45rem,2.8vw,2.25rem); color:#fff; line-height:1.15; }
    .backlog-title span { color:#e879f9; }
    .backlog-copy { max-width:80ch; color:#c7c2df; font:500 1.05rem/1.64 'Rajdhani',sans-serif; }
    .backlog-chip-row { display:flex; flex-wrap:wrap; gap:8px; }
    .backlog-chip { display:inline-flex; align-items:center; min-height:32px; padding:0 12px; border-radius:8px; border:1px solid rgba(255,255,255,.12); background:rgba(255,255,255,.05); color:#fff; font:800 .88rem/1 'Rajdhani',sans-serif; letter-spacing:.03em; white-space:nowrap; }
    .backlog-chip.is-accent { border-color:rgba(74,222,128,.34); background:rgba(74,222,128,.14); color:#dcfce7; }
    .backlog-controls { display:grid; gap:14px; margin-bottom:16px; }
    .backlog-control-card { padding:14px; }
    .backlog-control-kicker { color:#8f8aa7; font:800 .82rem/1 'Rajdhani',sans-serif; letter-spacing:.1em; text-transform:uppercase; margin-bottom:10px; }
    .backlog-option-row { display:flex; flex-wrap:wrap; gap:8px; }
    .backlog-option { display:inline-flex; align-items:center; min-height:34px; padding:0 12px; border-radius:8px; border:1px solid rgba(255,255,255,.1); background:rgba(255,255,255,.04); color:#c7c2df; text-decoration:none; font:800 .9rem/1 'Rajdhani',sans-serif; letter-spacing:.03em; transition:border-color .18s ease,background .18s ease,color .18s ease,transform .18s ease; }
    .backlog-option:hover { border-color:rgba(139,92,246,.36); background:rgba(139,92,246,.08); color:#fff; transform:translateY(-1px); }
    .backlog-option.is-active { border-color:rgba(232,121,249,.34); background:rgba(232,121,249,.12); color:#fff; }
    .backlog-versions { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-bottom:16px; }
    .backlog-version-card { display:grid; gap:10px; padding:14px; text-decoration:none; color:inherit; transition:border-color .18s ease,transform .18s ease,background .18s ease; }
    .backlog-version-card:hover { border-color:rgba(139,92,246,.34); background:rgba(139,92,246,.06); transform:translateY(-1px); }
    .backlog-version-card.is-active { border-color:rgba(232,121,249,.36); background:rgba(232,121,249,.08); }
    .backlog-version-head { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }
    .backlog-version-title { color:#fff; font:800 1.06rem/1.2 'Rajdhani',sans-serif; }
    .backlog-version-kind { display:inline-flex; align-items:center; justify-content:center; min-height:28px; padding:0 10px; border-radius:8px; border:1px solid rgba(255,255,255,.1); background:rgba(255,255,255,.04); color:#c7c2df; font:800 .78rem/1 'Rajdhani',sans-serif; letter-spacing:.06em; text-transform:uppercase; white-space:nowrap; }
    .backlog-version-kind.history { border-color:rgba(34,211,238,.24); background:rgba(34,211,238,.12); color:#d7fbff; }
    .backlog-version-kind.current { border-color:rgba(74,222,128,.34); background:rgba(74,222,128,.14); color:#dcfce7; }
    .backlog-version-kind.planned { border-color:rgba(250,204,21,.28); background:rgba(250,204,21,.12); color:#fde68a; }
    .backlog-version-kind.backlog { border-color:rgba(255,255,255,.1); background:rgba(255,255,255,.04); color:#c7c2df; }
    .backlog-version-copy { color:#a9a3c3; font:600 .96rem/1.5 'Rajdhani',sans-serif; min-height:3em; }
    .backlog-version-meta { display:flex; flex-wrap:wrap; gap:8px; }
    .backlog-version-meta .backlog-chip { min-height:28px; font-size:.82rem; }
    .backlog-list { display:grid; gap:12px; }
    .backlog-version-section { display:grid; gap:12px; }
    .backlog-section-head { display:grid; gap:10px; padding:14px 16px; }
    .backlog-section-title-row { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }
    .backlog-section-title { color:#fff; font:800 1.2rem/1.2 'Rajdhani',sans-serif; }
    .backlog-section-copy { color:#a9a3c3; font:600 .98rem/1.55 'Rajdhani',sans-serif; }
    .backlog-section-meta { display:flex; flex-wrap:wrap; gap:8px; }
    .backlog-item { padding:16px; display:grid; gap:12px; }
    .backlog-item.is-done { border-color:rgba(74,222,128,.24); background:rgba(74,222,128,.06); }
    .backlog-item-head { display:flex; align-items:flex-start; justify-content:space-between; gap:14px; }
    .backlog-item-title-wrap { display:grid; gap:6px; min-width:0; }
    .backlog-item-title { color:#fff; font:800 1.18rem/1.25 'Rajdhani',sans-serif; }
    .backlog-item.is-done .backlog-item-title { color:#d9fbe3; }
    .backlog-item-note { color:#a9a3c3; font:600 .98rem/1.56 'Rajdhani',sans-serif; }
    .backlog-item-meta { display:flex; flex-wrap:wrap; gap:8px; }
    .backlog-meta-chip { display:inline-flex; align-items:center; min-height:28px; padding:0 10px; border-radius:8px; border:1px solid rgba(255,255,255,.1); background:rgba(255,255,255,.04); color:#fff; font:800 .8rem/1 'Rajdhani',sans-serif; letter-spacing:.04em; text-transform:uppercase; }
    .backlog-meta-chip.status-done { border-color:rgba(74,222,128,.34); background:rgba(74,222,128,.14); color:#dcfce7; }
    .backlog-meta-chip.status-todo { border-color:rgba(248,113,113,.26); background:rgba(248,113,113,.12); color:#fecaca; }
    .backlog-meta-chip.priority-p0 { border-color:rgba(248,113,113,.3); background:rgba(248,113,113,.14); color:#fecaca; }
    .backlog-meta-chip.priority-p1 { border-color:rgba(250,204,21,.28); background:rgba(250,204,21,.12); color:#fde68a; }
    .backlog-meta-chip.priority-p2 { border-color:rgba(34,211,238,.24); background:rgba(34,211,238,.12); color:#d7fbff; }
    .backlog-meta-chip.priority-p3 { border-color:rgba(255,255,255,.1); background:rgba(255,255,255,.04); color:#c7c2df; }
    .backlog-check { display:inline-flex; align-items:center; justify-content:center; width:40px; height:40px; border-radius:8px; border:1px solid rgba(255,255,255,.08); background:rgba(255,255,255,.04); color:#8f8aa7; font:900 1rem/1 'Rajdhani',sans-serif; flex:0 0 auto; }
    .backlog-item.is-done .backlog-check { border-color:rgba(74,222,128,.34); background:rgba(74,222,128,.14); color:#dcfce7; }
    .backlog-children { display:grid; gap:8px; }
    .backlog-child { display:flex; align-items:flex-start; gap:10px; padding:10px 12px; border-radius:8px; border:1px solid rgba(255,255,255,.06); background:rgba(255,255,255,.03); color:#c7c2df; font:700 .94rem/1.45 'Rajdhani',sans-serif; }
    .backlog-child.is-done { border-color:rgba(74,222,128,.22); background:rgba(74,222,128,.08); color:#dcfce7; }
    .backlog-child-check { display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px; border-radius:999px; border:1px solid rgba(255,255,255,.12); background:rgba(255,255,255,.04); color:#8f8aa7; font:900 .82rem/1 'Rajdhani',sans-serif; flex:0 0 auto; margin-top:0; }
    .backlog-child.is-done .backlog-child-check { border-color:rgba(74,222,128,.3); background:rgba(74,222,128,.14); color:#dcfce7; }
    .backlog-empty { padding:20px; color:#a9a3c3; font:600 1rem/1.6 'Rajdhani',sans-serif; }
    @media (max-width:1100px) {
      .backlog-versions { grid-template-columns:repeat(2,minmax(0,1fr)); }
    }
    @media (max-width:760px) {
      .backlog-wrap { width:min(100%,calc(100% - 20px)); }
      .backlog-versions { grid-template-columns:1fr; }
      .backlog-item-head,.backlog-version-head { align-items:flex-start; }
      .backlog-check { width:36px; height:36px; }
    }
  </style>
  <style set:html={ADMIN_NAV_CSS}></style>
</head>
<body class="text-slate-200 backlog-shell">
  <main class="backlog-wrap">
    <Fragment set:html={adminNav} />

    <section class="backlog-hero">
      <span class="backlog-eyebrow">Roadmap</span>
      <h1 class="backlog-title">Manabu<span>Play</span> backlog</h1>
      <p class="backlog-copy">
        Source de vérité : <code>docs/ROADMAP.json</code>. Cette page sert à lire le travail par version sans dépendre de GitHub Projects ni d’un markdown à relire à la main.
      </p>
      <div class="backlog-chip-row">
        <span class="backlog-chip is-accent">MAJ {roadmap.meta.updatedAt}</span>
        <span class="backlog-chip">{roadmap.versions.length} vues version</span>
        <span class="backlog-chip" id="backlog-current-version-chip">{defaultVersion.label}</span>
        <span class="backlog-chip" id="backlog-summary-items-chip">{initialSummary.done}/{initialSummary.total} items faits</span>
        <span class="backlog-chip" id="backlog-summary-children-chip">{initialSummary.childDone}/{initialSummary.childTotal} sous-items faits</span>
      </div>
    </section>

    <section class="backlog-controls">
      <div class="backlog-card backlog-control-card">
        <div class="backlog-control-kicker">Version</div>
        <div class="backlog-option-row">
          <a
            class="backlog-option"
            data-role="version-option"
            data-version-id="all"
            href="/admin/backlog?version=all"
          >
            Toutes les versions
          </a>
          {versionOptions.map((version) => (
            <a
              class:list={["backlog-option", { "is-active": version.id === defaultVersion.id }]}
              data-role="version-option"
              data-version-id={version.id}
              href={`/admin/backlog?version=${version.id}`}
            >
              {version.label}
            </a>
          ))}
        </div>
      </div>

      <div class="backlog-card backlog-control-card">
        <div class="backlog-control-kicker">Statut</div>
        <div class="backlog-option-row">
          {statusOptions.map((option) => (
            <a
              class:list={["backlog-option", { "is-active": option.id === "all" }]}
              data-role="status-option"
              data-status-id={option.id}
              href={`/admin/backlog?version=${defaultVersion.id}&status=${option.id}`}
            >
              {option.label}
            </a>
          ))}
        </div>
      </div>

      <div class="backlog-card backlog-control-card">
        <div class="backlog-control-kicker">Tri</div>
        <div class="backlog-option-row">
          {sortOptions.map((option) => (
            <a
              class:list={["backlog-option", { "is-active": option.id === "roadmap" }]}
              data-role="sort-option"
              data-sort-id={option.id}
              href={`/admin/backlog?version=${defaultVersion.id}&sort=${option.id}`}
            >
              {option.label}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="backlog-versions">
      {versionSummaries.map((version) => (
        <a
          class:list={["backlog-version-card", { "is-active": version.id === defaultVersion.id }]}
          data-role="version-card"
          data-version-id={version.id}
          href={`/admin/backlog?version=${version.id}`}
        >
          <div class="backlog-version-head">
            <div class="backlog-version-title">{version.label}</div>
            <span class:list={["backlog-version-kind", version.kind]}>{kindLabels[version.kind]}</span>
          </div>
          <p class="backlog-version-copy">{version.summary}</p>
          <div class="backlog-version-meta">
            <span class="backlog-chip">{version.done}/{version.total} items faits</span>
            <span class="backlog-chip">{version.childDone}/{version.childTotal} sous-items faits</span>
          </div>
        </a>
      ))}
    </section>

    <section class="backlog-list" id="backlog-list">
      {initialVersionBlocks.length === 0 ? (
        <section class="backlog-card backlog-empty">
          Aucun item ne correspond au filtre actuel.
        </section>
      ) : (
        initialVersionBlocks.map((block) => (
          <section class="backlog-version-section">
            {block.items.map((item) => (
              <article class:list={["backlog-item", { "is-done": item.status === "done" }]}>
                <div class="backlog-item-head">
                  <div class="backlog-item-title-wrap">
                    <div class="backlog-item-title">{item.title}</div>
                    {item.notes && <p class="backlog-item-note">{item.notes}</p>}
                    <div class="backlog-item-meta">
                      <span class:list={["backlog-meta-chip", `status-${item.status}`]}>{labels.status[item.status]}</span>
                      <span class:list={["backlog-meta-chip", `priority-${item.priority.toLowerCase()}`]}>{item.priority}</span>
                      <span class="backlog-meta-chip">{labels.area[item.area]}</span>
                      <span class="backlog-meta-chip">{labels.type[item.type]}</span>
                    </div>
                  </div>
                  <div class="backlog-check">{item.status === "done" ? "✓" : "•"}</div>
                </div>

                {item.children && item.children.length > 0 && (
                  <div class="backlog-children">
                    {item.children.map((child) => (
                      <div class:list={["backlog-child", { "is-done": child.status === "done" }]}>
                        <span class="backlog-child-check">{child.status === "done" ? "✓" : "•"}</span>
                        <span>{child.title}</span>
                      </div>
                    ))}
                  </div>
                )}
              </article>
            ))}
          </section>
        ))
      )}
    </section>
  </main>
  <script type="application/json" id="roadmap-data" set:html={JSON.stringify(roadmapPayload)}></script>
  <script>
    const roadmapPayloadElement = document.getElementById("roadmap-data");
    const backlogList = document.getElementById("backlog-list");
    const currentVersionChip = document.getElementById("backlog-current-version-chip");
    const summaryItemsChip = document.getElementById("backlog-summary-items-chip");
    const summaryChildrenChip = document.getElementById("backlog-summary-children-chip");

    if (roadmapPayloadElement && backlogList && currentVersionChip && summaryItemsChip && summaryChildrenChip) {
      const payload = JSON.parse(roadmapPayloadElement.textContent || "{}");
      const roadmap = payload.roadmap;
      const versionSummaries = payload.versionSummaries;
      const labels = payload.labels;
      const kindLabels = payload.kindLabels;

      const escapeHtml = (value) =>
        String(value)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#39;");

      const getStatusRank = (status) => (status === "done" ? 1 : 0);
      const getPriorityRank = (priority) => {
        switch (priority) {
          case "P0":
            return 0;
          case "P1":
            return 1;
          case "P2":
            return 2;
          case "P3":
            return 3;
          default:
            return 4;
        }
      };

      const getSummary = (versions) =>
        versions.reduce(
          (totals, version) => {
            totals.done += version.items.filter((item) => item.status === "done").length;
            totals.total += version.items.length;
            totals.childDone += version.items.reduce(
              (sum, item) => sum + ((item.children || []).filter((child) => child.status === "done").length || 0),
              0,
            );
            totals.childTotal += version.items.reduce((sum, item) => sum + ((item.children || []).length || 0), 0);
            return totals;
          },
          { done: 0, total: 0, childDone: 0, childTotal: 0 },
        );

      const sortItems = (items, mode) => {
        const withIndex = items.map((item, index) => ({ item, index }));

        withIndex.sort((left, right) => {
          if (mode === "status") {
            const byStatus = getStatusRank(left.item.status) - getStatusRank(right.item.status);
            if (byStatus !== 0) return byStatus;
          }

          if (mode === "priority") {
            const byPriority = getPriorityRank(left.item.priority) - getPriorityRank(right.item.priority);
            if (byPriority !== 0) return byPriority;
          }

          if (mode === "area") {
            const byArea = labels.area[left.item.area].localeCompare(labels.area[right.item.area], "fr");
            if (byArea !== 0) return byArea;
          }

          return left.index - right.index;
        });

        return withIndex.map((entry) => entry.item);
      };

      const getState = () => {
        const params = new URLSearchParams(window.location.search);
        return {
          versionId: params.get("version") || roadmap.meta.defaultVersionId,
          statusFilter: params.get("status") || "all",
          sortKey: params.get("sort") || "roadmap",
        };
      };

      const getHref = (nextState) => {
        const params = new URLSearchParams();
        params.set("version", nextState.versionId);
        params.set("status", nextState.statusFilter);
        params.set("sort", nextState.sortKey);
        return `/admin/backlog?${params.toString()}`;
      };

      const renderList = (state) => {
        const selectedVersion = state.versionId === "all"
          ? null
          : roadmap.versions.find((version) => version.id === state.versionId) ||
            roadmap.versions.find((version) => version.id === roadmap.meta.defaultVersionId) ||
            roadmap.versions[0];
        const visibleVersions = selectedVersion ? [selectedVersion] : roadmap.versions;
        const versionBlocks = visibleVersions
          .map((version) => {
            const filteredItems = version.items.filter((item) => state.statusFilter === "all" || item.status === state.statusFilter);

            return {
              version,
              summary: versionSummaries.find((summary) => summary.id === version.id),
              items: sortItems(filteredItems, state.sortKey),
            };
          })
          .filter((block) => block.items.length > 0);

        const selectedSummary = selectedVersion
          ? versionSummaries.find((summary) => summary.id === selectedVersion.id) || getSummary([selectedVersion])
          : getSummary(roadmap.versions);

        currentVersionChip.textContent = selectedVersion ? selectedVersion.label : "Lecture libre";
        summaryItemsChip.textContent = `${selectedSummary.done}/${selectedSummary.total} items faits`;
        summaryChildrenChip.textContent = `${selectedSummary.childDone}/${selectedSummary.childTotal} sous-items faits`;

        if (versionBlocks.length === 0) {
          backlogList.innerHTML = `
            <section class="backlog-card backlog-empty">
              Aucun item ne correspond au filtre actuel.
            </section>
          `;
          return;
        }

        backlogList.innerHTML = versionBlocks
          .map((block) => {
            const sectionHead = selectedVersion
              ? ""
              : `
                <section class="backlog-card backlog-section-head">
                  <div class="backlog-section-title-row">
                    <div class="backlog-section-title">${escapeHtml(block.version.label)}</div>
                    <span class="backlog-version-kind ${escapeHtml(block.version.kind)}">${escapeHtml(kindLabels[block.version.kind])}</span>
                  </div>
                  <p class="backlog-section-copy">${escapeHtml(block.version.summary)}</p>
                  <div class="backlog-section-meta">
                    <span class="backlog-chip">${block.summary?.done ?? 0}/${block.summary?.total ?? 0} items faits</span>
                    <span class="backlog-chip">${block.summary?.childDone ?? 0}/${block.summary?.childTotal ?? 0} sous-items faits</span>
                  </div>
                </section>
              `;

            const items = block.items
              .map((item) => {
                const children = (item.children || []).length
                  ? `
                    <div class="backlog-children">
                      ${(item.children || [])
                        .map(
                          (child) => `
                            <div class="backlog-child ${child.status === "done" ? "is-done" : ""}">
                              <span class="backlog-child-check">${child.status === "done" ? "✓" : "•"}</span>
                              <span>${escapeHtml(child.title)}</span>
                            </div>
                          `,
                        )
                        .join("")}
                    </div>
                  `
                  : "";

                return `
                  <article class="backlog-item ${item.status === "done" ? "is-done" : ""}">
                    <div class="backlog-item-head">
                      <div class="backlog-item-title-wrap">
                        <div class="backlog-item-title">${escapeHtml(item.title)}</div>
                        ${item.notes ? `<p class="backlog-item-note">${escapeHtml(item.notes)}</p>` : ""}
                        <div class="backlog-item-meta">
                          <span class="backlog-meta-chip status-${escapeHtml(item.status)}">${escapeHtml(labels.status[item.status])}</span>
                          <span class="backlog-meta-chip priority-${escapeHtml(item.priority.toLowerCase())}">${escapeHtml(item.priority)}</span>
                          <span class="backlog-meta-chip">${escapeHtml(labels.area[item.area])}</span>
                          <span class="backlog-meta-chip">${escapeHtml(labels.type[item.type])}</span>
                        </div>
                      </div>
                      <div class="backlog-check">${item.status === "done" ? "✓" : "•"}</div>
                    </div>
                    ${children}
                  </article>
                `;
              })
              .join("");

            return `<section class="backlog-version-section">${sectionHead}${items}</section>`;
          })
          .join("");
      };

      const syncControls = (state) => {
        document.querySelectorAll("[data-role='version-option']").forEach((element) => {
          const versionId = element.dataset.versionId || roadmap.meta.defaultVersionId;
          element.classList.toggle("is-active", versionId === state.versionId);
          element.setAttribute(
            "href",
            getHref({ versionId, statusFilter: state.statusFilter, sortKey: state.sortKey }),
          );
        });

        document.querySelectorAll("[data-role='status-option']").forEach((element) => {
          const statusId = element.dataset.statusId || "all";
          element.classList.toggle("is-active", statusId === state.statusFilter);
          element.setAttribute(
            "href",
            getHref({ versionId: state.versionId, statusFilter: statusId, sortKey: state.sortKey }),
          );
        });

        document.querySelectorAll("[data-role='sort-option']").forEach((element) => {
          const sortId = element.dataset.sortId || "roadmap";
          element.classList.toggle("is-active", sortId === state.sortKey);
          element.setAttribute(
            "href",
            getHref({ versionId: state.versionId, statusFilter: state.statusFilter, sortKey: sortId }),
          );
        });

        document.querySelectorAll("[data-role='version-card']").forEach((element) => {
          const versionId = element.dataset.versionId || roadmap.meta.defaultVersionId;
          element.classList.toggle("is-active", versionId === state.versionId);
          element.setAttribute(
            "href",
            getHref({ versionId, statusFilter: state.statusFilter, sortKey: state.sortKey }),
          );
        });
      };

      const render = () => {
        const state = getState();
        syncControls(state);
        renderList(state);
      };

      render();
      document.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target.closest("[data-role]") : null;
        if (!(target instanceof HTMLAnchorElement)) return;
        event.preventDefault();
        const href = target.getAttribute("href");
        if (!href) return;
        window.history.pushState({}, "", href);
        render();
      });
      window.addEventListener("popstate", render);
    }
  </script>
</body>
</html>
