---
import "../styles/mvp.css";
import { buildMvpBootData } from "../data/manabuplay/catalog";
import { serializeForInlineScript } from "../lib/serialize-inline-script";

const bootDataScript = `window.__MANABUPLAY_DATA__ = ${serializeForInlineScript(buildMvpBootData())};`;
---
<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ManabuPlay — Learn Japanese Through Gaming</title>
  <meta name="description" content="Learn Japanese gaming vocabulary through an addictive quiz. Master the words behind your favorite anime & JRPG games. Free, fast, fun." />
  <meta name="keywords" content="Japanese gaming vocabulary, learn Japanese, anime words, JRPG quiz, gaming language" />
  <meta property="og:title" content="ManabuPlay — Learn Japanese Through Gaming" />
  <meta property="og:description" content="Master Japanese gaming vocab. Free addictive quiz powered by anime & JRPG culture." />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#0a0911" />
</head>
<body class="text-slate-200">

<!-- ══ NAV ══ -->
  <nav class="fixed top-0 inset-x-0 z-50 flex items-center justify-between px-6 py-2"
       style="background:rgba(10,9,17,.85);backdrop-filter:blur(16px);border-bottom:1px solid rgba(139,92,246,.15);">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-md flex items-center justify-center text-white flex-shrink-0"
           style="background:linear-gradient(135deg,var(--violet),var(--fuchsia));">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
        </svg>
      </div>
      <span class="glow-violet" style="font-family:'Joystix',sans-serif;font-size:.85rem;color:#a78bfa;">
        Manabu<span style="color:#e879f9;">Play</span>
      </span>
    </div>
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-1 px-2 py-1 rounded-md" style="background:rgba(26,22,48,.8);border:1px solid rgba(139,92,246,.15);">
        <button class="lang-btn active" id="btnEN" onclick="setLang('en')">EN</button>
        <span style="color:rgba(139,92,246,.2);font-size:.9rem;">|</span>
        <button class="lang-btn" id="btnFR" onclick="setLang('fr')">FR</button>
      </div>
      <a href="#quiz" class="nav-link px-4 py-2 rounded-md border border-violet-500/30 hover:border-violet-400 transition-all hidden sm:block" style="color:#a78bfa;" data-i18n="nav_cta"></a>
    </div>
  </nav>

  <!-- ══ HERO ══ -->
  <section class="hero-bg grid-bg relative min-h-screen flex flex-col items-center justify-center text-center px-6 pt-20 pb-16 overflow-hidden">
    <span class="kanji-bg" style="top:5%;left:-2%;transform:rotate(-15deg);color:var(--violet);">学</span>
    <span class="kanji-bg" style="bottom:5%;right:-2%;transform:rotate(10deg);color:var(--fuchsia);">遊</span>
    <div class="absolute w-64 h-64 rounded-full" style="top:20%;left:15%;background:radial-gradient(circle,rgba(139,92,246,.2) 0%,transparent 70%);animation:float 6s ease-in-out infinite;filter:blur(40px);"></div>
    <div class="absolute w-48 h-48 rounded-full" style="bottom:25%;right:10%;background:radial-gradient(circle,rgba(232,121,249,.2) 0%,transparent 70%);animation:float 8s ease-in-out infinite 2s;filter:blur(30px);"></div>

    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full mb-6 font-body text-sm font-600 border" style="border-color:rgba(34,211,238,.3);background:rgba(34,211,238,.07);color:var(--cyan);">
      <span class="w-2 h-2 rounded-full" style="background:var(--cyan);animation:pulse 2s infinite;"></span>
      <span data-i18n="hero_badge"></span>
    </div>

    <h1 class="font-pixel leading-relaxed mb-6 relative" style="font-size:clamp(1.6rem,4vw,3rem);">
      <span class="glitch-text block text-white" data-text="MANABU">MANABU</span>
      <span class="block mt-2 glow-fuchsia" style="color:var(--fuchsia);">PLAY</span>
    </h1>
    <p class="font-body text-xl sm:text-2xl font-600 text-slate-300 max-w-2xl mb-4" data-i18n="hero_tagline"></p>
    <p class="font-body text-lg text-slate-400 max-w-lg mb-10" data-i18n="hero_sub"></p>

    <div class="flex flex-col sm:flex-row gap-4 items-center">
      <a href="#quiz"><button class="cta-btn" data-i18n="hero_cta"></button></a>
      <a href="#features" class="font-body font-600 text-slate-400 hover:text-slate-200 transition-colors text-base" data-i18n="hero_how"></a>
    </div>

    <div class="flex gap-8 mt-12 flex-wrap justify-center">
      <div class="text-center">
        <div class="font-pixel text-xl" style="color:var(--violet);">50</div>
        <div class="stat-label text-slate-500 mt-1" data-i18n="stat_words"></div>
      </div>
      <div class="w-px bg-slate-800"></div>
      <div class="text-center">
        <div class="font-pixel text-xl" style="color:var(--fuchsia);">4</div>
        <div class="stat-label text-slate-500 mt-1" data-i18n="stat_diff"></div>
      </div>
      <div class="w-px bg-slate-800"></div>
      <div class="text-center">
        <div class="font-pixel text-xl" style="color:var(--cyan);">0¥</div>
        <div class="stat-label text-slate-500 mt-1" data-i18n="stat_free"></div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 opacity-40">
      <div class="w-px h-8" style="background:linear-gradient(to bottom,transparent,var(--violet));"></div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--violet)" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
    </div>
  </section>

  <!-- ══ AD TOP ══ -->
  <div class="py-6 px-6 max-w-4xl mx-auto w-full">
    <div class="ad-placeholder flex items-center justify-center p-4 min-h-24 reveal">
      <div class="text-center"><p class="font-body text-sm text-slate-600 mb-1">Advertisement</p>
      <!-- ✦ PASTE YOUR GOOGLE ADSENSE CODE HERE (TOP BANNER) ✦ --></div>
    </div>
  </div>

  <!-- ══ FEATURES ══ -->
  <section id="features" class="py-16 px-6 max-w-5xl mx-auto">
    <div class="text-center mb-12 reveal">
      <p class="section-label" style="color:var(--cyan);" data-i18n="features_label"></p>
      <h2 class="pixel-heading-md mt-4 text-white" data-i18n="features_title"></h2>
      <p class="font-body text-lg text-slate-400 mt-4 max-w-xl mx-auto" data-i18n="features_sub"></p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <div class="feature-card p-6 reveal">
        <div class="w-11 h-11 rounded-lg flex items-center justify-center mb-4 text-2xl" style="background:rgba(139,92,246,.15);border:1px solid rgba(139,92,246,.3);">⚔️</div>
        <h3 class="pixel-card-title mb-4" style="color:#a78bfa;" data-i18n="feat1_title"></h3>
        <p class="font-body text-base text-slate-400 leading-relaxed" data-i18n="feat1_body"></p>
      </div>
      <div class="feature-card p-6 reveal" style="transition-delay:.1s;">
        <div class="w-11 h-11 rounded-lg flex items-center justify-center mb-4 text-2xl" style="background:rgba(232,121,249,.15);border:1px solid rgba(232,121,249,.3);">🧠</div>
        <h3 class="pixel-card-title mb-4" style="color:#e879f9;" data-i18n="feat2_title"></h3>
        <p class="font-body text-base text-slate-400 leading-relaxed" data-i18n="feat2_body"></p>
      </div>
      <div class="feature-card p-6 reveal" style="transition-delay:.2s;">
        <div class="w-11 h-11 rounded-lg flex items-center justify-center mb-4 text-2xl" style="background:rgba(34,211,238,.1);border:1px solid rgba(34,211,238,.2);">🎮</div>
        <h3 class="pixel-card-title mb-4" style="color:#22d3ee;" data-i18n="feat3_title"></h3>
        <p class="font-body text-base text-slate-400 leading-relaxed" data-i18n="feat3_body"></p>
      </div>
    </div>
  </section>

  <!-- ══ QUIZ SECTION ══ -->
  <section id="quiz" class="py-16 px-6 relative overflow-hidden">
    <div class="absolute inset-0" style="background:radial-gradient(ellipse 70% 50% at 50% 50%,rgba(139,92,246,.08) 0%,transparent 70%);"></div>
    <div class="max-w-2xl mx-auto relative z-10">

      <div class="text-center mb-8 reveal">
        <p class="section-label" style="color:var(--violet);" data-i18n="quiz_label"></p>
        <h2 class="pixel-heading-md mt-4 text-white" data-i18n="quiz_title"></h2>
        <p class="font-body text-lg text-slate-400 mt-4" data-i18n="quiz_sub"></p>
      </div>

      <div class="border-glow rounded-xl p-6 sm:p-8 reveal" style="background:rgba(15,12,26,.95);backdrop-filter:blur(16px);">

        <!-- ══ DIFFICULTY PICKER ══ -->
        <div id="diffArea">
          <p class="section-label text-center mb-6" style="color:var(--fuchsia);" data-i18n="diff_title"></p>
          <div class="grid grid-cols-2 gap-4 mb-6" id="diffGrid">
            <!-- injected by JS -->
          </div>
          <div class="text-center">
            <button class="start-btn" id="startBtn" onclick="launchQuiz()" data-i18n="diff_start"></button>
          </div>
        </div>

        <!-- ══ PROGRESS ══ -->
        <div id="progressRow" style="display:none;" class="flex items-center gap-3 mb-6">
          <div class="flex-1 h-1 rounded-full" style="background:rgba(139,92,246,.15);">
            <div class="progress-bar" id="progressBar" style="width:0%;"></div>
          </div>
          <span class="progress-text text-slate-400" id="progressText">0/10</span>
        </div>

        <!-- ══ HUD ══ -->
        <div id="hudRow" style="display:none;" class="flex justify-between items-center mb-6">
          <div class="flex items-center gap-2">
            <span class="hud-label text-slate-500" data-i18n="hud_score"></span>
            <span class="font-pixel text-base" id="scoreDisplay" style="color:var(--violet);">0</span>
          </div>
          <span class="font-pixel text-sm" id="streakDisplay" style="color:var(--fuchsia);"></span>
          <div class="flex items-center gap-2">
            <span class="hud-label text-slate-500" data-i18n="hud_level"></span>
            <span class="font-pixel text-base text-white" id="levelDisplay">I</span>
          </div>
        </div>

        <!-- ══ QUIZ AREA ══ -->
        <div id="quizArea" style="display:none;">
          <div class="text-center mb-6">
            <div class="inline-block px-4 py-2 rounded-lg mb-4 border" style="background:rgba(139,92,246,.1);border-color:rgba(139,92,246,.3);">
              <span class="font-body text-sm tracking-widest uppercase font-700" style="color:#a78bfa;" id="wordCategory"></span>
            </div>
            <div id="wordKana" style="color:var(--cyan);margin-bottom:4px;"></div>
            <div class="font-pixel text-4xl sm:text-5xl glow-fuchsia" id="wordDisplay" style="color:var(--fuchsia);line-height:1.2;"></div>
          </div>

          <div class="text-center mb-6" id="hintZone">
            <button class="hint-reveal-btn" id="hintBtn" onclick="revealHint()">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              <span data-i18n="hint_btn"></span>
            </button>
            <div id="hintText" style="display:none;" class="mt-3">
              <span class="font-body italic" style="color:rgba(34,211,238,.6);" id="hintContent"></span>
            </div>
          </div>

          <p class="font-body text-lg text-slate-400 text-center mb-4" data-i18n="quiz_question"></p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="answersGrid"></div>
          <div id="feedback" class="mt-5 text-center" style="min-height:32px;display:none;"></div>
          <div class="mt-6 text-center">
            <button id="nextBtn" class="cta-btn opacity-0 pointer-events-none" onclick="nextQuestion()">…</button>
          </div>
        </div>

        <!-- ══ RESULTS ══ -->
        <div id="resultsArea" style="display:none;" class="text-center py-4">
          <div class="font-pixel text-5xl mb-5 score-pop" id="finalEmoji">🏆</div>
          <h3 class="pixel-heading-sm mb-3 text-white" id="finalTitle"></h3>
          <p class="font-body text-lg text-slate-400 mb-3" id="finalMsg"></p>
          <!-- New record badge (conditionally shown) -->
          <div id="newRecordBadge" style="display:none;" class="mb-4">
            <span class="new-record-badge" data-i18n="result_newrecord"></span>
          </div>
          <div class="flex justify-center gap-4 my-6 flex-wrap">
            <div>
              <div class="font-pixel text-xl glow-violet" id="finalScore" style="color:var(--violet);"></div>
              <div class="result-label text-slate-500 mt-2" data-i18n="result_score"></div>
            </div>
            <div class="w-px bg-slate-800 hidden sm:block"></div>
            <div>
              <div class="font-pixel text-xl" id="finalCorrect" style="color:#4ade80;"></div>
              <div class="result-label text-slate-500 mt-2" data-i18n="result_correct"></div>
            </div>
            <div class="w-px bg-slate-800 hidden sm:block"></div>
            <div>
              <div class="font-pixel text-xl" id="finalPercent" style="color:var(--fuchsia);"></div>
              <div class="result-label text-slate-500 mt-2" data-i18n="result_acc"></div>
            </div>
            <div class="w-px bg-slate-800 hidden sm:block"></div>
            <div>
              <div class="font-pixel text-xl" id="finalStreak" style="color:var(--cyan);"></div>
              <div class="result-label text-slate-500 mt-2" data-i18n="result_streak"></div>
            </div>
          </div>
          <!-- Best score display -->
          <p class="font-body text-base text-slate-500 mb-6" id="bestScoreMsg"></p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <button class="cta-btn" onclick="replayDifficulty()" data-i18n="result_replay"></button>
            <button class="cta-btn" onclick="goToDiffPicker()" data-i18n="result_change_diff" style="background:linear-gradient(135deg,rgba(139,92,246,.3),rgba(232,121,249,.3));box-shadow:none;border:1px solid rgba(139,92,246,.4);"></button>
          </div>

          <!-- Share row -->
          <div class="mt-6">
            <p class="font-body text-sm text-slate-500 mb-3" data-i18n="result_share"></p>
            <div class="flex gap-3 justify-center flex-wrap">
              <!-- X / Twitter -->
              <button class="share-btn share-btn-x" onclick="shareOnX()" id="shareBtnX">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.912-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
                <span data-i18n="result_share_x"></span>
              </button>
              <!-- Copy link -->
              <button class="share-btn share-btn-copy" onclick="copyShareLink()" id="shareBtnCopy">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="10" y="10" width="12" height="12" rx="2"/><path d="M6 16H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v2"/>
                </svg>
                <span id="copyBtnLabel" data-i18n="result_share_copy"></span>
              </button>
            </div>
          </div>
        </div>

      </div><!-- /card -->
    </div>
  </section>

  <!-- ══ AD MID ══ -->
  <div class="py-6 px-6 max-w-4xl mx-auto w-full">
    <div class="ad-placeholder flex items-center justify-center p-4 min-h-32 reveal">
      <div class="text-center"><p class="font-body text-sm text-slate-600 mb-1">Advertisement</p>
      <!-- ✦ PASTE YOUR GOOGLE ADSENSE CODE HERE (MIDDLE RECTANGLE) ✦ --></div>
    </div>
  </div>

  <!-- ══ EMAIL ══ -->
  <section id="notify" class="py-20 px-6 relative overflow-hidden">
    <div class="absolute inset-0" style="background:radial-gradient(ellipse 60% 60% at 50% 50%,rgba(232,121,249,.07) 0%,transparent 70%);"></div>
    <div class="max-w-xl mx-auto text-center relative z-10 reveal">
      <p class="section-label mb-4" style="color:var(--fuchsia);" data-i18n="email_label"></p>
      <h2 class="pixel-heading-md text-white leading-relaxed mb-4" data-i18n="email_title"></h2>
      <p class="font-body text-lg text-slate-400 mb-8" data-i18n="email_sub"></p>
      <!-- Netlify Forms hidden bot-trap (required by Netlify) -->
      <form name="manabuplay-waitlist" method="POST" data-netlify="true" netlify-honeypot="bot-field"
            class="flex flex-col sm:flex-row gap-3">
        <!-- Hidden fields required by Netlify -->
        <input type="hidden" name="form-name" value="manabuplay-waitlist" />
        <p class="hidden" style="display:none;"><label>Don't fill this out: <input name="bot-field"/></label></p>
        <!-- Visible fields -->
        <input type="email" id="emailInput" name="email" class="email-input flex-1" data-i18n-ph="email_ph" required autocomplete="email"/>
        <button type="submit" class="cta-btn whitespace-nowrap" style="font-size:.72rem;" data-i18n="email_cta"></button>
      </form>
      <div id="emailSuccess" style="display:none;" class="mt-5">
        <span class="font-pixel" style="font-size:.78rem;color:var(--cyan);" data-i18n="email_ok"></span>
      </div>
      <p class="font-body text-sm text-slate-600 mt-5" data-i18n="email_legal"></p>
    </div>
  </section>

  <!-- ══ FOOTER ══ -->
  <footer class="border-t py-8 px-6" style="border-color:rgba(139,92,246,.15);">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
      <div class="flex items-center gap-2">
        <span class="glow-violet" style="font-family:'Joystix',sans-serif;font-size:.78rem;color:#a78bfa;">Manabu<span style="color:#e879f9;">Play</span></span>
        <span class="text-slate-700">•</span>
        <span class="font-body text-sm text-slate-600"><span data-i18n="footer_by"></span> <span class="text-slate-400 font-600">Kxis</span></span>
      </div>
      <div class="font-body text-sm text-slate-700" data-i18n="footer_quote"></div>
      <div class="flex gap-5">
        <a href="#quiz"   class="font-body text-sm text-slate-600 hover:text-slate-400 transition-colors" data-i18n="footer_quiz"></a>
        <a href="#notify" class="font-body text-sm text-slate-600 hover:text-slate-400 transition-colors" data-i18n="footer_updates"></a>
      </div>
    </div>
  </footer>


  <!-- ══════════════════════ JAVASCRIPT ══════════════════════ -->
  <script is:inline set:html={bootDataScript}></script>
  <script is:inline src="/scripts/manabuplay.js"></script>
</body>
</html>
